{
  "name": "valeryverkhoturov/wb-api-client",
  "description": "Auto-generated PHP client for the Wildberries Seller API",
  "version": "__VERSION__",
  "license": "Apache-2.0",
  "type": "library",
  "keywords": ["wildberries", "wb", "api", "client", "sdk"],
  "homepage": "https://github.com/ValeryVerkhoturov/wb-api-client",
  "authors": [
    { "name": "Valery Verkhoturov" }
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.9",
    "guzzlehttp/psr7": "^2.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "autoload": {
    "psr-4": {
      "ValeryVerkhoturov\\WbApiClient\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
