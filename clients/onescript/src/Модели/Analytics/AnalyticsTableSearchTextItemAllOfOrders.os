// AnalyticsTableSearchTextItemAllOfOrders
//
// Сколько раз товары из поиска заказали
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// current - Число - Текущее количество
Перем current Экспорт;

// dynamics - Число - Динамика по сравнению с предыдущим периодом, %
Перем dynamics Экспорт;

// percentile - Число - Процент, на который показатель заказов выше, чем у карточек других продавцов по поисковому запросу
Перем percentile Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("current") <> Неопределено Тогда
		current = Значения.Получить("current");
	КонецЕсли;
	Если Значения.Получить("dynamics") <> Неопределено Тогда
		dynamics = Значения.Получить("dynamics");
	КонецЕсли;
	Если Значения.Получить("percentile") <> Неопределено Тогда
		percentile = Значения.Получить("percentile");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если current <> Неопределено Тогда
		Результат.Вставить("current", ЗначениеДляJSON(current));
	КонецЕсли;
	Если dynamics <> Неопределено Тогда
		Результат.Вставить("dynamics", ЗначениеДляJSON(dynamics));
	КонецЕсли;
	Если percentile <> Неопределено Тогда
		Результат.Вставить("percentile", ЗначениеДляJSON(percentile));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

