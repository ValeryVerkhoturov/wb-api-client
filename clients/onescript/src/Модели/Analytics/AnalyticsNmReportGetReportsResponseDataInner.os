// AnalyticsNmReportGetReportsResponseDataInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// id - Строка - ID отчёта
Перем id Экспорт;

// createdAt - Строка - Дата и время завершения генерации
Перем createdAt Экспорт;

// status - Строка - Статус отчёта: * `WAITING` — в очереди на обработку * `PROCESSING` — генерируется * `SUCCESS —` готов * `RETRY` — ожидает повторной обработки * `FAILED` — не по…
Перем status Экспорт;

// name - Строка - Название отчёта
Перем name Экспорт;

// size - Число - Размер отчёта, Б
Перем size Экспорт;

// startDate - Дата - Начало периода
Перем startDate Экспорт;

// endDate - Дата - Конец периода
Перем endDate Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("id") <> Неопределено Тогда
		id = Значения.Получить("id");
	КонецЕсли;
	Если Значения.Получить("createdAt") <> Неопределено Тогда
		createdAt = Значения.Получить("createdAt");
	КонецЕсли;
	Если Значения.Получить("status") <> Неопределено Тогда
		status = Значения.Получить("status");
	КонецЕсли;
	Если Значения.Получить("name") <> Неопределено Тогда
		name = Значения.Получить("name");
	КонецЕсли;
	Если Значения.Получить("size") <> Неопределено Тогда
		size = Значения.Получить("size");
	КонецЕсли;
	Если Значения.Получить("startDate") <> Неопределено Тогда
		startDate = Значения.Получить("startDate");
	КонецЕсли;
	Если Значения.Получить("endDate") <> Неопределено Тогда
		endDate = Значения.Получить("endDate");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Если createdAt <> Неопределено Тогда
		Результат.Вставить("createdAt", ЗначениеДляJSON(createdAt));
	КонецЕсли;
	Если status <> Неопределено Тогда
		Результат.Вставить("status", ЗначениеДляJSON(status));
	КонецЕсли;
	Если name <> Неопределено Тогда
		Результат.Вставить("name", ЗначениеДляJSON(name));
	КонецЕсли;
	Если size <> Неопределено Тогда
		Результат.Вставить("size", ЗначениеДляJSON(size));
	КонецЕсли;
	Если startDate <> Неопределено Тогда
		Результат.Вставить("startDate", ЗначениеДляJSON(startDate));
	КонецЕсли;
	Если endDate <> Неопределено Тогда
		Результат.Вставить("endDate", ЗначениеДляJSON(endDate));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

