// AnalyticsSalesFunnelItemReqParams
//
// Параметры отчёта
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// nmIDs - Массив - Артикулы WB, по которым составить отчёт. Оставьте пустым, чтобы получить отчёт обо всех товарах
Перем nmIDs Экспорт;

// subjectIds - Массив - Список ID предметов для фильтрации
Перем subjectIds Экспорт;

// brandNames - Массив - Список брендов для фильтрации
Перем brandNames Экспорт;

// tagIds - Массив - Список ID ярлыков для фильтрации
Перем tagIds Экспорт;

// startDate - Дата - Начало периода
Перем startDate Экспорт;

// endDate - Дата - Конец периода
Перем endDate Экспорт;

// timezone - Строка - Временная зона по формату [IANA](https://nodatime.org/TimeZones)
Перем timezone Экспорт;

// aggregationLevel - Строка - Как сгруппировать данные (по умолчанию по дням): * `day` — по дням * `week` — по неделям * `month` — по месяцам
Перем aggregationLevel Экспорт;

// skipDeletedNm - Булево - Скрыть удалённые товары
Перем skipDeletedNm Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("nmIDs") <> Неопределено Тогда
		nmIDs = Значения.Получить("nmIDs");
	КонецЕсли;
	Если Значения.Получить("subjectIds") <> Неопределено Тогда
		subjectIds = Значения.Получить("subjectIds");
	КонецЕсли;
	Если Значения.Получить("brandNames") <> Неопределено Тогда
		brandNames = Значения.Получить("brandNames");
	КонецЕсли;
	Если Значения.Получить("tagIds") <> Неопределено Тогда
		tagIds = Значения.Получить("tagIds");
	КонецЕсли;
	Если Значения.Получить("startDate") <> Неопределено Тогда
		startDate = Значения.Получить("startDate");
	КонецЕсли;
	Если Значения.Получить("endDate") <> Неопределено Тогда
		endDate = Значения.Получить("endDate");
	КонецЕсли;
	Если Значения.Получить("timezone") <> Неопределено Тогда
		timezone = Значения.Получить("timezone");
	КонецЕсли;
	Если Значения.Получить("aggregationLevel") <> Неопределено Тогда
		aggregationLevel = Значения.Получить("aggregationLevel");
	КонецЕсли;
	Если Значения.Получить("skipDeletedNm") <> Неопределено Тогда
		skipDeletedNm = Значения.Получить("skipDeletedNm");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если nmIDs <> Неопределено Тогда
		Результат.Вставить("nmIDs", ЗначениеДляJSON(nmIDs));
	КонецЕсли;
	Если subjectIds <> Неопределено Тогда
		Результат.Вставить("subjectIds", ЗначениеДляJSON(subjectIds));
	КонецЕсли;
	Если brandNames <> Неопределено Тогда
		Результат.Вставить("brandNames", ЗначениеДляJSON(brandNames));
	КонецЕсли;
	Если tagIds <> Неопределено Тогда
		Результат.Вставить("tagIds", ЗначениеДляJSON(tagIds));
	КонецЕсли;
	Если startDate <> Неопределено Тогда
		Результат.Вставить("startDate", ЗначениеДляJSON(startDate));
	КонецЕсли;
	Если endDate <> Неопределено Тогда
		Результат.Вставить("endDate", ЗначениеДляJSON(endDate));
	КонецЕсли;
	Если timezone <> Неопределено Тогда
		Результат.Вставить("timezone", ЗначениеДляJSON(timezone));
	КонецЕсли;
	Если aggregationLevel <> Неопределено Тогда
		Результат.Вставить("aggregationLevel", ЗначениеДляJSON(aggregationLevel));
	КонецЕсли;
	Если skipDeletedNm <> Неопределено Тогда
		Результат.Вставить("skipDeletedNm", ЗначениеДляJSON(skipDeletedNm));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

