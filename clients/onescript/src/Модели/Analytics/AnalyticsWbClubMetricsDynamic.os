// AnalyticsWbClubMetricsDynamic
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// orderCount - Число - Динамика количества заказов с WB Клубом
Перем orderCount Экспорт;

// orderSum - Число - Динамика суммы заказов с WB Клубом
Перем orderSum Экспорт;

// buyoutSum - Число - Динамика суммы выкупов с WB Клубом
Перем buyoutSum Экспорт;

// buyoutCount - Число - Динамика выкупов с WB Клубом
Перем buyoutCount Экспорт;

// cancelSum - Число - Динамика сумм отмен и возвратов товаров с WB Клубом
Перем cancelSum Экспорт;

// cancelCount - Число - Динамика отмен и возвратов товаров с WB Клубом
Перем cancelCount Экспорт;

// avgPrice - Число - Динамика средней цены на товары с WB Клубом
Перем avgPrice Экспорт;

// buyoutPercent - Число - Динамика процента выкупа с WB Клубом
Перем buyoutPercent Экспорт;

// avgOrderCountPerDay - Число - Динамика среднего количества заказов с WB Клубом в день
Перем avgOrderCountPerDay Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("orderCount") <> Неопределено Тогда
		orderCount = Значения.Получить("orderCount");
	КонецЕсли;
	Если Значения.Получить("orderSum") <> Неопределено Тогда
		orderSum = Значения.Получить("orderSum");
	КонецЕсли;
	Если Значения.Получить("buyoutSum") <> Неопределено Тогда
		buyoutSum = Значения.Получить("buyoutSum");
	КонецЕсли;
	Если Значения.Получить("buyoutCount") <> Неопределено Тогда
		buyoutCount = Значения.Получить("buyoutCount");
	КонецЕсли;
	Если Значения.Получить("cancelSum") <> Неопределено Тогда
		cancelSum = Значения.Получить("cancelSum");
	КонецЕсли;
	Если Значения.Получить("cancelCount") <> Неопределено Тогда
		cancelCount = Значения.Получить("cancelCount");
	КонецЕсли;
	Если Значения.Получить("avgPrice") <> Неопределено Тогда
		avgPrice = Значения.Получить("avgPrice");
	КонецЕсли;
	Если Значения.Получить("buyoutPercent") <> Неопределено Тогда
		buyoutPercent = Значения.Получить("buyoutPercent");
	КонецЕсли;
	Если Значения.Получить("avgOrderCountPerDay") <> Неопределено Тогда
		avgOrderCountPerDay = Значения.Получить("avgOrderCountPerDay");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если orderCount <> Неопределено Тогда
		Результат.Вставить("orderCount", ЗначениеДляJSON(orderCount));
	КонецЕсли;
	Если orderSum <> Неопределено Тогда
		Результат.Вставить("orderSum", ЗначениеДляJSON(orderSum));
	КонецЕсли;
	Если buyoutSum <> Неопределено Тогда
		Результат.Вставить("buyoutSum", ЗначениеДляJSON(buyoutSum));
	КонецЕсли;
	Если buyoutCount <> Неопределено Тогда
		Результат.Вставить("buyoutCount", ЗначениеДляJSON(buyoutCount));
	КонецЕсли;
	Если cancelSum <> Неопределено Тогда
		Результат.Вставить("cancelSum", ЗначениеДляJSON(cancelSum));
	КонецЕсли;
	Если cancelCount <> Неопределено Тогда
		Результат.Вставить("cancelCount", ЗначениеДляJSON(cancelCount));
	КонецЕсли;
	Если avgPrice <> Неопределено Тогда
		Результат.Вставить("avgPrice", ЗначениеДляJSON(avgPrice));
	КонецЕсли;
	Если buyoutPercent <> Неопределено Тогда
		Результат.Вставить("buyoutPercent", ЗначениеДляJSON(buyoutPercent));
	КонецЕсли;
	Если avgOrderCountPerDay <> Неопределено Тогда
		Результат.Вставить("avgOrderCountPerDay", ЗначениеДляJSON(avgOrderCountPerDay));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

