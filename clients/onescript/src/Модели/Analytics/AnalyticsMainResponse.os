// AnalyticsMainResponse
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// commonInfo - CommonInfo
Перем commonInfo Экспорт;

// positionInfo - PositionInfo
Перем positionInfo Экспорт;

// visibilityInfo - VisibilityInfo
Перем visibilityInfo Экспорт;

// groups - Массив - Список элементов таблицы
Перем groups Экспорт;

// currency - Строка - Валюта отчёта
Перем currency Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("commonInfo") <> Неопределено Тогда
		commonInfo = Значения.Получить("commonInfo");
	КонецЕсли;
	Если Значения.Получить("positionInfo") <> Неопределено Тогда
		positionInfo = Значения.Получить("positionInfo");
	КонецЕсли;
	Если Значения.Получить("visibilityInfo") <> Неопределено Тогда
		visibilityInfo = Значения.Получить("visibilityInfo");
	КонецЕсли;
	Если Значения.Получить("groups") <> Неопределено Тогда
		groups = Значения.Получить("groups");
	КонецЕсли;
	Если Значения.Получить("currency") <> Неопределено Тогда
		currency = Значения.Получить("currency");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если commonInfo <> Неопределено Тогда
		Результат.Вставить("commonInfo", ЗначениеДляJSON(commonInfo));
	КонецЕсли;
	Если positionInfo <> Неопределено Тогда
		Результат.Вставить("positionInfo", ЗначениеДляJSON(positionInfo));
	КонецЕсли;
	Если visibilityInfo <> Неопределено Тогда
		Результат.Вставить("visibilityInfo", ЗначениеДляJSON(visibilityInfo));
	КонецЕсли;
	Если groups <> Неопределено Тогда
		Результат.Вставить("groups", ЗначениеДляJSON(groups));
	КонецЕсли;
	Если currency <> Неопределено Тогда
		Результат.Вставить("currency", ЗначениеДляJSON(currency));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

