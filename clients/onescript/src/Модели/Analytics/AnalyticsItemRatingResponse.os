// AnalyticsItemRatingResponse
//
// Данные ответа
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// sellerRating - TableItemFloat
Перем sellerRating Экспорт;

// feedbackIncrease - FeedbacksIncreaseItem
Перем feedbackIncrease Экспорт;

// items - Массив - Данные по товарам
Перем items Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("sellerRating") <> Неопределено Тогда
		sellerRating = Значения.Получить("sellerRating");
	КонецЕсли;
	Если Значения.Получить("feedbackIncrease") <> Неопределено Тогда
		feedbackIncrease = Значения.Получить("feedbackIncrease");
	КонецЕсли;
	Если Значения.Получить("items") <> Неопределено Тогда
		items = Значения.Получить("items");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если sellerRating <> Неопределено Тогда
		Результат.Вставить("sellerRating", ЗначениеДляJSON(sellerRating));
	КонецЕсли;
	Если feedbackIncrease <> Неопределено Тогда
		Результат.Вставить("feedbackIncrease", ЗначениеДляJSON(feedbackIncrease));
	КонецЕсли;
	Если items <> Неопределено Тогда
		Результат.Вставить("items", ЗначениеДляJSON(items));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

