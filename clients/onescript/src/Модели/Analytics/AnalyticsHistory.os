// AnalyticsHistory
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// date - Дата - Дата сбора статистики
Перем date Экспорт;

// openCount - Число - Количество переходов в карточку товара
Перем openCount Экспорт;

// cartCount - Число - Положили в корзину, шт.
Перем cartCount Экспорт;

// orderCount - Число - Заказали товаров, шт.
Перем orderCount Экспорт;

// orderSum - Число - Заказали на сумму
Перем orderSum Экспорт;

// buyoutCount - Число - Выкупили товаров, шт.
Перем buyoutCount Экспорт;

// buyoutSum - Число - Выкупили на сумму
Перем buyoutSum Экспорт;

// buyoutPercent - Число - Процент выкупа
Перем buyoutPercent Экспорт;

// addToCartConversion - Число - Конверсия в корзину. Какой процент посетителей, открывших карточку товара, добавили товар в корзину, %
Перем addToCartConversion Экспорт;

// cartToOrderConversion - Число - Конверсия в заказ. Какой процент посетителей, добавивших товар в корзину, сделали заказ
Перем cartToOrderConversion Экспорт;

// addToWishlistCount - Число - Количество добавлений товара в **Отложенные**
Перем addToWishlistCount Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("date") <> Неопределено Тогда
		date = Значения.Получить("date");
	КонецЕсли;
	Если Значения.Получить("openCount") <> Неопределено Тогда
		openCount = Значения.Получить("openCount");
	КонецЕсли;
	Если Значения.Получить("cartCount") <> Неопределено Тогда
		cartCount = Значения.Получить("cartCount");
	КонецЕсли;
	Если Значения.Получить("orderCount") <> Неопределено Тогда
		orderCount = Значения.Получить("orderCount");
	КонецЕсли;
	Если Значения.Получить("orderSum") <> Неопределено Тогда
		orderSum = Значения.Получить("orderSum");
	КонецЕсли;
	Если Значения.Получить("buyoutCount") <> Неопределено Тогда
		buyoutCount = Значения.Получить("buyoutCount");
	КонецЕсли;
	Если Значения.Получить("buyoutSum") <> Неопределено Тогда
		buyoutSum = Значения.Получить("buyoutSum");
	КонецЕсли;
	Если Значения.Получить("buyoutPercent") <> Неопределено Тогда
		buyoutPercent = Значения.Получить("buyoutPercent");
	КонецЕсли;
	Если Значения.Получить("addToCartConversion") <> Неопределено Тогда
		addToCartConversion = Значения.Получить("addToCartConversion");
	КонецЕсли;
	Если Значения.Получить("cartToOrderConversion") <> Неопределено Тогда
		cartToOrderConversion = Значения.Получить("cartToOrderConversion");
	КонецЕсли;
	Если Значения.Получить("addToWishlistCount") <> Неопределено Тогда
		addToWishlistCount = Значения.Получить("addToWishlistCount");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если date <> Неопределено Тогда
		Результат.Вставить("date", ЗначениеДляJSON(date));
	КонецЕсли;
	Если openCount <> Неопределено Тогда
		Результат.Вставить("openCount", ЗначениеДляJSON(openCount));
	КонецЕсли;
	Если cartCount <> Неопределено Тогда
		Результат.Вставить("cartCount", ЗначениеДляJSON(cartCount));
	КонецЕсли;
	Если orderCount <> Неопределено Тогда
		Результат.Вставить("orderCount", ЗначениеДляJSON(orderCount));
	КонецЕсли;
	Если orderSum <> Неопределено Тогда
		Результат.Вставить("orderSum", ЗначениеДляJSON(orderSum));
	КонецЕсли;
	Если buyoutCount <> Неопределено Тогда
		Результат.Вставить("buyoutCount", ЗначениеДляJSON(buyoutCount));
	КонецЕсли;
	Если buyoutSum <> Неопределено Тогда
		Результат.Вставить("buyoutSum", ЗначениеДляJSON(buyoutSum));
	КонецЕсли;
	Если buyoutPercent <> Неопределено Тогда
		Результат.Вставить("buyoutPercent", ЗначениеДляJSON(buyoutPercent));
	КонецЕсли;
	Если addToCartConversion <> Неопределено Тогда
		Результат.Вставить("addToCartConversion", ЗначениеДляJSON(addToCartConversion));
	КонецЕсли;
	Если cartToOrderConversion <> Неопределено Тогда
		Результат.Вставить("cartToOrderConversion", ЗначениеДляJSON(cartToOrderConversion));
	КонецЕсли;
	Если addToWishlistCount <> Неопределено Тогда
		Результат.Вставить("addToWishlistCount", ЗначениеДляJSON(addToWishlistCount));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

