// AnalyticsCommonInfo
//
// Общая информация
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// supplierRating - CommonInfo_supplierRating
Перем supplierRating Экспорт;

// advertisedProducts - CommonInfo_advertisedProducts
Перем advertisedProducts Экспорт;

// totalProducts - Число - Общее количество товаров
Перем totalProducts Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("supplierRating") <> Неопределено Тогда
		supplierRating = Значения.Получить("supplierRating");
	КонецЕсли;
	Если Значения.Получить("advertisedProducts") <> Неопределено Тогда
		advertisedProducts = Значения.Получить("advertisedProducts");
	КонецЕсли;
	Если Значения.Получить("totalProducts") <> Неопределено Тогда
		totalProducts = Значения.Получить("totalProducts");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если supplierRating <> Неопределено Тогда
		Результат.Вставить("supplierRating", ЗначениеДляJSON(supplierRating));
	КонецЕсли;
	Если advertisedProducts <> Неопределено Тогда
		Результат.Вставить("advertisedProducts", ЗначениеДляJSON(advertisedProducts));
	КонецЕсли;
	Если totalProducts <> Неопределено Тогда
		Результат.Вставить("totalProducts", ЗначениеДляJSON(totalProducts));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

