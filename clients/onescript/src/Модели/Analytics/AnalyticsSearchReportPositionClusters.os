// AnalyticsSearchReportPositionClusters
//
// Количество товаров со средней позицией в поиске:
// - `firstHundred` — от 1 до 100
// - `secondHundred` — от 101 до 200
// - `below` — от 201 и ниже
//
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// firstHundred - SearchReportPositionClusters_firstHundred
Перем firstHundred Экспорт;

// secondHundred - SearchReportPositionClusters_secondHundred
Перем secondHundred Экспорт;

// below - SearchReportPositionClusters_below
Перем below Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("firstHundred") <> Неопределено Тогда
		firstHundred = Значения.Получить("firstHundred");
	КонецЕсли;
	Если Значения.Получить("secondHundred") <> Неопределено Тогда
		secondHundred = Значения.Получить("secondHundred");
	КонецЕсли;
	Если Значения.Получить("below") <> Неопределено Тогда
		below = Значения.Получить("below");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если firstHundred <> Неопределено Тогда
		Результат.Вставить("firstHundred", ЗначениеДляJSON(firstHundred));
	КонецЕсли;
	Если secondHundred <> Неопределено Тогда
		Результат.Вставить("secondHundred", ЗначениеДляJSON(secondHundred));
	КонецЕсли;
	Если below <> Неопределено Тогда
		Результат.Вставить("below", ЗначениеДляJSON(below));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

