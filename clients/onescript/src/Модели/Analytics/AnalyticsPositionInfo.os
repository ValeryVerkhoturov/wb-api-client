// AnalyticsPositionInfo
//
// Информация о позиции товара
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// average - PositionInfo_average
Перем average Экспорт;

// median - PositionInfo_median
Перем median Экспорт;

// chartItems - Массив - Данные для чарта по средней и медианной позиции товара в результатах поиска
Перем chartItems Экспорт;

// clusters - SearchReportPositionClusters
Перем clusters Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("average") <> Неопределено Тогда
		average = Значения.Получить("average");
	КонецЕсли;
	Если Значения.Получить("median") <> Неопределено Тогда
		median = Значения.Получить("median");
	КонецЕсли;
	Если Значения.Получить("chartItems") <> Неопределено Тогда
		chartItems = Значения.Получить("chartItems");
	КонецЕсли;
	Если Значения.Получить("clusters") <> Неопределено Тогда
		clusters = Значения.Получить("clusters");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если average <> Неопределено Тогда
		Результат.Вставить("average", ЗначениеДляJSON(average));
	КонецЕсли;
	Если median <> Неопределено Тогда
		Результат.Вставить("median", ЗначениеДляJSON(median));
	КонецЕсли;
	Если chartItems <> Неопределено Тогда
		Результат.Вставить("chartItems", ЗначениеДляJSON(chartItems));
	КонецЕсли;
	Если clusters <> Неопределено Тогда
		Результат.Вставить("clusters", ЗначениеДляJSON(clusters));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

