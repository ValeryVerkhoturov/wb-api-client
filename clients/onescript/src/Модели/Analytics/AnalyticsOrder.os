// AnalyticsOrder
//
// Заказ
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// nmId - Число - Артикул WB
Перем nmId Экспорт;

// chrtId - Число - ID размера
Перем chrtId Экспорт;

// srid - Строка - ID заказа
Перем srid Экспорт;

// createdAt - Дата - Дата и время оформления заказа
Перем createdAt Экспорт;

// updatedAt - Дата - Дата и время текущего статуса. При `\"status\":\"created\"` возвращается значение поля `createdAt`
Перем updatedAt Экспорт;

// status - Строка - Статус заказа: - `created` — оформлен - `buyout` — продан - `cancel` — отменён - `return` — возвращён - `returnDefective` — возвращён по причине брака
Перем status Экспорт;

// cancelType - Строка - Тип отмены (при `\"status\":\"cancel\"`): - `app` — отказ до получения - `receipt` — отказ при получении - `expire` — истёк срок получения - `other` — техническ…
Перем cancelType Экспорт;

// warehouseName - Строка - Название склада. [На данный момент](https://dev.wildberries.ru/release-notes?id=570) для складов WB может быть только `Склад WB`
Перем warehouseName Экспорт;

// warehouseRegion - Строка - Федеральный округ склада. Если склад не в России, возвращается страна. [На данный момент](https://dev.wildberries.ru/release-notes?id=570) для складов WB может…
Перем warehouseRegion Экспорт;

// isMp - Булево - Тип склада: - `true` — склад продавца - `false` — склад WB
Перем isMp Экспорт;

// destinationCity - Строка - Населённый пункт доставки
Перем destinationCity Экспорт;

// destinationDistrict - Строка - Федеральный округ доставки. Если доставка не по России, возвращается страна
Перем destinationDistrict Экспорт;

// sellerPrice - Число - Цена продавца со скидкой продавца (без учёта скидки WB Клуба и оптовой скидки для B2B-продаж)
Перем sellerPrice Экспорт;

// isB2b - Булево - Тип продажи: - `true` — B2B - `false` — B2C
Перем isB2b Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("nmId") <> Неопределено Тогда
		nmId = Значения.Получить("nmId");
	КонецЕсли;
	Если Значения.Получить("chrtId") <> Неопределено Тогда
		chrtId = Значения.Получить("chrtId");
	КонецЕсли;
	Если Значения.Получить("srid") <> Неопределено Тогда
		srid = Значения.Получить("srid");
	КонецЕсли;
	Если Значения.Получить("createdAt") <> Неопределено Тогда
		createdAt = Значения.Получить("createdAt");
	КонецЕсли;
	Если Значения.Получить("updatedAt") <> Неопределено Тогда
		updatedAt = Значения.Получить("updatedAt");
	КонецЕсли;
	Если Значения.Получить("status") <> Неопределено Тогда
		status = Значения.Получить("status");
	КонецЕсли;
	Если Значения.Получить("cancelType") <> Неопределено Тогда
		cancelType = Значения.Получить("cancelType");
	КонецЕсли;
	Если Значения.Получить("warehouseName") <> Неопределено Тогда
		warehouseName = Значения.Получить("warehouseName");
	КонецЕсли;
	Если Значения.Получить("warehouseRegion") <> Неопределено Тогда
		warehouseRegion = Значения.Получить("warehouseRegion");
	КонецЕсли;
	Если Значения.Получить("isMp") <> Неопределено Тогда
		isMp = Значения.Получить("isMp");
	КонецЕсли;
	Если Значения.Получить("destinationCity") <> Неопределено Тогда
		destinationCity = Значения.Получить("destinationCity");
	КонецЕсли;
	Если Значения.Получить("destinationDistrict") <> Неопределено Тогда
		destinationDistrict = Значения.Получить("destinationDistrict");
	КонецЕсли;
	Если Значения.Получить("sellerPrice") <> Неопределено Тогда
		sellerPrice = Значения.Получить("sellerPrice");
	КонецЕсли;
	Если Значения.Получить("isB2b") <> Неопределено Тогда
		isB2b = Значения.Получить("isB2b");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если nmId <> Неопределено Тогда
		Результат.Вставить("nmId", ЗначениеДляJSON(nmId));
	КонецЕсли;
	Если chrtId <> Неопределено Тогда
		Результат.Вставить("chrtId", ЗначениеДляJSON(chrtId));
	КонецЕсли;
	Если srid <> Неопределено Тогда
		Результат.Вставить("srid", ЗначениеДляJSON(srid));
	КонецЕсли;
	Если createdAt <> Неопределено Тогда
		Результат.Вставить("createdAt", ЗначениеДляJSON(createdAt));
	КонецЕсли;
	Если updatedAt <> Неопределено Тогда
		Результат.Вставить("updatedAt", ЗначениеДляJSON(updatedAt));
	КонецЕсли;
	Если status <> Неопределено Тогда
		Результат.Вставить("status", ЗначениеДляJSON(status));
	КонецЕсли;
	Если cancelType <> Неопределено Тогда
		Результат.Вставить("cancelType", ЗначениеДляJSON(cancelType));
	КонецЕсли;
	Если warehouseName <> Неопределено Тогда
		Результат.Вставить("warehouseName", ЗначениеДляJSON(warehouseName));
	КонецЕсли;
	Если warehouseRegion <> Неопределено Тогда
		Результат.Вставить("warehouseRegion", ЗначениеДляJSON(warehouseRegion));
	КонецЕсли;
	Если isMp <> Неопределено Тогда
		Результат.Вставить("isMp", ЗначениеДляJSON(isMp));
	КонецЕсли;
	Если destinationCity <> Неопределено Тогда
		Результат.Вставить("destinationCity", ЗначениеДляJSON(destinationCity));
	КонецЕсли;
	Если destinationDistrict <> Неопределено Тогда
		Результат.Вставить("destinationDistrict", ЗначениеДляJSON(destinationDistrict));
	КонецЕсли;
	Если sellerPrice <> Неопределено Тогда
		Результат.Вставить("sellerPrice", ЗначениеДляJSON(sellerPrice));
	КонецЕсли;
	Если isB2b <> Неопределено Тогда
		Результат.Вставить("isB2b", ЗначениеДляJSON(isB2b));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

