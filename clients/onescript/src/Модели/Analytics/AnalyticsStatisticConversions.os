// AnalyticsStatisticConversions
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// addToCartPercent - Число - Конверсия в корзину. Какой процент посетителей, открывших карточку товара, добавили товар в корзину, %
Перем addToCartPercent Экспорт;

// cartToOrderPercent - Число - Конверсия в заказ. Какой процент посетителей, добавивших товар в корзину, сделали заказ, %
Перем cartToOrderPercent Экспорт;

// buyoutPercent - Число - Процент выкупа. Какой процент посетителей, заказавших товар, его выкупили. Без учёта товаров, которые еще доставляются покупателю, %
Перем buyoutPercent Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("addToCartPercent") <> Неопределено Тогда
		addToCartPercent = Значения.Получить("addToCartPercent");
	КонецЕсли;
	Если Значения.Получить("cartToOrderPercent") <> Неопределено Тогда
		cartToOrderPercent = Значения.Получить("cartToOrderPercent");
	КонецЕсли;
	Если Значения.Получить("buyoutPercent") <> Неопределено Тогда
		buyoutPercent = Значения.Получить("buyoutPercent");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если addToCartPercent <> Неопределено Тогда
		Результат.Вставить("addToCartPercent", ЗначениеДляJSON(addToCartPercent));
	КонецЕсли;
	Если cartToOrderPercent <> Неопределено Тогда
		Результат.Вставить("cartToOrderPercent", ЗначениеДляJSON(cartToOrderPercent));
	КонецЕсли;
	Если buyoutPercent <> Неопределено Тогда
		Результат.Вставить("buyoutPercent", ЗначениеДляJSON(buyoutPercent));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

