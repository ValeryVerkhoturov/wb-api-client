// AnalyticsItemRatingRequest
//
// Параметры запроса
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// currentPeriod - PeriodItemRating
Перем currentPeriod Экспорт;

// pastPeriod - PastPeriodItemRating
Перем pastPeriod Экспорт;

// nmIds - Массив - Список артикулов WB для фильтрации
Перем nmIds Экспорт;

// subjectIds - Массив - Список ID предметов для фильтрации
Перем subjectIds Экспорт;

// brandNames - Массив - Список брендов для фильтрации
Перем brandNames Экспорт;

// tagIds - Массив - Список ID ярлыков для фильтрации
Перем tagIds Экспорт;

// isNotIncludeNmsWithoutSales - Булево - Не возвращать товары без продаж: - `true` — да, возвращаются только товары с продажами за период, указанный в объекте `currentPeriod` - `false` — нет, возвращаю…
Перем isNotIncludeNmsWithoutSales Экспорт;

// onlyShadowedNms - Булево - Возвращаются ли в ответе только скрытые товары: - `true` — да, возвращаются только скрытые из каталога товары - `false` — нет, возвращаются все товары, если не…
Перем onlyShadowedNms Экспорт;

// orderBy - OrderByItemRating
Перем orderBy Экспорт;

// limit - Число - Количество товаров в ответе
Перем limit Экспорт;

// offset - Число - Сколько элементов пропустить. Например, для значения `10` ответ начнётся с 11 элемента
Перем offset Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("currentPeriod") <> Неопределено Тогда
		currentPeriod = Значения.Получить("currentPeriod");
	КонецЕсли;
	Если Значения.Получить("pastPeriod") <> Неопределено Тогда
		pastPeriod = Значения.Получить("pastPeriod");
	КонецЕсли;
	Если Значения.Получить("nmIds") <> Неопределено Тогда
		nmIds = Значения.Получить("nmIds");
	КонецЕсли;
	Если Значения.Получить("subjectIds") <> Неопределено Тогда
		subjectIds = Значения.Получить("subjectIds");
	КонецЕсли;
	Если Значения.Получить("brandNames") <> Неопределено Тогда
		brandNames = Значения.Получить("brandNames");
	КонецЕсли;
	Если Значения.Получить("tagIds") <> Неопределено Тогда
		tagIds = Значения.Получить("tagIds");
	КонецЕсли;
	Если Значения.Получить("isNotIncludeNmsWithoutSales") <> Неопределено Тогда
		isNotIncludeNmsWithoutSales = Значения.Получить("isNotIncludeNmsWithoutSales");
	КонецЕсли;
	Если Значения.Получить("onlyShadowedNms") <> Неопределено Тогда
		onlyShadowedNms = Значения.Получить("onlyShadowedNms");
	КонецЕсли;
	Если Значения.Получить("orderBy") <> Неопределено Тогда
		orderBy = Значения.Получить("orderBy");
	КонецЕсли;
	Если Значения.Получить("limit") <> Неопределено Тогда
		limit = Значения.Получить("limit");
	КонецЕсли;
	Если Значения.Получить("offset") <> Неопределено Тогда
		offset = Значения.Получить("offset");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если currentPeriod <> Неопределено Тогда
		Результат.Вставить("currentPeriod", ЗначениеДляJSON(currentPeriod));
	КонецЕсли;
	Если pastPeriod <> Неопределено Тогда
		Результат.Вставить("pastPeriod", ЗначениеДляJSON(pastPeriod));
	КонецЕсли;
	Если nmIds <> Неопределено Тогда
		Результат.Вставить("nmIds", ЗначениеДляJSON(nmIds));
	КонецЕсли;
	Если subjectIds <> Неопределено Тогда
		Результат.Вставить("subjectIds", ЗначениеДляJSON(subjectIds));
	КонецЕсли;
	Если brandNames <> Неопределено Тогда
		Результат.Вставить("brandNames", ЗначениеДляJSON(brandNames));
	КонецЕсли;
	Если tagIds <> Неопределено Тогда
		Результат.Вставить("tagIds", ЗначениеДляJSON(tagIds));
	КонецЕсли;
	Если isNotIncludeNmsWithoutSales <> Неопределено Тогда
		Результат.Вставить("isNotIncludeNmsWithoutSales", ЗначениеДляJSON(isNotIncludeNmsWithoutSales));
	КонецЕсли;
	Если onlyShadowedNms <> Неопределено Тогда
		Результат.Вставить("onlyShadowedNms", ЗначениеДляJSON(onlyShadowedNms));
	КонецЕсли;
	Если orderBy <> Неопределено Тогда
		Результат.Вставить("orderBy", ЗначениеДляJSON(orderBy));
	КонецЕсли;
	Если limit <> Неопределено Тогда
		Результат.Вставить("limit", ЗначениеДляJSON(limit));
	КонецЕсли;
	Если offset <> Неопределено Тогда
		Результат.Вставить("offset", ЗначениеДляJSON(offset));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

