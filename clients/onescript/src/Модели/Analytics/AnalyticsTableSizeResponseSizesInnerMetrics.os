// AnalyticsTableSizeResponseSizesInnerMetrics
//
// Метрики размера
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// ordersCount - Число - Заказы, шт.
Перем ordersCount Экспорт;

// ordersSum - Число - Заказы, сумма
Перем ordersSum Экспорт;

// avgOrders - Число - Среднее количество заказов в день
Перем avgOrders Экспорт;

// avgOrdersByMonth - Массив - Среднее количество заказов по месяцам
Перем avgOrdersByMonth Экспорт;

// buyoutCount - Число - Выкупы, шт.
Перем buyoutCount Экспорт;

// buyoutSum - Число - Выкупы, сумма
Перем buyoutSum Экспорт;

// buyoutPercent - Число - Процент выкупа
Перем buyoutPercent Экспорт;

// stockCount - Число - Остатки на текущий день, шт.
Перем stockCount Экспорт;

// stockSum - Число - Стоимость остатков на текущий день
Перем stockSum Экспорт;

// saleRate - TableCommonMetrics_saleRate
Перем saleRate Экспорт;

// avgStockTurnover - TableCommonMetrics_avgStockTurnover
Перем avgStockTurnover Экспорт;

// toClientCount - Число - В пути к клиенту, шт.
Перем toClientCount Экспорт;

// fromClientCount - Число - В пути от клиента, шт.
Перем fromClientCount Экспорт;

// officeMissingTime - TableCommonMetrics_officeMissingTime
Перем officeMissingTime Экспорт;

// lostOrdersCount - Число - Упущенные заказы, шт. Особые случаи: 1. Значение меньше `0` и не равно `-2` — значение не рассчитано 2. Значение `-2` — нулевое значение
Перем lostOrdersCount Экспорт;

// lostOrdersSum - Число - Упущенные заказы, сумма. Особые случаи: 1. Значение меньше `0` и не равно `-2` — значение не рассчитано 2. Значение `-2` — нулевое значение
Перем lostOrdersSum Экспорт;

// lostBuyoutsCount - Число - Упущенные выкупы, шт. Особые случаи: 1. Значение меньше `0` и не равно `-2` — значение не рассчитано 2. Значение `-2` — нулевое значение
Перем lostBuyoutsCount Экспорт;

// lostBuyoutsSum - Число - Упущенные выкупы, сумма. Особые случаи: 1. Значение меньше `0` и не равно `-2` — значение не рассчитано 2. Значение `-2` — нулевое значение
Перем lostBuyoutsSum Экспорт;

// currentPrice - TableItemItemSt_metrics_allOf_currentPrice
Перем currentPrice Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("ordersCount") <> Неопределено Тогда
		ordersCount = Значения.Получить("ordersCount");
	КонецЕсли;
	Если Значения.Получить("ordersSum") <> Неопределено Тогда
		ordersSum = Значения.Получить("ordersSum");
	КонецЕсли;
	Если Значения.Получить("avgOrders") <> Неопределено Тогда
		avgOrders = Значения.Получить("avgOrders");
	КонецЕсли;
	Если Значения.Получить("avgOrdersByMonth") <> Неопределено Тогда
		avgOrdersByMonth = Значения.Получить("avgOrdersByMonth");
	КонецЕсли;
	Если Значения.Получить("buyoutCount") <> Неопределено Тогда
		buyoutCount = Значения.Получить("buyoutCount");
	КонецЕсли;
	Если Значения.Получить("buyoutSum") <> Неопределено Тогда
		buyoutSum = Значения.Получить("buyoutSum");
	КонецЕсли;
	Если Значения.Получить("buyoutPercent") <> Неопределено Тогда
		buyoutPercent = Значения.Получить("buyoutPercent");
	КонецЕсли;
	Если Значения.Получить("stockCount") <> Неопределено Тогда
		stockCount = Значения.Получить("stockCount");
	КонецЕсли;
	Если Значения.Получить("stockSum") <> Неопределено Тогда
		stockSum = Значения.Получить("stockSum");
	КонецЕсли;
	Если Значения.Получить("saleRate") <> Неопределено Тогда
		saleRate = Значения.Получить("saleRate");
	КонецЕсли;
	Если Значения.Получить("avgStockTurnover") <> Неопределено Тогда
		avgStockTurnover = Значения.Получить("avgStockTurnover");
	КонецЕсли;
	Если Значения.Получить("toClientCount") <> Неопределено Тогда
		toClientCount = Значения.Получить("toClientCount");
	КонецЕсли;
	Если Значения.Получить("fromClientCount") <> Неопределено Тогда
		fromClientCount = Значения.Получить("fromClientCount");
	КонецЕсли;
	Если Значения.Получить("officeMissingTime") <> Неопределено Тогда
		officeMissingTime = Значения.Получить("officeMissingTime");
	КонецЕсли;
	Если Значения.Получить("lostOrdersCount") <> Неопределено Тогда
		lostOrdersCount = Значения.Получить("lostOrdersCount");
	КонецЕсли;
	Если Значения.Получить("lostOrdersSum") <> Неопределено Тогда
		lostOrdersSum = Значения.Получить("lostOrdersSum");
	КонецЕсли;
	Если Значения.Получить("lostBuyoutsCount") <> Неопределено Тогда
		lostBuyoutsCount = Значения.Получить("lostBuyoutsCount");
	КонецЕсли;
	Если Значения.Получить("lostBuyoutsSum") <> Неопределено Тогда
		lostBuyoutsSum = Значения.Получить("lostBuyoutsSum");
	КонецЕсли;
	Если Значения.Получить("currentPrice") <> Неопределено Тогда
		currentPrice = Значения.Получить("currentPrice");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если ordersCount <> Неопределено Тогда
		Результат.Вставить("ordersCount", ЗначениеДляJSON(ordersCount));
	КонецЕсли;
	Если ordersSum <> Неопределено Тогда
		Результат.Вставить("ordersSum", ЗначениеДляJSON(ordersSum));
	КонецЕсли;
	Если avgOrders <> Неопределено Тогда
		Результат.Вставить("avgOrders", ЗначениеДляJSON(avgOrders));
	КонецЕсли;
	Если avgOrdersByMonth <> Неопределено Тогда
		Результат.Вставить("avgOrdersByMonth", ЗначениеДляJSON(avgOrdersByMonth));
	КонецЕсли;
	Если buyoutCount <> Неопределено Тогда
		Результат.Вставить("buyoutCount", ЗначениеДляJSON(buyoutCount));
	КонецЕсли;
	Если buyoutSum <> Неопределено Тогда
		Результат.Вставить("buyoutSum", ЗначениеДляJSON(buyoutSum));
	КонецЕсли;
	Если buyoutPercent <> Неопределено Тогда
		Результат.Вставить("buyoutPercent", ЗначениеДляJSON(buyoutPercent));
	КонецЕсли;
	Если stockCount <> Неопределено Тогда
		Результат.Вставить("stockCount", ЗначениеДляJSON(stockCount));
	КонецЕсли;
	Если stockSum <> Неопределено Тогда
		Результат.Вставить("stockSum", ЗначениеДляJSON(stockSum));
	КонецЕсли;
	Если saleRate <> Неопределено Тогда
		Результат.Вставить("saleRate", ЗначениеДляJSON(saleRate));
	КонецЕсли;
	Если avgStockTurnover <> Неопределено Тогда
		Результат.Вставить("avgStockTurnover", ЗначениеДляJSON(avgStockTurnover));
	КонецЕсли;
	Если toClientCount <> Неопределено Тогда
		Результат.Вставить("toClientCount", ЗначениеДляJSON(toClientCount));
	КонецЕсли;
	Если fromClientCount <> Неопределено Тогда
		Результат.Вставить("fromClientCount", ЗначениеДляJSON(fromClientCount));
	КонецЕсли;
	Если officeMissingTime <> Неопределено Тогда
		Результат.Вставить("officeMissingTime", ЗначениеДляJSON(officeMissingTime));
	КонецЕсли;
	Если lostOrdersCount <> Неопределено Тогда
		Результат.Вставить("lostOrdersCount", ЗначениеДляJSON(lostOrdersCount));
	КонецЕсли;
	Если lostOrdersSum <> Неопределено Тогда
		Результат.Вставить("lostOrdersSum", ЗначениеДляJSON(lostOrdersSum));
	КонецЕсли;
	Если lostBuyoutsCount <> Неопределено Тогда
		Результат.Вставить("lostBuyoutsCount", ЗначениеДляJSON(lostBuyoutsCount));
	КонецЕсли;
	Если lostBuyoutsSum <> Неопределено Тогда
		Результат.Вставить("lostBuyoutsSum", ЗначениеДляJSON(lostBuyoutsSum));
	КонецЕсли;
	Если currentPrice <> Неопределено Тогда
		Результат.Вставить("currentPrice", ЗначениеДляJSON(currentPrice));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

