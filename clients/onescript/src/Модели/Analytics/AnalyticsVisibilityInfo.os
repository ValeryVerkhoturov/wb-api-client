// AnalyticsVisibilityInfo
//
// Видимость карточек и переходы в карточки. По дням, неделям, месяцам
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// visibility - VisibilityInfo_visibility
Перем visibility Экспорт;

// openCard - VisibilityInfo_openCard
Перем openCard Экспорт;

// byDay - Массив - Данные для отрисовки графика в личном кабинете по видимости и переходам в карточки по дням
Перем byDay Экспорт;

// byWeek - Массив - Данные для отрисовки графика в личном кабинете по видимости и переходам в карточки по неделям
Перем byWeek Экспорт;

// byMonth - Массив - Данные для отрисовки графика в личном кабинете по видимости и переходам в карточки по месяцам
Перем byMonth Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("visibility") <> Неопределено Тогда
		visibility = Значения.Получить("visibility");
	КонецЕсли;
	Если Значения.Получить("openCard") <> Неопределено Тогда
		openCard = Значения.Получить("openCard");
	КонецЕсли;
	Если Значения.Получить("byDay") <> Неопределено Тогда
		byDay = Значения.Получить("byDay");
	КонецЕсли;
	Если Значения.Получить("byWeek") <> Неопределено Тогда
		byWeek = Значения.Получить("byWeek");
	КонецЕсли;
	Если Значения.Получить("byMonth") <> Неопределено Тогда
		byMonth = Значения.Получить("byMonth");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если visibility <> Неопределено Тогда
		Результат.Вставить("visibility", ЗначениеДляJSON(visibility));
	КонецЕсли;
	Если openCard <> Неопределено Тогда
		Результат.Вставить("openCard", ЗначениеДляJSON(openCard));
	КонецЕсли;
	Если byDay <> Неопределено Тогда
		Результат.Вставить("byDay", ЗначениеДляJSON(byDay));
	КонецЕсли;
	Если byWeek <> Неопределено Тогда
		Результат.Вставить("byWeek", ЗначениеДляJSON(byWeek));
	КонецЕсли;
	Если byMonth <> Неопределено Тогда
		Результат.Вставить("byMonth", ЗначениеДляJSON(byMonth));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

