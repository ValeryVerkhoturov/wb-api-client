// AnalyticsCommonItemFilters
//
// Общие фильтры по товару
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// nmIDs - Массив - Список артикулов WB для фильтрации
Перем nmIDs Экспорт;

// subjectID - Число - ID предмета
Перем subjectID Экспорт;

// brandName - Строка - Бренд
Перем brandName Экспорт;

// tagID - Число - ID ярлыка
Перем tagID Экспорт;

// currentPeriod - PeriodInv
Перем currentPeriod Экспорт;

// stockType - StockType
Перем stockType Экспорт;

// skipDeletedNm - Булево - Скрыть удалённые товары
Перем skipDeletedNm Экспорт;

// orderBy - TableOrderBy
Перем orderBy Экспорт;

// availabilityFilters - Массив - Доступность товара: - `deficient` — Дефицит - `actual` — Актуальный - `balanced` — Баланс - `nonActual` — Неактуальный - `nonLiquid` — Неликвид - `invalidData`…
Перем availabilityFilters Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("nmIDs") <> Неопределено Тогда
		nmIDs = Значения.Получить("nmIDs");
	КонецЕсли;
	Если Значения.Получить("subjectID") <> Неопределено Тогда
		subjectID = Значения.Получить("subjectID");
	КонецЕсли;
	Если Значения.Получить("brandName") <> Неопределено Тогда
		brandName = Значения.Получить("brandName");
	КонецЕсли;
	Если Значения.Получить("tagID") <> Неопределено Тогда
		tagID = Значения.Получить("tagID");
	КонецЕсли;
	Если Значения.Получить("currentPeriod") <> Неопределено Тогда
		currentPeriod = Значения.Получить("currentPeriod");
	КонецЕсли;
	Если Значения.Получить("stockType") <> Неопределено Тогда
		stockType = Значения.Получить("stockType");
	КонецЕсли;
	Если Значения.Получить("skipDeletedNm") <> Неопределено Тогда
		skipDeletedNm = Значения.Получить("skipDeletedNm");
	КонецЕсли;
	Если Значения.Получить("orderBy") <> Неопределено Тогда
		orderBy = Значения.Получить("orderBy");
	КонецЕсли;
	Если Значения.Получить("availabilityFilters") <> Неопределено Тогда
		availabilityFilters = Значения.Получить("availabilityFilters");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если nmIDs <> Неопределено Тогда
		Результат.Вставить("nmIDs", ЗначениеДляJSON(nmIDs));
	КонецЕсли;
	Если subjectID <> Неопределено Тогда
		Результат.Вставить("subjectID", ЗначениеДляJSON(subjectID));
	КонецЕсли;
	Если brandName <> Неопределено Тогда
		Результат.Вставить("brandName", ЗначениеДляJSON(brandName));
	КонецЕсли;
	Если tagID <> Неопределено Тогда
		Результат.Вставить("tagID", ЗначениеДляJSON(tagID));
	КонецЕсли;
	Если currentPeriod <> Неопределено Тогда
		Результат.Вставить("currentPeriod", ЗначениеДляJSON(currentPeriod));
	КонецЕсли;
	Если stockType <> Неопределено Тогда
		Результат.Вставить("stockType", ЗначениеДляJSON(stockType));
	КонецЕсли;
	Если skipDeletedNm <> Неопределено Тогда
		Результат.Вставить("skipDeletedNm", ЗначениеДляJSON(skipDeletedNm));
	КонецЕсли;
	Если orderBy <> Неопределено Тогда
		Результат.Вставить("orderBy", ЗначениеДляJSON(orderBy));
	КонецЕсли;
	Если availabilityFilters <> Неопределено Тогда
		Результат.Вставить("availabilityFilters", ЗначениеДляJSON(availabilityFilters));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

