// AnalyticsStatistic
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// period - Statistic_period
Перем period Экспорт;

// openCount - Число - Количество переходов в карточку товара
Перем openCount Экспорт;

// cartCount - Число - Положили в корзину, шт.
Перем cartCount Экспорт;

// orderCount - Число - Заказали товаров, шт.
Перем orderCount Экспорт;

// orderSum - Число - Заказали на сумму
Перем orderSum Экспорт;

// buyoutCount - Число - Выкупили товаров, шт.
Перем buyoutCount Экспорт;

// buyoutSum - Число - Выкупили на сумму
Перем buyoutSum Экспорт;

// cancelCount - Число - Отменили и вернули товаров, шт.
Перем cancelCount Экспорт;

// cancelSum - Число - Отменили и вернули на сумму
Перем cancelSum Экспорт;

// avgPrice - Число - Средняя цена
Перем avgPrice Экспорт;

// avgOrdersCountPerDay - Число - Среднее количество заказов в день, шт.
Перем avgOrdersCountPerDay Экспорт;

// shareOrderPercent - Число - Доля в выручке
Перем shareOrderPercent Экспорт;

// addToWishlist - Число - Добавили в **Отложенные**
Перем addToWishlist Экспорт;

// timeToReady - Statistic_timeToReady
Перем timeToReady Экспорт;

// localizationPercent - Число - Локальные заказы в рамках одного региона. [На данный момент](https://dev.wildberries.ru/release-notes?id=570) может быть только `100`
Перем localizationPercent Экспорт;

// wbClub - Statistic_wbClub
Перем wbClub Экспорт;

// conversions - Statistic_conversions
Перем conversions Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("period") <> Неопределено Тогда
		period = Значения.Получить("period");
	КонецЕсли;
	Если Значения.Получить("openCount") <> Неопределено Тогда
		openCount = Значения.Получить("openCount");
	КонецЕсли;
	Если Значения.Получить("cartCount") <> Неопределено Тогда
		cartCount = Значения.Получить("cartCount");
	КонецЕсли;
	Если Значения.Получить("orderCount") <> Неопределено Тогда
		orderCount = Значения.Получить("orderCount");
	КонецЕсли;
	Если Значения.Получить("orderSum") <> Неопределено Тогда
		orderSum = Значения.Получить("orderSum");
	КонецЕсли;
	Если Значения.Получить("buyoutCount") <> Неопределено Тогда
		buyoutCount = Значения.Получить("buyoutCount");
	КонецЕсли;
	Если Значения.Получить("buyoutSum") <> Неопределено Тогда
		buyoutSum = Значения.Получить("buyoutSum");
	КонецЕсли;
	Если Значения.Получить("cancelCount") <> Неопределено Тогда
		cancelCount = Значения.Получить("cancelCount");
	КонецЕсли;
	Если Значения.Получить("cancelSum") <> Неопределено Тогда
		cancelSum = Значения.Получить("cancelSum");
	КонецЕсли;
	Если Значения.Получить("avgPrice") <> Неопределено Тогда
		avgPrice = Значения.Получить("avgPrice");
	КонецЕсли;
	Если Значения.Получить("avgOrdersCountPerDay") <> Неопределено Тогда
		avgOrdersCountPerDay = Значения.Получить("avgOrdersCountPerDay");
	КонецЕсли;
	Если Значения.Получить("shareOrderPercent") <> Неопределено Тогда
		shareOrderPercent = Значения.Получить("shareOrderPercent");
	КонецЕсли;
	Если Значения.Получить("addToWishlist") <> Неопределено Тогда
		addToWishlist = Значения.Получить("addToWishlist");
	КонецЕсли;
	Если Значения.Получить("timeToReady") <> Неопределено Тогда
		timeToReady = Значения.Получить("timeToReady");
	КонецЕсли;
	Если Значения.Получить("localizationPercent") <> Неопределено Тогда
		localizationPercent = Значения.Получить("localizationPercent");
	КонецЕсли;
	Если Значения.Получить("wbClub") <> Неопределено Тогда
		wbClub = Значения.Получить("wbClub");
	КонецЕсли;
	Если Значения.Получить("conversions") <> Неопределено Тогда
		conversions = Значения.Получить("conversions");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если period <> Неопределено Тогда
		Результат.Вставить("period", ЗначениеДляJSON(period));
	КонецЕсли;
	Если openCount <> Неопределено Тогда
		Результат.Вставить("openCount", ЗначениеДляJSON(openCount));
	КонецЕсли;
	Если cartCount <> Неопределено Тогда
		Результат.Вставить("cartCount", ЗначениеДляJSON(cartCount));
	КонецЕсли;
	Если orderCount <> Неопределено Тогда
		Результат.Вставить("orderCount", ЗначениеДляJSON(orderCount));
	КонецЕсли;
	Если orderSum <> Неопределено Тогда
		Результат.Вставить("orderSum", ЗначениеДляJSON(orderSum));
	КонецЕсли;
	Если buyoutCount <> Неопределено Тогда
		Результат.Вставить("buyoutCount", ЗначениеДляJSON(buyoutCount));
	КонецЕсли;
	Если buyoutSum <> Неопределено Тогда
		Результат.Вставить("buyoutSum", ЗначениеДляJSON(buyoutSum));
	КонецЕсли;
	Если cancelCount <> Неопределено Тогда
		Результат.Вставить("cancelCount", ЗначениеДляJSON(cancelCount));
	КонецЕсли;
	Если cancelSum <> Неопределено Тогда
		Результат.Вставить("cancelSum", ЗначениеДляJSON(cancelSum));
	КонецЕсли;
	Если avgPrice <> Неопределено Тогда
		Результат.Вставить("avgPrice", ЗначениеДляJSON(avgPrice));
	КонецЕсли;
	Если avgOrdersCountPerDay <> Неопределено Тогда
		Результат.Вставить("avgOrdersCountPerDay", ЗначениеДляJSON(avgOrdersCountPerDay));
	КонецЕсли;
	Если shareOrderPercent <> Неопределено Тогда
		Результат.Вставить("shareOrderPercent", ЗначениеДляJSON(shareOrderPercent));
	КонецЕсли;
	Если addToWishlist <> Неопределено Тогда
		Результат.Вставить("addToWishlist", ЗначениеДляJSON(addToWishlist));
	КонецЕсли;
	Если timeToReady <> Неопределено Тогда
		Результат.Вставить("timeToReady", ЗначениеДляJSON(timeToReady));
	КонецЕсли;
	Если localizationPercent <> Неопределено Тогда
		Результат.Вставить("localizationPercent", ЗначениеДляJSON(localizationPercent));
	КонецЕсли;
	Если wbClub <> Неопределено Тогда
		Результат.Вставить("wbClub", ЗначениеДляJSON(wbClub));
	КонецЕсли;
	Если conversions <> Неопределено Тогда
		Результат.Вставить("conversions", ЗначениеДляJSON(conversions));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

