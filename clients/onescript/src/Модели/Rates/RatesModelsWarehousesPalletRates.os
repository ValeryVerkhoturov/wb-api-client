// RatesModelsWarehousesPalletRates
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// currency - Строка - Валюта тарифов
Перем currency Экспорт;

// dtNextPallet - Строка - Дата начала следующего тарифа
Перем dtNextPallet Экспорт;

// dtTillMax - Строка - Дата окончания последнего установленного тарифа
Перем dtTillMax Экспорт;

// warehouseList - Массив - Тарифы для монопаллет, сгруппированные по складам
Перем warehouseList Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("currency") <> Неопределено Тогда
		currency = Значения.Получить("currency");
	КонецЕсли;
	Если Значения.Получить("dtNextPallet") <> Неопределено Тогда
		dtNextPallet = Значения.Получить("dtNextPallet");
	КонецЕсли;
	Если Значения.Получить("dtTillMax") <> Неопределено Тогда
		dtTillMax = Значения.Получить("dtTillMax");
	КонецЕсли;
	Если Значения.Получить("warehouseList") <> Неопределено Тогда
		warehouseList = Значения.Получить("warehouseList");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если currency <> Неопределено Тогда
		Результат.Вставить("currency", ЗначениеДляJSON(currency));
	КонецЕсли;
	Если dtNextPallet <> Неопределено Тогда
		Результат.Вставить("dtNextPallet", ЗначениеДляJSON(dtNextPallet));
	КонецЕсли;
	Если dtTillMax <> Неопределено Тогда
		Результат.Вставить("dtTillMax", ЗначениеДляJSON(dtTillMax));
	КонецЕсли;
	Если warehouseList <> Неопределено Тогда
		Результат.Вставить("warehouseList", ЗначениеДляJSON(warehouseList));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

