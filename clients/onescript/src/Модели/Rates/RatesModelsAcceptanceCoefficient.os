// RatesModelsAcceptanceCoefficient
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// date - Строка - Дата начала действия коэффициента
Перем date Экспорт;

// coefficient - Число - Коэффициент приёмки: - `-1` — приёмка недоступна, вне зависимости от значения поля `allowUnload` - `0` — бесплатная приёмка - от `1` — множитель стоимости приём…
Перем coefficient Экспорт;

// warehouseID - Число - ID склада. По нему можно получить [информацию о складе](./orders-fbw#tag/informationForFormingSupplies/operation/getV1Warehouses)
Перем warehouseID Экспорт;

// warehouseName - Строка - Название склада
Перем warehouseName Экспорт;

// allowUnload - Булево - Доступность приёмки для поставок данного типа, смотри значение поля `boxTypeID`: - `true` — приёмка доступна - `false` — приёмка не доступна
Перем allowUnload Экспорт;

// boxTypeID - Число - ID типа поставки: - `2` — Короба - `5` — Монопаллеты - `6` — Суперсейф Для типа поставки \\*\\*QR-поставка с коробами\\*\\* поле не возвращается
Перем boxTypeID Экспорт;

// storageCoef - Строка - Коэффициент хранения
Перем storageCoef Экспорт;

// deliveryCoef - Строка - Коэффициент логистики
Перем deliveryCoef Экспорт;

// deliveryBaseLiter - Строка - Стоимость логистики первого литра
Перем deliveryBaseLiter Экспорт;

// deliveryAdditionalLiter - Строка - Стоимость логистики каждого следующего литра
Перем deliveryAdditionalLiter Экспорт;

// storageBaseLiter - Строка - Стоимость хранения: - для паллет — стоимость за одну паллету - для коробов — стоимость хранения за первый литр
Перем storageBaseLiter Экспорт;

// storageAdditionalLiter - Строка - Стоимость хранения каждого последующего литра: - для паллет — всегда будет `null`, т.к. стоимость хранения за единицу паллеты определяется в `StorageBaseLiter`…
Перем storageAdditionalLiter Экспорт;

// isSortingCenter - Булево - Тип склада: - `true` — сортировочный центр (СЦ) - `false` — обычный
Перем isSortingCenter Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("date") <> Неопределено Тогда
		date = Значения.Получить("date");
	КонецЕсли;
	Если Значения.Получить("coefficient") <> Неопределено Тогда
		coefficient = Значения.Получить("coefficient");
	КонецЕсли;
	Если Значения.Получить("warehouseID") <> Неопределено Тогда
		warehouseID = Значения.Получить("warehouseID");
	КонецЕсли;
	Если Значения.Получить("warehouseName") <> Неопределено Тогда
		warehouseName = Значения.Получить("warehouseName");
	КонецЕсли;
	Если Значения.Получить("allowUnload") <> Неопределено Тогда
		allowUnload = Значения.Получить("allowUnload");
	КонецЕсли;
	Если Значения.Получить("boxTypeID") <> Неопределено Тогда
		boxTypeID = Значения.Получить("boxTypeID");
	КонецЕсли;
	Если Значения.Получить("storageCoef") <> Неопределено Тогда
		storageCoef = Значения.Получить("storageCoef");
	КонецЕсли;
	Если Значения.Получить("deliveryCoef") <> Неопределено Тогда
		deliveryCoef = Значения.Получить("deliveryCoef");
	КонецЕсли;
	Если Значения.Получить("deliveryBaseLiter") <> Неопределено Тогда
		deliveryBaseLiter = Значения.Получить("deliveryBaseLiter");
	КонецЕсли;
	Если Значения.Получить("deliveryAdditionalLiter") <> Неопределено Тогда
		deliveryAdditionalLiter = Значения.Получить("deliveryAdditionalLiter");
	КонецЕсли;
	Если Значения.Получить("storageBaseLiter") <> Неопределено Тогда
		storageBaseLiter = Значения.Получить("storageBaseLiter");
	КонецЕсли;
	Если Значения.Получить("storageAdditionalLiter") <> Неопределено Тогда
		storageAdditionalLiter = Значения.Получить("storageAdditionalLiter");
	КонецЕсли;
	Если Значения.Получить("isSortingCenter") <> Неопределено Тогда
		isSortingCenter = Значения.Получить("isSortingCenter");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если date <> Неопределено Тогда
		Результат.Вставить("date", ЗначениеДляJSON(date));
	КонецЕсли;
	Если coefficient <> Неопределено Тогда
		Результат.Вставить("coefficient", ЗначениеДляJSON(coefficient));
	КонецЕсли;
	Если warehouseID <> Неопределено Тогда
		Результат.Вставить("warehouseID", ЗначениеДляJSON(warehouseID));
	КонецЕсли;
	Если warehouseName <> Неопределено Тогда
		Результат.Вставить("warehouseName", ЗначениеДляJSON(warehouseName));
	КонецЕсли;
	Если allowUnload <> Неопределено Тогда
		Результат.Вставить("allowUnload", ЗначениеДляJSON(allowUnload));
	КонецЕсли;
	Если boxTypeID <> Неопределено Тогда
		Результат.Вставить("boxTypeID", ЗначениеДляJSON(boxTypeID));
	КонецЕсли;
	Если storageCoef <> Неопределено Тогда
		Результат.Вставить("storageCoef", ЗначениеДляJSON(storageCoef));
	КонецЕсли;
	Если deliveryCoef <> Неопределено Тогда
		Результат.Вставить("deliveryCoef", ЗначениеДляJSON(deliveryCoef));
	КонецЕсли;
	Если deliveryBaseLiter <> Неопределено Тогда
		Результат.Вставить("deliveryBaseLiter", ЗначениеДляJSON(deliveryBaseLiter));
	КонецЕсли;
	Если deliveryAdditionalLiter <> Неопределено Тогда
		Результат.Вставить("deliveryAdditionalLiter", ЗначениеДляJSON(deliveryAdditionalLiter));
	КонецЕсли;
	Если storageBaseLiter <> Неопределено Тогда
		Результат.Вставить("storageBaseLiter", ЗначениеДляJSON(storageBaseLiter));
	КонецЕсли;
	Если storageAdditionalLiter <> Неопределено Тогда
		Результат.Вставить("storageAdditionalLiter", ЗначениеДляJSON(storageAdditionalLiter));
	КонецЕсли;
	Если isSortingCenter <> Неопределено Тогда
		Результат.Вставить("isSortingCenter", ЗначениеДляJSON(isSortingCenter));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

