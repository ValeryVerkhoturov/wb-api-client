// RatesModelsWarehousesReturnRates
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// currency - Строка - Валюта тарифов
Перем currency Экспорт;

// dtNextDeliveryDumpKgt - Строка - Дата начала следующего тарифа при грузовой доставке
Перем dtNextDeliveryDumpKgt Экспорт;

// dtNextDeliveryDumpSrg - Строка - Дата начала следующего тарифа для неопознанных товаров
Перем dtNextDeliveryDumpSrg Экспорт;

// dtNextDeliveryDumpSup - Строка - Дата начала следующего тарифа при обычной доставке
Перем dtNextDeliveryDumpSup Экспорт;

// warehouseList - Массив - Тарифы на возврат, сгруппированные по складам: - стоимость возврата брака и возврата по инициативе продавца при грузовой доставке. - стоимость возврата неопозна…
Перем warehouseList Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("currency") <> Неопределено Тогда
		currency = Значения.Получить("currency");
	КонецЕсли;
	Если Значения.Получить("dtNextDeliveryDumpKgt") <> Неопределено Тогда
		dtNextDeliveryDumpKgt = Значения.Получить("dtNextDeliveryDumpKgt");
	КонецЕсли;
	Если Значения.Получить("dtNextDeliveryDumpSrg") <> Неопределено Тогда
		dtNextDeliveryDumpSrg = Значения.Получить("dtNextDeliveryDumpSrg");
	КонецЕсли;
	Если Значения.Получить("dtNextDeliveryDumpSup") <> Неопределено Тогда
		dtNextDeliveryDumpSup = Значения.Получить("dtNextDeliveryDumpSup");
	КонецЕсли;
	Если Значения.Получить("warehouseList") <> Неопределено Тогда
		warehouseList = Значения.Получить("warehouseList");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если currency <> Неопределено Тогда
		Результат.Вставить("currency", ЗначениеДляJSON(currency));
	КонецЕсли;
	Если dtNextDeliveryDumpKgt <> Неопределено Тогда
		Результат.Вставить("dtNextDeliveryDumpKgt", ЗначениеДляJSON(dtNextDeliveryDumpKgt));
	КонецЕсли;
	Если dtNextDeliveryDumpSrg <> Неопределено Тогда
		Результат.Вставить("dtNextDeliveryDumpSrg", ЗначениеДляJSON(dtNextDeliveryDumpSrg));
	КонецЕсли;
	Если dtNextDeliveryDumpSup <> Неопределено Тогда
		Результат.Вставить("dtNextDeliveryDumpSup", ЗначениеДляJSON(dtNextDeliveryDumpSup));
	КонецЕсли;
	Если warehouseList <> Неопределено Тогда
		Результат.Вставить("warehouseList", ЗначениеДляJSON(warehouseList));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

