// RatesModelsWarehousePalletRates
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// palletDeliveryExpr - Строка - Коэффициент доставки, %. На него умножается стоимость доставки. Во всех тарифах этот коэффициент уже учтён
Перем palletDeliveryExpr Экспорт;

// palletDeliveryValueBase - Строка - Доставка 1 литра, ₽
Перем palletDeliveryValueBase Экспорт;

// palletDeliveryValueLiter - Строка - Доставка каждого дополнительного литра, ₽
Перем palletDeliveryValueLiter Экспорт;

// palletStorageExpr - Строка - Коэффициент хранения, %. На него умножается стоимость хранения. Во всех тарифах этот коэффициент уже учтён
Перем palletStorageExpr Экспорт;

// palletStorageValueExpr - Строка - Хранение 1 монопаллеты, ₽
Перем palletStorageValueExpr Экспорт;

// warehouseName - Строка - Название склада
Перем warehouseName Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("palletDeliveryExpr") <> Неопределено Тогда
		palletDeliveryExpr = Значения.Получить("palletDeliveryExpr");
	КонецЕсли;
	Если Значения.Получить("palletDeliveryValueBase") <> Неопределено Тогда
		palletDeliveryValueBase = Значения.Получить("palletDeliveryValueBase");
	КонецЕсли;
	Если Значения.Получить("palletDeliveryValueLiter") <> Неопределено Тогда
		palletDeliveryValueLiter = Значения.Получить("palletDeliveryValueLiter");
	КонецЕсли;
	Если Значения.Получить("palletStorageExpr") <> Неопределено Тогда
		palletStorageExpr = Значения.Получить("palletStorageExpr");
	КонецЕсли;
	Если Значения.Получить("palletStorageValueExpr") <> Неопределено Тогда
		palletStorageValueExpr = Значения.Получить("palletStorageValueExpr");
	КонецЕсли;
	Если Значения.Получить("warehouseName") <> Неопределено Тогда
		warehouseName = Значения.Получить("warehouseName");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если palletDeliveryExpr <> Неопределено Тогда
		Результат.Вставить("palletDeliveryExpr", ЗначениеДляJSON(palletDeliveryExpr));
	КонецЕсли;
	Если palletDeliveryValueBase <> Неопределено Тогда
		Результат.Вставить("palletDeliveryValueBase", ЗначениеДляJSON(palletDeliveryValueBase));
	КонецЕсли;
	Если palletDeliveryValueLiter <> Неопределено Тогда
		Результат.Вставить("palletDeliveryValueLiter", ЗначениеДляJSON(palletDeliveryValueLiter));
	КонецЕсли;
	Если palletStorageExpr <> Неопределено Тогда
		Результат.Вставить("palletStorageExpr", ЗначениеДляJSON(palletStorageExpr));
	КонецЕсли;
	Если palletStorageValueExpr <> Неопределено Тогда
		Результат.Вставить("palletStorageValueExpr", ЗначениеДляJSON(palletStorageValueExpr));
	КонецЕсли;
	Если warehouseName <> Неопределено Тогда
		Результат.Вставить("warehouseName", ЗначениеДляJSON(warehouseName));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

