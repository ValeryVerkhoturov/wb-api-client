// RatesFeeReportInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// kgvpBooking - Число - Комиссия по модели **Бронирование**, %
Перем kgvpBooking Экспорт;

// kgvpMarketplace - Число - Комиссия по модели **Маркетплейс** (`FBS`), %
Перем kgvpMarketplace Экспорт;

// kgvpPickup - Число - Комиссия по модели **Самовывоз из магазина продавца** (`C&C`), %
Перем kgvpPickup Экспорт;

// kgvpSupplier - Число - Комиссия по моделям **Витрина** (`DBS`) и **Деливери WB** (`DBW`), %
Перем kgvpSupplier Экспорт;

// kgvpSupplierExpress - Число - Комиссия по модели **Витрина экспресс** (`EDBS`), %
Перем kgvpSupplierExpress Экспорт;

// paidStorageKgvp - Число - Комиссия по модели **Склад WB** (`FBW`), %
Перем paidStorageKgvp Экспорт;

// parentID - Число - ID родительской категории
Перем parentID Экспорт;

// parentName - Строка - Название родительской категории
Перем parentName Экспорт;

// subjectID - Число - ID предмета
Перем subjectID Экспорт;

// subjectName - Строка - Название предмета
Перем subjectName Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("kgvpBooking") <> Неопределено Тогда
		kgvpBooking = Значения.Получить("kgvpBooking");
	КонецЕсли;
	Если Значения.Получить("kgvpMarketplace") <> Неопределено Тогда
		kgvpMarketplace = Значения.Получить("kgvpMarketplace");
	КонецЕсли;
	Если Значения.Получить("kgvpPickup") <> Неопределено Тогда
		kgvpPickup = Значения.Получить("kgvpPickup");
	КонецЕсли;
	Если Значения.Получить("kgvpSupplier") <> Неопределено Тогда
		kgvpSupplier = Значения.Получить("kgvpSupplier");
	КонецЕсли;
	Если Значения.Получить("kgvpSupplierExpress") <> Неопределено Тогда
		kgvpSupplierExpress = Значения.Получить("kgvpSupplierExpress");
	КонецЕсли;
	Если Значения.Получить("paidStorageKgvp") <> Неопределено Тогда
		paidStorageKgvp = Значения.Получить("paidStorageKgvp");
	КонецЕсли;
	Если Значения.Получить("parentID") <> Неопределено Тогда
		parentID = Значения.Получить("parentID");
	КонецЕсли;
	Если Значения.Получить("parentName") <> Неопределено Тогда
		parentName = Значения.Получить("parentName");
	КонецЕсли;
	Если Значения.Получить("subjectID") <> Неопределено Тогда
		subjectID = Значения.Получить("subjectID");
	КонецЕсли;
	Если Значения.Получить("subjectName") <> Неопределено Тогда
		subjectName = Значения.Получить("subjectName");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если kgvpBooking <> Неопределено Тогда
		Результат.Вставить("kgvpBooking", ЗначениеДляJSON(kgvpBooking));
	КонецЕсли;
	Если kgvpMarketplace <> Неопределено Тогда
		Результат.Вставить("kgvpMarketplace", ЗначениеДляJSON(kgvpMarketplace));
	КонецЕсли;
	Если kgvpPickup <> Неопределено Тогда
		Результат.Вставить("kgvpPickup", ЗначениеДляJSON(kgvpPickup));
	КонецЕсли;
	Если kgvpSupplier <> Неопределено Тогда
		Результат.Вставить("kgvpSupplier", ЗначениеДляJSON(kgvpSupplier));
	КонецЕсли;
	Если kgvpSupplierExpress <> Неопределено Тогда
		Результат.Вставить("kgvpSupplierExpress", ЗначениеДляJSON(kgvpSupplierExpress));
	КонецЕсли;
	Если paidStorageKgvp <> Неопределено Тогда
		Результат.Вставить("paidStorageKgvp", ЗначениеДляJSON(paidStorageKgvp));
	КонецЕсли;
	Если parentID <> Неопределено Тогда
		Результат.Вставить("parentID", ЗначениеДляJSON(parentID));
	КонецЕсли;
	Если parentName <> Неопределено Тогда
		Результат.Вставить("parentName", ЗначениеДляJSON(parentName));
	КонецЕсли;
	Если subjectID <> Неопределено Тогда
		Результат.Вставить("subjectID", ЗначениеДляJSON(subjectID));
	КонецЕсли;
	Если subjectName <> Неопределено Тогда
		Результат.Вставить("subjectName", ЗначениеДляJSON(subjectName));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

