// PromotionPostV1CalendarPromotionsUploadRequestData
//
// Данные запроса
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// promotionID - Число - ID акции
Перем promotionID Экспорт;

// uploadNow - Булево - Установить скидку: - `true` — сейчас - `false` — в момент старта акции
Перем uploadNow Экспорт;

// nomenclatures - Массив - Артикулы WB, которые можно добавить в акцию
Перем nomenclatures Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("promotionID") <> Неопределено Тогда
		promotionID = Значения.Получить("promotionID");
	КонецЕсли;
	Если Значения.Получить("uploadNow") <> Неопределено Тогда
		uploadNow = Значения.Получить("uploadNow");
	КонецЕсли;
	Если Значения.Получить("nomenclatures") <> Неопределено Тогда
		nomenclatures = Значения.Получить("nomenclatures");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если promotionID <> Неопределено Тогда
		Результат.Вставить("promotionID", ЗначениеДляJSON(promotionID));
	КонецЕсли;
	Если uploadNow <> Неопределено Тогда
		Результат.Вставить("uploadNow", ЗначениеДляJSON(uploadNow));
	КонецЕсли;
	Если nomenclatures <> Неопределено Тогда
		Результат.Вставить("nomenclatures", ЗначениеДляJSON(nomenclatures));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

