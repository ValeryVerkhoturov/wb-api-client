// PromotionPostV1BudgetDepositRequest
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// sum - Число - Общая сумма пополнения бюджета в базовых единицах валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем sum Экспорт;

// cashback_sum - Число - Сумма пополнения бюджета промо-бонусами. Пополнить можно только определённый процент от общей суммы, указанный в поле `percent` ответа метода получения [баланса…
Перем cashback_sum Экспорт;

// cashback_percent - Число - Процент от суммы пополнения, который можно пополнить промо-бонусами. Нужно указать значение поля percent из ответа метода получения [баланса](./promotion#tag/fi…
Перем cashback_percent Экспорт;

// type - Число - Тип источника пополнения: - `0` — Счёт - `1` — Баланс - `3` — Бонусы
Перем type Экспорт;

// return - Булево - Флаг возврата ответа (`true` — в ответе вернется обновлённый размер бюджета кампании, `false` или не указать параметр вообще — не вернётся.)
Перем _return Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("sum") <> Неопределено Тогда
		sum = Значения.Получить("sum");
	КонецЕсли;
	Если Значения.Получить("cashback_sum") <> Неопределено Тогда
		cashback_sum = Значения.Получить("cashback_sum");
	КонецЕсли;
	Если Значения.Получить("cashback_percent") <> Неопределено Тогда
		cashback_percent = Значения.Получить("cashback_percent");
	КонецЕсли;
	Если Значения.Получить("type") <> Неопределено Тогда
		type = Значения.Получить("type");
	КонецЕсли;
	Если Значения.Получить("return") <> Неопределено Тогда
		_return = Значения.Получить("return");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если sum <> Неопределено Тогда
		Результат.Вставить("sum", ЗначениеДляJSON(sum));
	КонецЕсли;
	Если cashback_sum <> Неопределено Тогда
		Результат.Вставить("cashback_sum", ЗначениеДляJSON(cashback_sum));
	КонецЕсли;
	Если cashback_percent <> Неопределено Тогда
		Результат.Вставить("cashback_percent", ЗначениеДляJSON(cashback_percent));
	КонецЕсли;
	Если type <> Неопределено Тогда
		Результат.Вставить("type", ЗначениеДляJSON(type));
	КонецЕсли;
	Если _return <> Неопределено Тогда
		Результат.Вставить("return", ЗначениеДляJSON(_return));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

