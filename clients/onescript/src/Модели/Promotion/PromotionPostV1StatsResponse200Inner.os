// PromotionPostV1StatsResponse200Inner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// interval - StatInterval_interval
Перем interval Экспорт;

// stats - Массив - Блок статистики
Перем stats Экспорт;

// dates - Массив - Даты, за которые нужно получить информацию
Перем dates Экспорт;

// advert_id - Число - ID кампании
Перем advert_id Экспорт;

// error - Строка - Описание ошибки
Перем error Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("interval") <> Неопределено Тогда
		interval = Значения.Получить("interval");
	КонецЕсли;
	Если Значения.Получить("stats") <> Неопределено Тогда
		stats = Значения.Получить("stats");
	КонецЕсли;
	Если Значения.Получить("dates") <> Неопределено Тогда
		dates = Значения.Получить("dates");
	КонецЕсли;
	Если Значения.Получить("advert_id") <> Неопределено Тогда
		advert_id = Значения.Получить("advert_id");
	КонецЕсли;
	Если Значения.Получить("error") <> Неопределено Тогда
		error = Значения.Получить("error");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если interval <> Неопределено Тогда
		Результат.Вставить("interval", ЗначениеДляJSON(interval));
	КонецЕсли;
	Если stats <> Неопределено Тогда
		Результат.Вставить("stats", ЗначениеДляJSON(stats));
	КонецЕсли;
	Если dates <> Неопределено Тогда
		Результат.Вставить("dates", ЗначениеДляJSON(dates));
	КонецЕсли;
	Если advert_id <> Неопределено Тогда
		Результат.Вставить("advert_id", ЗначениеДляJSON(advert_id));
	КонецЕсли;
	Если error <> Неопределено Тогда
		Результат.Вставить("error", ЗначениеДляJSON(error));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

