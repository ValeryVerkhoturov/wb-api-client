// PromotionGetV1CalendarPromotionsDetails200ResponseDataPromotionsInnerRangingInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// condition - Строка - Тип [ранжирования](https://seller.wildberries.ru/help-center/article/A-385): - `productsInPromotion` — продвижение получат товары продавца, участвующие в акции…
Перем condition Экспорт;

// participationRate - Число - Количество товаров продавца для перехода на следующий уровень ранжирования, %
Перем participationRate Экспорт;

// boost - Число - Текущий уровень поднятия в поиске, %
Перем boost Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("condition") <> Неопределено Тогда
		condition = Значения.Получить("condition");
	КонецЕсли;
	Если Значения.Получить("participationRate") <> Неопределено Тогда
		participationRate = Значения.Получить("participationRate");
	КонецЕсли;
	Если Значения.Получить("boost") <> Неопределено Тогда
		boost = Значения.Получить("boost");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если condition <> Неопределено Тогда
		Результат.Вставить("condition", ЗначениеДляJSON(condition));
	КонецЕсли;
	Если participationRate <> Неопределено Тогда
		Результат.Вставить("participationRate", ЗначениеДляJSON(participationRate));
	КонецЕсли;
	Если boost <> Неопределено Тогда
		Результат.Вставить("boost", ЗначениеДляJSON(boost));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

