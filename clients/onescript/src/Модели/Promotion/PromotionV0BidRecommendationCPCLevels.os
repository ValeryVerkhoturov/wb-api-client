// PromotionV0BidRecommendationCPCLevels
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// range1To2 - V0BidRecommendationBaseBid - Ставка для попадания в позиции 1-2
Перем range1To2 Экспорт;

// range3To10 - V0BidRecommendationBaseBid - Ставка для попадания в позиции 3-10
Перем range3To10 Экспорт;

// range11To34 - V0BidRecommendationBaseBid - Ставка для попадания в позиции 11-34
Перем range11To34 Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("range1To2") <> Неопределено Тогда
		range1To2 = Значения.Получить("range1To2");
	КонецЕсли;
	Если Значения.Получить("range3To10") <> Неопределено Тогда
		range3To10 = Значения.Получить("range3To10");
	КонецЕсли;
	Если Значения.Получить("range11To34") <> Неопределено Тогда
		range11To34 = Значения.Получить("range11To34");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если range1To2 <> Неопределено Тогда
		Результат.Вставить("range1To2", ЗначениеДляJSON(range1To2));
	КонецЕсли;
	Если range3To10 <> Неопределено Тогда
		Результат.Вставить("range3To10", ЗначениеДляJSON(range3To10));
	КонецЕсли;
	Если range11To34 <> Неопределено Тогда
		Результат.Вставить("range11To34", ЗначениеДляJSON(range11To34));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

