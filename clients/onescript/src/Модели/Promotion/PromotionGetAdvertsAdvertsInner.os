// PromotionGetAdvertsAdvertsInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// bid_type - Строка - Тип ставки: - `unified` — единая ставка - `manual` — ручная ставка
Перем bid_type Экспорт;

// currency - Строка - Валюта [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем currency Экспорт;

// id - Число - ID кампании
Перем id Экспорт;

// nm_settings - Массив - Настройки товаров
Перем nm_settings Экспорт;

// settings - AdvertSettings
Перем settings Экспорт;

// restrictions - GetAdverts_adverts_inner_restrictions
Перем restrictions Экспорт;

// status - Число - Статус кампании: - `-1` — удалена, процесс удаления будет завершён в течение 10 минут - `4` — готова к запуску - `7` — завершена - `8` — отменена - `9` — активн…
Перем status Экспорт;

// timestamps - Timestamps
Перем timestamps Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("bid_type") <> Неопределено Тогда
		bid_type = Значения.Получить("bid_type");
	КонецЕсли;
	Если Значения.Получить("currency") <> Неопределено Тогда
		currency = Значения.Получить("currency");
	КонецЕсли;
	Если Значения.Получить("id") <> Неопределено Тогда
		id = Значения.Получить("id");
	КонецЕсли;
	Если Значения.Получить("nm_settings") <> Неопределено Тогда
		nm_settings = Значения.Получить("nm_settings");
	КонецЕсли;
	Если Значения.Получить("settings") <> Неопределено Тогда
		settings = Значения.Получить("settings");
	КонецЕсли;
	Если Значения.Получить("restrictions") <> Неопределено Тогда
		restrictions = Значения.Получить("restrictions");
	КонецЕсли;
	Если Значения.Получить("status") <> Неопределено Тогда
		status = Значения.Получить("status");
	КонецЕсли;
	Если Значения.Получить("timestamps") <> Неопределено Тогда
		timestamps = Значения.Получить("timestamps");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если bid_type <> Неопределено Тогда
		Результат.Вставить("bid_type", ЗначениеДляJSON(bid_type));
	КонецЕсли;
	Если currency <> Неопределено Тогда
		Результат.Вставить("currency", ЗначениеДляJSON(currency));
	КонецЕсли;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Если nm_settings <> Неопределено Тогда
		Результат.Вставить("nm_settings", ЗначениеДляJSON(nm_settings));
	КонецЕсли;
	Если settings <> Неопределено Тогда
		Результат.Вставить("settings", ЗначениеДляJSON(settings));
	КонецЕсли;
	Если restrictions <> Неопределено Тогда
		Результат.Вставить("restrictions", ЗначениеДляJSON(restrictions));
	КонецЕсли;
	Если status <> Неопределено Тогда
		Результат.Вставить("status", ЗначениеДляJSON(status));
	КонецЕсли;
	Если timestamps <> Неопределено Тогда
		Результат.Вставить("timestamps", ЗначениеДляJSON(timestamps));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

