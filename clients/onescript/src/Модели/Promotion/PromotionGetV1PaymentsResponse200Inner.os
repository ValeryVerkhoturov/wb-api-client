// PromotionGetV1PaymentsResponse200Inner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// id - Число - ID платежа
Перем id Экспорт;

// date - Строка - Дата платежа
Перем date Экспорт;

// sum - Число - Сумма платежа
Перем sum Экспорт;

// type - Число - Тип источника списания: - `0` — Счёт - `1` — Баланс - `3` — Картой
Перем type Экспорт;

// statusId - Число - Статус: - `0` — ошибка - `1` — обработано
Перем statusId Экспорт;

// cardStatus - Строка - Статус операции при оплате картой: - `success` — успех - `fail` — неуспех - `pending` — в ожидании ответа - `unknown` — неизвестно
Перем cardStatus Экспорт;

// currency - Строка - Валюта [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем currency Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("id") <> Неопределено Тогда
		id = Значения.Получить("id");
	КонецЕсли;
	Если Значения.Получить("date") <> Неопределено Тогда
		date = Значения.Получить("date");
	КонецЕсли;
	Если Значения.Получить("sum") <> Неопределено Тогда
		sum = Значения.Получить("sum");
	КонецЕсли;
	Если Значения.Получить("type") <> Неопределено Тогда
		type = Значения.Получить("type");
	КонецЕсли;
	Если Значения.Получить("statusId") <> Неопределено Тогда
		statusId = Значения.Получить("statusId");
	КонецЕсли;
	Если Значения.Получить("cardStatus") <> Неопределено Тогда
		cardStatus = Значения.Получить("cardStatus");
	КонецЕсли;
	Если Значения.Получить("currency") <> Неопределено Тогда
		currency = Значения.Получить("currency");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Если date <> Неопределено Тогда
		Результат.Вставить("date", ЗначениеДляJSON(date));
	КонецЕсли;
	Если sum <> Неопределено Тогда
		Результат.Вставить("sum", ЗначениеДляJSON(sum));
	КонецЕсли;
	Если type <> Неопределено Тогда
		Результат.Вставить("type", ЗначениеДляJSON(type));
	КонецЕсли;
	Если statusId <> Неопределено Тогда
		Результат.Вставить("statusId", ЗначениеДляJSON(statusId));
	КонецЕсли;
	Если cardStatus <> Неопределено Тогда
		Результат.Вставить("cardStatus", ЗначениеДляJSON(cardStatus));
	КонецЕсли;
	Если currency <> Неопределено Тогда
		Результат.Вставить("currency", ЗначениеДляJSON(currency));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

