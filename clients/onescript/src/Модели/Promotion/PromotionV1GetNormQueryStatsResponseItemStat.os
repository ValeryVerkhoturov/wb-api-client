// PromotionV1GetNormQueryStatsResponseItemStat
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// normQuery - Строка - Поисковый кластер
Перем normQuery Экспорт;

// views - Число - Количество просмотров. Для кампаний с типом оплаты `cpc` — за клики — значение будет `null`
Перем views Экспорт;

// clicks - Число - Количество кликов
Перем clicks Экспорт;

// atbs - Число - Количество добавлений товаров в корзину
Перем atbs Экспорт;

// orders - Число - Количество заказов
Перем orders Экспорт;

// ctr - Число - CTR (click-through rate) — отношение числа кликов к количеству показов в процентах. Для кампаний с типом оплаты `cpc` — за клики — значение будет `null`
Перем ctr Экспорт;

// cpc - Число - Средняя стоимость клика в базовых единицах валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем cpc Экспорт;

// cpm - Число - Средняя стоимость за тысячу показов в базовых единицах валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances). Для кампаний с типом оплаты `c…
Перем cpm Экспорт;

// avgPos - Число - Средняя позиция товара на страницах поисковой выдачи
Перем avgPos Экспорт;

// shks - Число - Количество заказанных товаров, шт.
Перем shks Экспорт;

// spend - Число - Затраты на продвижение товаров в конкретном поисковом кластере кампании
Перем spend Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("normQuery") <> Неопределено Тогда
		normQuery = Значения.Получить("normQuery");
	КонецЕсли;
	Если Значения.Получить("views") <> Неопределено Тогда
		views = Значения.Получить("views");
	КонецЕсли;
	Если Значения.Получить("clicks") <> Неопределено Тогда
		clicks = Значения.Получить("clicks");
	КонецЕсли;
	Если Значения.Получить("atbs") <> Неопределено Тогда
		atbs = Значения.Получить("atbs");
	КонецЕсли;
	Если Значения.Получить("orders") <> Неопределено Тогда
		orders = Значения.Получить("orders");
	КонецЕсли;
	Если Значения.Получить("ctr") <> Неопределено Тогда
		ctr = Значения.Получить("ctr");
	КонецЕсли;
	Если Значения.Получить("cpc") <> Неопределено Тогда
		cpc = Значения.Получить("cpc");
	КонецЕсли;
	Если Значения.Получить("cpm") <> Неопределено Тогда
		cpm = Значения.Получить("cpm");
	КонецЕсли;
	Если Значения.Получить("avgPos") <> Неопределено Тогда
		avgPos = Значения.Получить("avgPos");
	КонецЕсли;
	Если Значения.Получить("shks") <> Неопределено Тогда
		shks = Значения.Получить("shks");
	КонецЕсли;
	Если Значения.Получить("spend") <> Неопределено Тогда
		spend = Значения.Получить("spend");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если normQuery <> Неопределено Тогда
		Результат.Вставить("normQuery", ЗначениеДляJSON(normQuery));
	КонецЕсли;
	Если views <> Неопределено Тогда
		Результат.Вставить("views", ЗначениеДляJSON(views));
	КонецЕсли;
	Если clicks <> Неопределено Тогда
		Результат.Вставить("clicks", ЗначениеДляJSON(clicks));
	КонецЕсли;
	Если atbs <> Неопределено Тогда
		Результат.Вставить("atbs", ЗначениеДляJSON(atbs));
	КонецЕсли;
	Если orders <> Неопределено Тогда
		Результат.Вставить("orders", ЗначениеДляJSON(orders));
	КонецЕсли;
	Если ctr <> Неопределено Тогда
		Результат.Вставить("ctr", ЗначениеДляJSON(ctr));
	КонецЕсли;
	Если cpc <> Неопределено Тогда
		Результат.Вставить("cpc", ЗначениеДляJSON(cpc));
	КонецЕсли;
	Если cpm <> Неопределено Тогда
		Результат.Вставить("cpm", ЗначениеДляJSON(cpm));
	КонецЕсли;
	Если avgPos <> Неопределено Тогда
		Результат.Вставить("avgPos", ЗначениеДляJSON(avgPos));
	КонецЕсли;
	Если shks <> Неопределено Тогда
		Результат.Вставить("shks", ЗначениеДляJSON(shks));
	КонецЕсли;
	Если spend <> Неопределено Тогда
		Результат.Вставить("spend", ЗначениеДляJSON(spend));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

