// PromotionFullStatsItem
//
// Статистика по одной кампании за период, указанный в запросе. По всем артикулам WB и платформам
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// advertId - Число - ID кампании
Перем advertId Экспорт;

// atbs - Число - Количество добавлений товаров в корзину
Перем atbs Экспорт;

// boosterStats - Массив - Статистика по средней позиции товара (для кампаний с единой ставкой)
Перем boosterStats Экспорт;

// canceled - Число - Отмены, шт.
Перем canceled Экспорт;

// clicks - Число - Количество кликов
Перем clicks Экспорт;

// cpc - Число - Средняя стоимость клика в базовых единицах валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем cpc Экспорт;

// cr - Число - CR (conversion rate) — отношение количества заказов к общему количеству кликов
Перем cr Экспорт;

// ctr - Число - CTR (click-through rate) — отношение числа кликов к количеству показов в процентах
Перем ctr Экспорт;

// days - Массив - Статистка по дням
Перем days Экспорт;

// orders - Число - Количество заказов
Перем orders Экспорт;

// shks - Число - Количество заказанных товаров, шт.
Перем shks Экспорт;

// sum - Число - Затраты в базовых единицах валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем sum Экспорт;

// sum_price - Число - Сумма заказов в базовых единицах валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем sum_price Экспорт;

// views - Число - Количество просмотров
Перем views Экспорт;

// currency - Строка - Валюта [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем currency Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("advertId") <> Неопределено Тогда
		advertId = Значения.Получить("advertId");
	КонецЕсли;
	Если Значения.Получить("atbs") <> Неопределено Тогда
		atbs = Значения.Получить("atbs");
	КонецЕсли;
	Если Значения.Получить("boosterStats") <> Неопределено Тогда
		boosterStats = Значения.Получить("boosterStats");
	КонецЕсли;
	Если Значения.Получить("canceled") <> Неопределено Тогда
		canceled = Значения.Получить("canceled");
	КонецЕсли;
	Если Значения.Получить("clicks") <> Неопределено Тогда
		clicks = Значения.Получить("clicks");
	КонецЕсли;
	Если Значения.Получить("cpc") <> Неопределено Тогда
		cpc = Значения.Получить("cpc");
	КонецЕсли;
	Если Значения.Получить("cr") <> Неопределено Тогда
		cr = Значения.Получить("cr");
	КонецЕсли;
	Если Значения.Получить("ctr") <> Неопределено Тогда
		ctr = Значения.Получить("ctr");
	КонецЕсли;
	Если Значения.Получить("days") <> Неопределено Тогда
		days = Значения.Получить("days");
	КонецЕсли;
	Если Значения.Получить("orders") <> Неопределено Тогда
		orders = Значения.Получить("orders");
	КонецЕсли;
	Если Значения.Получить("shks") <> Неопределено Тогда
		shks = Значения.Получить("shks");
	КонецЕсли;
	Если Значения.Получить("sum") <> Неопределено Тогда
		sum = Значения.Получить("sum");
	КонецЕсли;
	Если Значения.Получить("sum_price") <> Неопределено Тогда
		sum_price = Значения.Получить("sum_price");
	КонецЕсли;
	Если Значения.Получить("views") <> Неопределено Тогда
		views = Значения.Получить("views");
	КонецЕсли;
	Если Значения.Получить("currency") <> Неопределено Тогда
		currency = Значения.Получить("currency");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если advertId <> Неопределено Тогда
		Результат.Вставить("advertId", ЗначениеДляJSON(advertId));
	КонецЕсли;
	Если atbs <> Неопределено Тогда
		Результат.Вставить("atbs", ЗначениеДляJSON(atbs));
	КонецЕсли;
	Если boosterStats <> Неопределено Тогда
		Результат.Вставить("boosterStats", ЗначениеДляJSON(boosterStats));
	КонецЕсли;
	Если canceled <> Неопределено Тогда
		Результат.Вставить("canceled", ЗначениеДляJSON(canceled));
	КонецЕсли;
	Если clicks <> Неопределено Тогда
		Результат.Вставить("clicks", ЗначениеДляJSON(clicks));
	КонецЕсли;
	Если cpc <> Неопределено Тогда
		Результат.Вставить("cpc", ЗначениеДляJSON(cpc));
	КонецЕсли;
	Если cr <> Неопределено Тогда
		Результат.Вставить("cr", ЗначениеДляJSON(cr));
	КонецЕсли;
	Если ctr <> Неопределено Тогда
		Результат.Вставить("ctr", ЗначениеДляJSON(ctr));
	КонецЕсли;
	Если days <> Неопределено Тогда
		Результат.Вставить("days", ЗначениеДляJSON(days));
	КонецЕсли;
	Если orders <> Неопределено Тогда
		Результат.Вставить("orders", ЗначениеДляJSON(orders));
	КонецЕсли;
	Если shks <> Неопределено Тогда
		Результат.Вставить("shks", ЗначениеДляJSON(shks));
	КонецЕсли;
	Если sum <> Неопределено Тогда
		Результат.Вставить("sum", ЗначениеДляJSON(sum));
	КонецЕсли;
	Если sum_price <> Неопределено Тогда
		Результат.Вставить("sum_price", ЗначениеДляJSON(sum_price));
	КонецЕсли;
	Если views <> Неопределено Тогда
		Результат.Вставить("views", ЗначениеДляJSON(views));
	КонецЕсли;
	Если currency <> Неопределено Тогда
		Результат.Вставить("currency", ЗначениеДляJSON(currency));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

