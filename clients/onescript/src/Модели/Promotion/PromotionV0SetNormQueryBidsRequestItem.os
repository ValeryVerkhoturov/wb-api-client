// PromotionV0SetNormQueryBidsRequestItem
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// advert_id - Число - ID кампании
Перем advert_id Экспорт;

// nm_id - Число - Артикул WB
Перем nm_id Экспорт;

// norm_query - Строка - Поисковый кластер
Перем norm_query Экспорт;

// bid - Число - Ставка за тысячу показов в базовых единицах валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем bid Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("advert_id") <> Неопределено Тогда
		advert_id = Значения.Получить("advert_id");
	КонецЕсли;
	Если Значения.Получить("nm_id") <> Неопределено Тогда
		nm_id = Значения.Получить("nm_id");
	КонецЕсли;
	Если Значения.Получить("norm_query") <> Неопределено Тогда
		norm_query = Значения.Получить("norm_query");
	КонецЕсли;
	Если Значения.Получить("bid") <> Неопределено Тогда
		bid = Значения.Получить("bid");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если advert_id <> Неопределено Тогда
		Результат.Вставить("advert_id", ЗначениеДляJSON(advert_id));
	КонецЕсли;
	Если nm_id <> Неопределено Тогда
		Результат.Вставить("nm_id", ЗначениеДляJSON(nm_id));
	КонецЕсли;
	Если norm_query <> Неопределено Тогда
		Результат.Вставить("norm_query", ЗначениеДляJSON(norm_query));
	КонецЕсли;
	Если bid <> Неопределено Тогда
		Результат.Вставить("bid", ЗначениеДляJSON(bid));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

