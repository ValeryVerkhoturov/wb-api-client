// PromotionStatsBlok2
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// item_id - Число - ID баннера
Перем item_id Экспорт;

// item_name - Строка - Бренд
Перем item_name Экспорт;

// category_name - Строка - Название категории
Перем category_name Экспорт;

// advert_type - Число - Тип медиакампании: - `1` — размещение по дням - `2` — размещение по просмотрам
Перем advert_type Экспорт;

// place - Число - Место на странице
Перем place Экспорт;

// views - Число - Количество просмотров
Перем views Экспорт;

// clicks - Число - Количество кликов
Перем clicks Экспорт;

// cr - Число - CR(conversion rate) — это отношение количества заказов к общему количеству посещений медиакампании
Перем cr Экспорт;

// ctr - Число - CTR (click-through rate) — показатель кликабельности, отношение числа кликов к количеству показов в рамках медиакампании
Перем ctr Экспорт;

// date_from - Дата - Время начала размещения
Перем date_from Экспорт;

// date_to - Дата - Время завершения размещения
Перем date_to Экспорт;

// subject_name - Строка - Родительская категория предмета
Перем subject_name Экспорт;

// atbs - Число - Количество добавлений товаров в корзину
Перем atbs Экспорт;

// orders - Число - Количество заказов
Перем orders Экспорт;

// price - Число - Стоимость размещения
Перем price Экспорт;

// cpc - Число - (cost per click) — цена клика по продвигаемому товару
Перем cpc Экспорт;

// status - Число - Статус медиакампании
Перем status Экспорт;

// daily_stats - Массив
Перем daily_stats Экспорт;

// expenses - Число - Стоимость размещения баннера
Перем expenses Экспорт;

// cr1 - Число - Отношение количества добавлений в корзину к количеству кликов
Перем cr1 Экспорт;

// cr2 - Число - Отношение количества заказов к количеству добавлений в корзину
Перем cr2 Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("item_id") <> Неопределено Тогда
		item_id = Значения.Получить("item_id");
	КонецЕсли;
	Если Значения.Получить("item_name") <> Неопределено Тогда
		item_name = Значения.Получить("item_name");
	КонецЕсли;
	Если Значения.Получить("category_name") <> Неопределено Тогда
		category_name = Значения.Получить("category_name");
	КонецЕсли;
	Если Значения.Получить("advert_type") <> Неопределено Тогда
		advert_type = Значения.Получить("advert_type");
	КонецЕсли;
	Если Значения.Получить("place") <> Неопределено Тогда
		place = Значения.Получить("place");
	КонецЕсли;
	Если Значения.Получить("views") <> Неопределено Тогда
		views = Значения.Получить("views");
	КонецЕсли;
	Если Значения.Получить("clicks") <> Неопределено Тогда
		clicks = Значения.Получить("clicks");
	КонецЕсли;
	Если Значения.Получить("cr") <> Неопределено Тогда
		cr = Значения.Получить("cr");
	КонецЕсли;
	Если Значения.Получить("ctr") <> Неопределено Тогда
		ctr = Значения.Получить("ctr");
	КонецЕсли;
	Если Значения.Получить("date_from") <> Неопределено Тогда
		date_from = Значения.Получить("date_from");
	КонецЕсли;
	Если Значения.Получить("date_to") <> Неопределено Тогда
		date_to = Значения.Получить("date_to");
	КонецЕсли;
	Если Значения.Получить("subject_name") <> Неопределено Тогда
		subject_name = Значения.Получить("subject_name");
	КонецЕсли;
	Если Значения.Получить("atbs") <> Неопределено Тогда
		atbs = Значения.Получить("atbs");
	КонецЕсли;
	Если Значения.Получить("orders") <> Неопределено Тогда
		orders = Значения.Получить("orders");
	КонецЕсли;
	Если Значения.Получить("price") <> Неопределено Тогда
		price = Значения.Получить("price");
	КонецЕсли;
	Если Значения.Получить("cpc") <> Неопределено Тогда
		cpc = Значения.Получить("cpc");
	КонецЕсли;
	Если Значения.Получить("status") <> Неопределено Тогда
		status = Значения.Получить("status");
	КонецЕсли;
	Если Значения.Получить("daily_stats") <> Неопределено Тогда
		daily_stats = Значения.Получить("daily_stats");
	КонецЕсли;
	Если Значения.Получить("expenses") <> Неопределено Тогда
		expenses = Значения.Получить("expenses");
	КонецЕсли;
	Если Значения.Получить("cr1") <> Неопределено Тогда
		cr1 = Значения.Получить("cr1");
	КонецЕсли;
	Если Значения.Получить("cr2") <> Неопределено Тогда
		cr2 = Значения.Получить("cr2");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если item_id <> Неопределено Тогда
		Результат.Вставить("item_id", ЗначениеДляJSON(item_id));
	КонецЕсли;
	Если item_name <> Неопределено Тогда
		Результат.Вставить("item_name", ЗначениеДляJSON(item_name));
	КонецЕсли;
	Если category_name <> Неопределено Тогда
		Результат.Вставить("category_name", ЗначениеДляJSON(category_name));
	КонецЕсли;
	Если advert_type <> Неопределено Тогда
		Результат.Вставить("advert_type", ЗначениеДляJSON(advert_type));
	КонецЕсли;
	Если place <> Неопределено Тогда
		Результат.Вставить("place", ЗначениеДляJSON(place));
	КонецЕсли;
	Если views <> Неопределено Тогда
		Результат.Вставить("views", ЗначениеДляJSON(views));
	КонецЕсли;
	Если clicks <> Неопределено Тогда
		Результат.Вставить("clicks", ЗначениеДляJSON(clicks));
	КонецЕсли;
	Если cr <> Неопределено Тогда
		Результат.Вставить("cr", ЗначениеДляJSON(cr));
	КонецЕсли;
	Если ctr <> Неопределено Тогда
		Результат.Вставить("ctr", ЗначениеДляJSON(ctr));
	КонецЕсли;
	Если date_from <> Неопределено Тогда
		Результат.Вставить("date_from", ЗначениеДляJSON(date_from));
	КонецЕсли;
	Если date_to <> Неопределено Тогда
		Результат.Вставить("date_to", ЗначениеДляJSON(date_to));
	КонецЕсли;
	Если subject_name <> Неопределено Тогда
		Результат.Вставить("subject_name", ЗначениеДляJSON(subject_name));
	КонецЕсли;
	Если atbs <> Неопределено Тогда
		Результат.Вставить("atbs", ЗначениеДляJSON(atbs));
	КонецЕсли;
	Если orders <> Неопределено Тогда
		Результат.Вставить("orders", ЗначениеДляJSON(orders));
	КонецЕсли;
	Если price <> Неопределено Тогда
		Результат.Вставить("price", ЗначениеДляJSON(price));
	КонецЕсли;
	Если cpc <> Неопределено Тогда
		Результат.Вставить("cpc", ЗначениеДляJSON(cpc));
	КонецЕсли;
	Если status <> Неопределено Тогда
		Результат.Вставить("status", ЗначениеДляJSON(status));
	КонецЕсли;
	Если daily_stats <> Неопределено Тогда
		Результат.Вставить("daily_stats", ЗначениеДляJSON(daily_stats));
	КонецЕсли;
	Если expenses <> Неопределено Тогда
		Результат.Вставить("expenses", ЗначениеДляJSON(expenses));
	КонецЕсли;
	Если cr1 <> Неопределено Тогда
		Результат.Вставить("cr1", ЗначениеДляJSON(cr1));
	КонецЕсли;
	Если cr2 <> Неопределено Тогда
		Результат.Вставить("cr2", ЗначениеДляJSON(cr2));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

