// PromotionPostV2SeacatSaveAdRequest
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// name - Строка - Название кампании
Перем name Экспорт;

// nms - Массив - Карточки товаров для кампании. Доступные карточки товаров можно получить с помощью метода [Карточки товаров для кампаний](./promotion#tag/creatingCampaigns/oper…
Перем nms Экспорт;

// bid_type - Строка - Тип ставки: - `manual` — ручная - `unified` — единая
Перем bid_type Экспорт;

// payment_type - Строка - Тип оплаты: - `cpm` — за показы - `cpc` — за клик. При создании с этим типом оплаты в кампании автоматически устанавливается минимальная ставка
Перем payment_type Экспорт;

// placement_types - Массив - Места размещения: - `search` — в поиске - `recommendations` — в рекомендациях Укажите только для кампании с ручной ставкой
Перем placement_types Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("name") <> Неопределено Тогда
		name = Значения.Получить("name");
	КонецЕсли;
	Если Значения.Получить("nms") <> Неопределено Тогда
		nms = Значения.Получить("nms");
	КонецЕсли;
	Если Значения.Получить("bid_type") <> Неопределено Тогда
		bid_type = Значения.Получить("bid_type");
	КонецЕсли;
	Если Значения.Получить("payment_type") <> Неопределено Тогда
		payment_type = Значения.Получить("payment_type");
	КонецЕсли;
	Если Значения.Получить("placement_types") <> Неопределено Тогда
		placement_types = Значения.Получить("placement_types");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если name <> Неопределено Тогда
		Результат.Вставить("name", ЗначениеДляJSON(name));
	КонецЕсли;
	Если nms <> Неопределено Тогда
		Результат.Вставить("nms", ЗначениеДляJSON(nms));
	КонецЕсли;
	Если bid_type <> Неопределено Тогда
		Результат.Вставить("bid_type", ЗначениеДляJSON(bid_type));
	КонецЕсли;
	Если payment_type <> Неопределено Тогда
		Результат.Вставить("payment_type", ЗначениеДляJSON(payment_type));
	КонецЕсли;
	Если placement_types <> Неопределено Тогда
		Результат.Вставить("placement_types", ЗначениеДляJSON(placement_types));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

