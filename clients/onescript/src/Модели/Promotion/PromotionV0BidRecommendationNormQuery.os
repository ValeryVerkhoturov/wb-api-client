// PromotionV0BidRecommendationNormQuery
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// normQuery - Строка - Поисковый кластер
Перем normQuery Экспорт;

// reachMax - V0BidRecommendationReachMax
Перем reachMax Экспорт;

// reachMedium - V0BidRecommendationReachMedium
Перем reachMedium Экспорт;

// reachMin - V0BidRecommendationReachMin
Перем reachMin Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("normQuery") <> Неопределено Тогда
		normQuery = Значения.Получить("normQuery");
	КонецЕсли;
	Если Значения.Получить("reachMax") <> Неопределено Тогда
		reachMax = Значения.Получить("reachMax");
	КонецЕсли;
	Если Значения.Получить("reachMedium") <> Неопределено Тогда
		reachMedium = Значения.Получить("reachMedium");
	КонецЕсли;
	Если Значения.Получить("reachMin") <> Неопределено Тогда
		reachMin = Значения.Получить("reachMin");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если normQuery <> Неопределено Тогда
		Результат.Вставить("normQuery", ЗначениеДляJSON(normQuery));
	КонецЕсли;
	Если reachMax <> Неопределено Тогда
		Результат.Вставить("reachMax", ЗначениеДляJSON(reachMax));
	КонецЕсли;
	Если reachMedium <> Неопределено Тогда
		Результат.Вставить("reachMedium", ЗначениеДляJSON(reachMedium));
	КонецЕсли;
	Если reachMin <> Неопределено Тогда
		Результат.Вставить("reachMin", ЗначениеДляJSON(reachMin));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

