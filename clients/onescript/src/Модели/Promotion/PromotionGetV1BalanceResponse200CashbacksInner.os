// PromotionGetV1BalanceResponse200CashbacksInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// sum - Число - Промо-бонусы в базовых единицах валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем sum Экспорт;

// percent - Число - Процент от суммы пополнения бюджета кампании, который можно оплатить промо-бонусами за один раз
Перем percent Экспорт;

// expiration_date - Строка - Дата окончания действия промо-бонусов
Перем expiration_date Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("sum") <> Неопределено Тогда
		sum = Значения.Получить("sum");
	КонецЕсли;
	Если Значения.Получить("percent") <> Неопределено Тогда
		percent = Значения.Получить("percent");
	КонецЕсли;
	Если Значения.Получить("expiration_date") <> Неопределено Тогда
		expiration_date = Значения.Получить("expiration_date");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если sum <> Неопределено Тогда
		Результат.Вставить("sum", ЗначениеДляJSON(sum));
	КонецЕсли;
	Если percent <> Неопределено Тогда
		Результат.Вставить("percent", ЗначениеДляJSON(percent));
	КонецЕсли;
	Если expiration_date <> Неопределено Тогда
		Результат.Вставить("expiration_date", ЗначениеДляJSON(expiration_date));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

