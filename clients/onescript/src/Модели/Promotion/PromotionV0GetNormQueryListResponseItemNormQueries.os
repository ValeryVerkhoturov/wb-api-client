// PromotionV0GetNormQueryListResponseItemNormQueries
//
// Поисковые кластеры
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// active - Массив - Активные поисковые кластеры
Перем active Экспорт;

// excluded - Массив - Неактивные поисковые кластеры
Перем excluded Экспорт;

// archived - Массив - Архивные поисковые кластеры
Перем archived Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("active") <> Неопределено Тогда
		active = Значения.Получить("active");
	КонецЕсли;
	Если Значения.Получить("excluded") <> Неопределено Тогда
		excluded = Значения.Получить("excluded");
	КонецЕсли;
	Если Значения.Получить("archived") <> Неопределено Тогда
		archived = Значения.Получить("archived");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если active <> Неопределено Тогда
		Результат.Вставить("active", ЗначениеДляJSON(active));
	КонецЕсли;
	Если excluded <> Неопределено Тогда
		Результат.Вставить("excluded", ЗначениеДляJSON(excluded));
	КонецЕсли;
	Если archived <> Неопределено Тогда
		Результат.Вставить("archived", ЗначениеДляJSON(archived));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

