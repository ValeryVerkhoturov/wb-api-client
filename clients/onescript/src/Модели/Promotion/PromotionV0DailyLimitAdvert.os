// PromotionV0DailyLimitAdvert
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// advertId - Число - ID кампании
Перем advertId Экспорт;

// enabled - Булево - - `true` — дневной лимит включен - `false` — дневной лимит отключен
Перем enabled Экспорт;

// dailyLimit - Число - Размер дневного лимита в разменных единицах — 0,01 от базовой валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем dailyLimit Экспорт;

// spentToday - Число - Потрачено сегодня в разменных единицах — 0,01 от базовой валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем spentToday Экспорт;

// currency - Строка - Код валюты
Перем currency Экспорт;

// carryOverEnabled - Булево - Перенос остатка дневного лимита на следующий день. Если за 24 часа лимит потратится не полностью, добавим остаток суммы к лимиту следующего дня. Расходы на прод…
Перем carryOverEnabled Экспорт;

// valid - Булево - Хватает ли текущего размера лимита на установку ставок кампании: - `true` — да - `false` — нет, рекомендуем повысить лимит, иначе бюджет кампании может расходов…
Перем valid Экспорт;

// requiredLimit - Число - Рекомендуемый минимальный размер дневного лимита при текущих ставках кампании. Указывается в разменных единицах — 0,01 от базовой валюты [аккаунта продавца](htt…
Перем requiredLimit Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("advertId") <> Неопределено Тогда
		advertId = Значения.Получить("advertId");
	КонецЕсли;
	Если Значения.Получить("enabled") <> Неопределено Тогда
		enabled = Значения.Получить("enabled");
	КонецЕсли;
	Если Значения.Получить("dailyLimit") <> Неопределено Тогда
		dailyLimit = Значения.Получить("dailyLimit");
	КонецЕсли;
	Если Значения.Получить("spentToday") <> Неопределено Тогда
		spentToday = Значения.Получить("spentToday");
	КонецЕсли;
	Если Значения.Получить("currency") <> Неопределено Тогда
		currency = Значения.Получить("currency");
	КонецЕсли;
	Если Значения.Получить("carryOverEnabled") <> Неопределено Тогда
		carryOverEnabled = Значения.Получить("carryOverEnabled");
	КонецЕсли;
	Если Значения.Получить("valid") <> Неопределено Тогда
		valid = Значения.Получить("valid");
	КонецЕсли;
	Если Значения.Получить("requiredLimit") <> Неопределено Тогда
		requiredLimit = Значения.Получить("requiredLimit");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если advertId <> Неопределено Тогда
		Результат.Вставить("advertId", ЗначениеДляJSON(advertId));
	КонецЕсли;
	Если enabled <> Неопределено Тогда
		Результат.Вставить("enabled", ЗначениеДляJSON(enabled));
	КонецЕсли;
	Если dailyLimit <> Неопределено Тогда
		Результат.Вставить("dailyLimit", ЗначениеДляJSON(dailyLimit));
	КонецЕсли;
	Если spentToday <> Неопределено Тогда
		Результат.Вставить("spentToday", ЗначениеДляJSON(spentToday));
	КонецЕсли;
	Если currency <> Неопределено Тогда
		Результат.Вставить("currency", ЗначениеДляJSON(currency));
	КонецЕсли;
	Если carryOverEnabled <> Неопределено Тогда
		Результат.Вставить("carryOverEnabled", ЗначениеДляJSON(carryOverEnabled));
	КонецЕсли;
	Если valid <> Неопределено Тогда
		Результат.Вставить("valid", ЗначениеДляJSON(valid));
	КонецЕсли;
	Если requiredLimit <> Неопределено Тогда
		Результат.Вставить("requiredLimit", ЗначениеДляJSON(requiredLimit));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

