// PromotionGetV1AdvertResponse200Extended
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// reason - Строка - Комментарий модератора
Перем reason Экспорт;

// expenses - Число - Затраты
Перем expenses Экспорт;

// from - Дата - Дата и время начала показа медиакампании
Перем from Экспорт;

// to - Дата - Дата и время окончания показа медиакампании
Перем _to Экспорт;

// updated_at - Дата - Дата и время изменения кампании
Перем updated_at Экспорт;

// price - Число - Стоимость размещения по дням для типа `1`
Перем price Экспорт;

// budget - Число - Остаток бюджета для типа `2`
Перем budget Экспорт;

// operation - Число - Источник списания: - `1` — баланс - `2` — счёт
Перем operation Экспорт;

// contract_id - Число - ID контракта, для продавцов на контракте
Перем contract_id Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("reason") <> Неопределено Тогда
		reason = Значения.Получить("reason");
	КонецЕсли;
	Если Значения.Получить("expenses") <> Неопределено Тогда
		expenses = Значения.Получить("expenses");
	КонецЕсли;
	Если Значения.Получить("from") <> Неопределено Тогда
		from = Значения.Получить("from");
	КонецЕсли;
	Если Значения.Получить("to") <> Неопределено Тогда
		_to = Значения.Получить("to");
	КонецЕсли;
	Если Значения.Получить("updated_at") <> Неопределено Тогда
		updated_at = Значения.Получить("updated_at");
	КонецЕсли;
	Если Значения.Получить("price") <> Неопределено Тогда
		price = Значения.Получить("price");
	КонецЕсли;
	Если Значения.Получить("budget") <> Неопределено Тогда
		budget = Значения.Получить("budget");
	КонецЕсли;
	Если Значения.Получить("operation") <> Неопределено Тогда
		operation = Значения.Получить("operation");
	КонецЕсли;
	Если Значения.Получить("contract_id") <> Неопределено Тогда
		contract_id = Значения.Получить("contract_id");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если reason <> Неопределено Тогда
		Результат.Вставить("reason", ЗначениеДляJSON(reason));
	КонецЕсли;
	Если expenses <> Неопределено Тогда
		Результат.Вставить("expenses", ЗначениеДляJSON(expenses));
	КонецЕсли;
	Если from <> Неопределено Тогда
		Результат.Вставить("from", ЗначениеДляJSON(from));
	КонецЕсли;
	Если _to <> Неопределено Тогда
		Результат.Вставить("to", ЗначениеДляJSON(_to));
	КонецЕсли;
	Если updated_at <> Неопределено Тогда
		Результат.Вставить("updated_at", ЗначениеДляJSON(updated_at));
	КонецЕсли;
	Если price <> Неопределено Тогда
		Результат.Вставить("price", ЗначениеДляJSON(price));
	КонецЕсли;
	Если budget <> Неопределено Тогда
		Результат.Вставить("budget", ЗначениеДляJSON(budget));
	КонецЕсли;
	Если operation <> Неопределено Тогда
		Результат.Вставить("operation", ЗначениеДляJSON(operation));
	КонецЕсли;
	Если contract_id <> Неопределено Тогда
		Результат.Вставить("contract_id", ЗначениеДляJSON(contract_id));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

