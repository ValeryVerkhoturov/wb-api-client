// PromotionTimestamps
//
// Временные отметки
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// created - Дата - Время создания кампании
Перем created Экспорт;

// updated - Дата - Время последнего изменения кампании
Перем updated Экспорт;

// started - Дата - Время последнего запуска кампании
Перем started Экспорт;

// deleted - Дата - Время удаления кампании. Если кампания не удалена, время указывается в будущем
Перем deleted Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("created") <> Неопределено Тогда
		created = Значения.Получить("created");
	КонецЕсли;
	Если Значения.Получить("updated") <> Неопределено Тогда
		updated = Значения.Получить("updated");
	КонецЕсли;
	Если Значения.Получить("started") <> Неопределено Тогда
		started = Значения.Получить("started");
	КонецЕсли;
	Если Значения.Получить("deleted") <> Неопределено Тогда
		deleted = Значения.Получить("deleted");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если created <> Неопределено Тогда
		Результат.Вставить("created", ЗначениеДляJSON(created));
	КонецЕсли;
	Если updated <> Неопределено Тогда
		Результат.Вставить("updated", ЗначениеДляJSON(updated));
	КонецЕсли;
	Если started <> Неопределено Тогда
		Результат.Вставить("started", ЗначениеДляJSON(started));
	КонецЕсли;
	Если deleted <> Неопределено Тогда
		Результат.Вставить("deleted", ЗначениеДляJSON(deleted));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

