// PromotionPatchV1BidsRequestBidsInnerNmBidsInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// nm_id - Число - Артикул WB
Перем nm_id Экспорт;

// bid_kopecks - Число - Ставка в разменных единицах — 0,01 от базовой валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем bid_kopecks Экспорт;

// placement - Строка - Место размещения: - `search` — в поиске (для кампаний с ручной ставкой) - `recommendations`— в рекомендациях (для кампаний с ручной ставкой) - `combined` — в по…
Перем placement Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("nm_id") <> Неопределено Тогда
		nm_id = Значения.Получить("nm_id");
	КонецЕсли;
	Если Значения.Получить("bid_kopecks") <> Неопределено Тогда
		bid_kopecks = Значения.Получить("bid_kopecks");
	КонецЕсли;
	Если Значения.Получить("placement") <> Неопределено Тогда
		placement = Значения.Получить("placement");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если nm_id <> Неопределено Тогда
		Результат.Вставить("nm_id", ЗначениеДляJSON(nm_id));
	КонецЕсли;
	Если bid_kopecks <> Неопределено Тогда
		Результат.Вставить("bid_kopecks", ЗначениеДляJSON(bid_kopecks));
	КонецЕсли;
	Если placement <> Неопределено Тогда
		Результат.Вставить("placement", ЗначениеДляJSON(placement));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

