Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если type <> Неопределено Тогда
		Результат.Вставить("type", ЗначениеДляJSON(type));
	КонецЕсли;
	Если status <> Неопределено Тогда
		Результат.Вставить("status", ЗначениеДляJSON(status));
	КонецЕсли;
	Если count <> Неопределено Тогда
		Результат.Вставить("count", ЗначениеДляJSON(count));
