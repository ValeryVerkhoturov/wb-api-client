// PromotionGetV1AdvertResponse200
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// advertId - Число - ID медиакампании
Перем advertId Экспорт;

// name - Строка - Название медиакампании
Перем name Экспорт;

// brand - Строка - Название бренда
Перем brand Экспорт;

// type - Число - Тип медиакампании: - `1` — размещение по дням - `2` — размещение по просмотрам
Перем type Экспорт;

// status - Число - Статус медиакампании: - `1` — черновик - `2` — модерация - `3` — отклонена (с возможностью вернуть на модерацию) - `4` — готова к запуску - `5` — запланирована…
Перем status Экспорт;

// createTime - Дата - Время создания медиакампании
Перем createTime Экспорт;

// extended - GetV1AdvertResponse200_extended
Перем extended Экспорт;

// items - Массив - Информация о баннере. Наличие в ответе тех или иных полей зависит от конфигурации медиакампании.
Перем items Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("advertId") <> Неопределено Тогда
		advertId = Значения.Получить("advertId");
	КонецЕсли;
	Если Значения.Получить("name") <> Неопределено Тогда
		name = Значения.Получить("name");
	КонецЕсли;
	Если Значения.Получить("brand") <> Неопределено Тогда
		brand = Значения.Получить("brand");
	КонецЕсли;
	Если Значения.Получить("type") <> Неопределено Тогда
		type = Значения.Получить("type");
	КонецЕсли;
	Если Значения.Получить("status") <> Неопределено Тогда
		status = Значения.Получить("status");
	КонецЕсли;
	Если Значения.Получить("createTime") <> Неопределено Тогда
		createTime = Значения.Получить("createTime");
	КонецЕсли;
	Если Значения.Получить("extended") <> Неопределено Тогда
		extended = Значения.Получить("extended");
	КонецЕсли;
	Если Значения.Получить("items") <> Неопределено Тогда
		items = Значения.Получить("items");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если advertId <> Неопределено Тогда
		Результат.Вставить("advertId", ЗначениеДляJSON(advertId));
	КонецЕсли;
	Если name <> Неопределено Тогда
		Результат.Вставить("name", ЗначениеДляJSON(name));
	КонецЕсли;
	Если brand <> Неопределено Тогда
		Результат.Вставить("brand", ЗначениеДляJSON(brand));
	КонецЕсли;
	Если type <> Неопределено Тогда
		Результат.Вставить("type", ЗначениеДляJSON(type));
	КонецЕсли;
	Если status <> Неопределено Тогда
		Результат.Вставить("status", ЗначениеДляJSON(status));
	КонецЕсли;
	Если createTime <> Неопределено Тогда
		Результат.Вставить("createTime", ЗначениеДляJSON(createTime));
	КонецЕсли;
	Если extended <> Неопределено Тогда
		Результат.Вставить("extended", ЗначениеДляJSON(extended));
	КонецЕсли;
	Если items <> Неопределено Тогда
		Результат.Вставить("items", ЗначениеДляJSON(items));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

