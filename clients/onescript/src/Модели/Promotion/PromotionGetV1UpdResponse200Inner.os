// PromotionGetV1UpdResponse200Inner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// updNum - Число - Номер выставленного документа
Перем updNum Экспорт;

// updTime - Строка - Время списания
Перем updTime Экспорт;

// updSum - Число - Выставленная сумма в базовых единицах валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем updSum Экспорт;

// advertId - Число - ID кампании
Перем advertId Экспорт;

// campName - Строка - Название кампании
Перем campName Экспорт;

// advertType - Число - Тип кампании
Перем advertType Экспорт;

// paymentType - Строка - Источник списания: - `Баланс` - `Бонусы` - `Счёт` - `Кэшбэк`
Перем paymentType Экспорт;

// advertStatus - Число - Статус кампании: - `-1` — удалена, процесс удаления будет завершён в течение 10 минут - `4` — готова к запуску - `7` — завершена - `8` — отменена - `9` — активн…
Перем advertStatus Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("updNum") <> Неопределено Тогда
		updNum = Значения.Получить("updNum");
	КонецЕсли;
	Если Значения.Получить("updTime") <> Неопределено Тогда
		updTime = Значения.Получить("updTime");
	КонецЕсли;
	Если Значения.Получить("updSum") <> Неопределено Тогда
		updSum = Значения.Получить("updSum");
	КонецЕсли;
	Если Значения.Получить("advertId") <> Неопределено Тогда
		advertId = Значения.Получить("advertId");
	КонецЕсли;
	Если Значения.Получить("campName") <> Неопределено Тогда
		campName = Значения.Получить("campName");
	КонецЕсли;
	Если Значения.Получить("advertType") <> Неопределено Тогда
		advertType = Значения.Получить("advertType");
	КонецЕсли;
	Если Значения.Получить("paymentType") <> Неопределено Тогда
		paymentType = Значения.Получить("paymentType");
	КонецЕсли;
	Если Значения.Получить("advertStatus") <> Неопределено Тогда
		advertStatus = Значения.Получить("advertStatus");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если updNum <> Неопределено Тогда
		Результат.Вставить("updNum", ЗначениеДляJSON(updNum));
	КонецЕсли;
	Если updTime <> Неопределено Тогда
		Результат.Вставить("updTime", ЗначениеДляJSON(updTime));
	КонецЕсли;
	Если updSum <> Неопределено Тогда
		Результат.Вставить("updSum", ЗначениеДляJSON(updSum));
	КонецЕсли;
	Если advertId <> Неопределено Тогда
		Результат.Вставить("advertId", ЗначениеДляJSON(advertId));
	КонецЕсли;
	Если campName <> Неопределено Тогда
		Результат.Вставить("campName", ЗначениеДляJSON(campName));
	КонецЕсли;
	Если advertType <> Неопределено Тогда
		Результат.Вставить("advertType", ЗначениеДляJSON(advertType));
	КонецЕсли;
	Если paymentType <> Неопределено Тогда
		Результат.Вставить("paymentType", ЗначениеДляJSON(paymentType));
	КонецЕсли;
	Если advertStatus <> Неопределено Тогда
		Результат.Вставить("advertStatus", ЗначениеДляJSON(advertStatus));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

