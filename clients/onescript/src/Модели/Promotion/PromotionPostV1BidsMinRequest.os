// PromotionPostV1BidsMinRequest
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// advert_id - Число - ID кампании
Перем advert_id Экспорт;

// nm_ids - Массив - Список артикулов WB
Перем nm_ids Экспорт;

// payment_type - Строка - Тип оплаты: - `cpm` — за показы - `cpc` — за клик
Перем payment_type Экспорт;

// placement_types - Массив - Места размещения: - `search` — поиск - `recommendation` — рекомендации - `combined` — поиск и рекомендации
Перем placement_types Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("advert_id") <> Неопределено Тогда
		advert_id = Значения.Получить("advert_id");
	КонецЕсли;
	Если Значения.Получить("nm_ids") <> Неопределено Тогда
		nm_ids = Значения.Получить("nm_ids");
	КонецЕсли;
	Если Значения.Получить("payment_type") <> Неопределено Тогда
		payment_type = Значения.Получить("payment_type");
	КонецЕсли;
	Если Значения.Получить("placement_types") <> Неопределено Тогда
		placement_types = Значения.Получить("placement_types");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если advert_id <> Неопределено Тогда
		Результат.Вставить("advert_id", ЗначениеДляJSON(advert_id));
	КонецЕсли;
	Если nm_ids <> Неопределено Тогда
		Результат.Вставить("nm_ids", ЗначениеДляJSON(nm_ids));
	КонецЕсли;
	Если payment_type <> Неопределено Тогда
		Результат.Вставить("payment_type", ЗначениеДляJSON(payment_type));
	КонецЕсли;
	Если placement_types <> Неопределено Тогда
		Результат.Вставить("placement_types", ЗначениеДляJSON(placement_types));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

