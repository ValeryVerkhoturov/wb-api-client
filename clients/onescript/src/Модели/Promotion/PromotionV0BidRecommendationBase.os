// PromotionV0BidRecommendationBase
//
// Рекомендуемые ставки для карточек товаров
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// competitiveBid - V0BidRecommendationBaseBidCompetitiveBid
Перем competitiveBid Экспорт;

// leadersBid - V0BidRecommendationBaseBidLeadersBid
Перем leadersBid Экспорт;

// top2 - V0BidRecommendationBaseBidTop2
Перем top2 Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("competitiveBid") <> Неопределено Тогда
		competitiveBid = Значения.Получить("competitiveBid");
	КонецЕсли;
	Если Значения.Получить("leadersBid") <> Неопределено Тогда
		leadersBid = Значения.Получить("leadersBid");
	КонецЕсли;
	Если Значения.Получить("top2") <> Неопределено Тогда
		top2 = Значения.Получить("top2");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если competitiveBid <> Неопределено Тогда
		Результат.Вставить("competitiveBid", ЗначениеДляJSON(competitiveBid));
	КонецЕсли;
	Если leadersBid <> Неопределено Тогда
		Результат.Вставить("leadersBid", ЗначениеДляJSON(leadersBid));
	КонецЕсли;
	Если top2 <> Неопределено Тогда
		Результат.Вставить("top2", ЗначениеДляJSON(top2));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

