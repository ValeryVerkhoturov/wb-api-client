// PromotionV1SetNormQueryBidsRequestItem
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// advertId - Число - ID кампании
Перем advertId Экспорт;

// nmId - Число - Артикул WB
Перем nmId Экспорт;

// normQuery - Строка - Поисковый кластер
Перем normQuery Экспорт;

// bidMinorUnits - Число - Ставка в разменных единицах — 0,01 от базовой валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances). Допустимый шаг ставки указан в ответе м…
Перем bidMinorUnits Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("advertId") <> Неопределено Тогда
		advertId = Значения.Получить("advertId");
	КонецЕсли;
	Если Значения.Получить("nmId") <> Неопределено Тогда
		nmId = Значения.Получить("nmId");
	КонецЕсли;
	Если Значения.Получить("normQuery") <> Неопределено Тогда
		normQuery = Значения.Получить("normQuery");
	КонецЕсли;
	Если Значения.Получить("bidMinorUnits") <> Неопределено Тогда
		bidMinorUnits = Значения.Получить("bidMinorUnits");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если advertId <> Неопределено Тогда
		Результат.Вставить("advertId", ЗначениеДляJSON(advertId));
	КонецЕсли;
	Если nmId <> Неопределено Тогда
		Результат.Вставить("nmId", ЗначениеДляJSON(nmId));
	КонецЕсли;
	Если normQuery <> Неопределено Тогда
		Результат.Вставить("normQuery", ЗначениеДляJSON(normQuery));
	КонецЕсли;
	Если bidMinorUnits <> Неопределено Тогда
		Результат.Вставить("bidMinorUnits", ЗначениеДляJSON(bidMinorUnits));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

