// PromotionV2GetConfigResponse
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// currency - Строка - Валюта [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем currency Экспорт;

// currencyCode - Число - Код валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances)
Перем currencyCode Экспорт;

// cpmStep - Число - Шаг ставки в разменных единицах — 0,01 от базовой валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances) для CPM-кампаний
Перем cpmStep Экспорт;

// cpcStep - Число - Шаг ставки в разменных единицах — 0,01 от базовой валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances) для кампаний CPC
Перем cpcStep Экспорт;

// minTopUp - Число - Минимальная сумма пополнения бюджета кампании в разменных единицах — 0,01 от базовой валюты [аккаунта продавца](https://cmp.wildberries.ru/campaigns/finances).…
Перем minTopUp Экспорт;

// minDailyLimit - Число - Минимально допустимый размер дневного лимита, вне зависимости от ставок кампании. Указывается в разменных единицах — 0,01 от базовой валюты [аккаунта продавца](…
Перем minDailyLimit Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("currency") <> Неопределено Тогда
		currency = Значения.Получить("currency");
	КонецЕсли;
	Если Значения.Получить("currencyCode") <> Неопределено Тогда
		currencyCode = Значения.Получить("currencyCode");
	КонецЕсли;
	Если Значения.Получить("cpmStep") <> Неопределено Тогда
		cpmStep = Значения.Получить("cpmStep");
	КонецЕсли;
	Если Значения.Получить("cpcStep") <> Неопределено Тогда
		cpcStep = Значения.Получить("cpcStep");
	КонецЕсли;
	Если Значения.Получить("minTopUp") <> Неопределено Тогда
		minTopUp = Значения.Получить("minTopUp");
	КонецЕсли;
	Если Значения.Получить("minDailyLimit") <> Неопределено Тогда
		minDailyLimit = Значения.Получить("minDailyLimit");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если currency <> Неопределено Тогда
		Результат.Вставить("currency", ЗначениеДляJSON(currency));
	КонецЕсли;
	Если currencyCode <> Неопределено Тогда
		Результат.Вставить("currencyCode", ЗначениеДляJSON(currencyCode));
	КонецЕсли;
	Если cpmStep <> Неопределено Тогда
		Результат.Вставить("cpmStep", ЗначениеДляJSON(cpmStep));
	КонецЕсли;
	Если cpcStep <> Неопределено Тогда
		Результат.Вставить("cpcStep", ЗначениеДляJSON(cpcStep));
	КонецЕсли;
	Если minTopUp <> Неопределено Тогда
		Результат.Вставить("minTopUp", ЗначениеДляJSON(minTopUp));
	КонецЕсли;
	Если minDailyLimit <> Неопределено Тогда
		Результат.Вставить("minDailyLimit", ЗначениеДляJSON(minDailyLimit));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

