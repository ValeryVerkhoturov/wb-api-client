// PromotionPromoItemsList
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// id - Число - Артикул WB
Перем id Экспорт;

// inAction - Булево - Участвует в акции: - `true` — да - `false` — нет
Перем inAction Экспорт;

// price - Число - Текущая розничная цена
Перем price Экспорт;

// currencyCode - Строка - Валюта в формате ISO 4217
Перем currencyCode Экспорт;

// planPrice - Число - Плановая цена (цена во время акции)
Перем planPrice Экспорт;

// discount - Число - Текущая скидка
Перем discount Экспорт;

// planDiscount - Число - Рекомендуемая скидка для участия в акции
Перем planDiscount Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("id") <> Неопределено Тогда
		id = Значения.Получить("id");
	КонецЕсли;
	Если Значения.Получить("inAction") <> Неопределено Тогда
		inAction = Значения.Получить("inAction");
	КонецЕсли;
	Если Значения.Получить("price") <> Неопределено Тогда
		price = Значения.Получить("price");
	КонецЕсли;
	Если Значения.Получить("currencyCode") <> Неопределено Тогда
		currencyCode = Значения.Получить("currencyCode");
	КонецЕсли;
	Если Значения.Получить("planPrice") <> Неопределено Тогда
		planPrice = Значения.Получить("planPrice");
	КонецЕсли;
	Если Значения.Получить("discount") <> Неопределено Тогда
		discount = Значения.Получить("discount");
	КонецЕсли;
	Если Значения.Получить("planDiscount") <> Неопределено Тогда
		planDiscount = Значения.Получить("planDiscount");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Если inAction <> Неопределено Тогда
		Результат.Вставить("inAction", ЗначениеДляJSON(inAction));
	КонецЕсли;
	Если price <> Неопределено Тогда
		Результат.Вставить("price", ЗначениеДляJSON(price));
	КонецЕсли;
	Если currencyCode <> Неопределено Тогда
		Результат.Вставить("currencyCode", ЗначениеДляJSON(currencyCode));
	КонецЕсли;
	Если planPrice <> Неопределено Тогда
		Результат.Вставить("planPrice", ЗначениеДляJSON(planPrice));
	КонецЕсли;
	Если discount <> Неопределено Тогда
		Результат.Вставить("discount", ЗначениеДляJSON(discount));
	КонецЕсли;
	Если planDiscount <> Неопределено Тогда
		Результат.Вставить("planDiscount", ЗначениеДляJSON(planDiscount));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

