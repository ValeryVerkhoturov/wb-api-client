// PromotionFullStatsError
//
// Ошибка
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// errors - Массив
Перем errors Экспорт;

// detail - Строка - Детали ошибки
Перем detail Экспорт;

// origin - Строка - ID внутреннего сервиса WB
Перем origin Экспорт;

// request_id - Строка - ID запроса
Перем request_id Экспорт;

// status - Число - HTTP статус-код
Перем status Экспорт;

// title - Строка - Заголовок ошибки
Перем title Экспорт;

// type - Строка - Тип ошибки
Перем type Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("errors") <> Неопределено Тогда
		errors = Значения.Получить("errors");
	КонецЕсли;
	Если Значения.Получить("detail") <> Неопределено Тогда
		detail = Значения.Получить("detail");
	КонецЕсли;
	Если Значения.Получить("origin") <> Неопределено Тогда
		origin = Значения.Получить("origin");
	КонецЕсли;
	Если Значения.Получить("request_id") <> Неопределено Тогда
		request_id = Значения.Получить("request_id");
	КонецЕсли;
	Если Значения.Получить("status") <> Неопределено Тогда
		status = Значения.Получить("status");
	КонецЕсли;
	Если Значения.Получить("title") <> Неопределено Тогда
		title = Значения.Получить("title");
	КонецЕсли;
	Если Значения.Получить("type") <> Неопределено Тогда
		type = Значения.Получить("type");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если errors <> Неопределено Тогда
		Результат.Вставить("errors", ЗначениеДляJSON(errors));
	КонецЕсли;
	Если detail <> Неопределено Тогда
		Результат.Вставить("detail", ЗначениеДляJSON(detail));
	КонецЕсли;
	Если origin <> Неопределено Тогда
		Результат.Вставить("origin", ЗначениеДляJSON(origin));
	КонецЕсли;
	Если request_id <> Неопределено Тогда
		Результат.Вставить("request_id", ЗначениеДляJSON(request_id));
	КонецЕсли;
	Если status <> Неопределено Тогда
		Результат.Вставить("status", ЗначениеДляJSON(status));
	КонецЕсли;
	Если title <> Неопределено Тогда
		Результат.Вставить("title", ЗначениеДляJSON(title));
	КонецЕсли;
	Если type <> Неопределено Тогда
		Результат.Вставить("type", ЗначениеДляJSON(type));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

