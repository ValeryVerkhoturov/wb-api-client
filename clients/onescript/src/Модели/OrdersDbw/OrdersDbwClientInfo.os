// OrdersDbwClientInfo
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// replacementPhone - Строка - Подменный номер для связи с покупателем. Пустое значение `\"\"` указывает, что номер ещё не назначен
Перем replacementPhone Экспорт;

// phone - Строка - Номер телефона для связи с покупателем: - если в поле `phoneCode` не указан добавочный код, вы можете позвонить покупателю по указанному номеру. Дополнительные…
Перем phone Экспорт;

// firstName - Строка - Имя покупателя
Перем firstName Экспорт;

// fullName - Строка - Полное имя покупателя, используется для оформления документов
Перем fullName Экспорт;

// additionalPhones - Массив - Дополнительные номера телефонов для связи с покупателем. Используйте, чтобы позвонить покупателю, если недоступен основной номер из `phone`. Пустое значение озн…
Перем additionalPhones Экспорт;

// additionalPhoneCodes - Массив - Дополнительные добавочные коды. Используйте, если не получилось дозвониться по добавочному коду из `phoneCode`. Пустое значение указывает, коды ещё не назначены
Перем additionalPhoneCodes Экспорт;

// orderId - Число - ID сборочного задания
Перем orderId Экспорт;

// phoneCode - Число - Добавочный код. Используйте, чтобы связаться с покупателем по номеру из `phone`. Если код не указан, вы можете связаться с покупателем без кода
Перем phoneCode Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("replacementPhone") <> Неопределено Тогда
		replacementPhone = Значения.Получить("replacementPhone");
	КонецЕсли;
	Если Значения.Получить("phone") <> Неопределено Тогда
		phone = Значения.Получить("phone");
	КонецЕсли;
	Если Значения.Получить("firstName") <> Неопределено Тогда
		firstName = Значения.Получить("firstName");
	КонецЕсли;
	Если Значения.Получить("fullName") <> Неопределено Тогда
		fullName = Значения.Получить("fullName");
	КонецЕсли;
	Если Значения.Получить("additionalPhones") <> Неопределено Тогда
		additionalPhones = Значения.Получить("additionalPhones");
	КонецЕсли;
	Если Значения.Получить("additionalPhoneCodes") <> Неопределено Тогда
		additionalPhoneCodes = Значения.Получить("additionalPhoneCodes");
	КонецЕсли;
	Если Значения.Получить("orderId") <> Неопределено Тогда
		orderId = Значения.Получить("orderId");
	КонецЕсли;
	Если Значения.Получить("phoneCode") <> Неопределено Тогда
		phoneCode = Значения.Получить("phoneCode");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если replacementPhone <> Неопределено Тогда
		Результат.Вставить("replacementPhone", ЗначениеДляJSON(replacementPhone));
	КонецЕсли;
	Если phone <> Неопределено Тогда
		Результат.Вставить("phone", ЗначениеДляJSON(phone));
	КонецЕсли;
	Если firstName <> Неопределено Тогда
		Результат.Вставить("firstName", ЗначениеДляJSON(firstName));
	КонецЕсли;
	Если fullName <> Неопределено Тогда
		Результат.Вставить("fullName", ЗначениеДляJSON(fullName));
	КонецЕсли;
	Если additionalPhones <> Неопределено Тогда
		Результат.Вставить("additionalPhones", ЗначениеДляJSON(additionalPhones));
	КонецЕсли;
	Если additionalPhoneCodes <> Неопределено Тогда
		Результат.Вставить("additionalPhoneCodes", ЗначениеДляJSON(additionalPhoneCodes));
	КонецЕсли;
	Если orderId <> Неопределено Тогда
		Результат.Вставить("orderId", ЗначениеДляJSON(orderId));
	КонецЕсли;
	Если phoneCode <> Неопределено Тогда
		Результат.Вставить("phoneCode", ЗначениеДляJSON(phoneCode));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

