// OrdersDbwPostV3DbwOrdersStickersResponse200StickersInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// orderId - Число - ID сборочного задания
Перем orderId Экспорт;

// partA - Строка - Первая часть ID стикера для печати подписи
Перем partA Экспорт;

// partB - Строка - Вторая часть ID стикера для печати подписи
Перем partB Экспорт;

// barcode - Строка - Закодированное значение стикера
Перем barcode Экспорт;

// file - Строка - Полное представление стикера в заданном формате (кодировка base64)
Перем file Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("orderId") <> Неопределено Тогда
		orderId = Значения.Получить("orderId");
	КонецЕсли;
	Если Значения.Получить("partA") <> Неопределено Тогда
		partA = Значения.Получить("partA");
	КонецЕсли;
	Если Значения.Получить("partB") <> Неопределено Тогда
		partB = Значения.Получить("partB");
	КонецЕсли;
	Если Значения.Получить("barcode") <> Неопределено Тогда
		barcode = Значения.Получить("barcode");
	КонецЕсли;
	Если Значения.Получить("file") <> Неопределено Тогда
		file = Значения.Получить("file");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если orderId <> Неопределено Тогда
		Результат.Вставить("orderId", ЗначениеДляJSON(orderId));
	КонецЕсли;
	Если partA <> Неопределено Тогда
		Результат.Вставить("partA", ЗначениеДляJSON(partA));
	КонецЕсли;
	Если partB <> Неопределено Тогда
		Результат.Вставить("partB", ЗначениеДляJSON(partB));
	КонецЕсли;
	Если barcode <> Неопределено Тогда
		Результат.Вставить("barcode", ЗначениеДляJSON(barcode));
	КонецЕсли;
	Если file <> Неопределено Тогда
		Результат.Вставить("file", ЗначениеДляJSON(file));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

