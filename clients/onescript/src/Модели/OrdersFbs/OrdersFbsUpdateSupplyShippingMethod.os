// OrdersFbsUpdateSupplyShippingMethod
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// shippingDt - Строка - Планируемая дата отгрузки поставки, формат `YYYY-MM-DD`
Перем shippingDt Экспорт;

// shippingPointId - Число - ID пункта отгрузки. Можно получить с помощью [отдельного метода](./orders-fbs#tag/fbsSupplies/operation/getV3FbsShippingPoints)
Перем shippingPointId Экспорт;

// shippingType - Строка - Способ доставки до пункта отгрузки: - `selfShipping` — доставка силами продавца - `transportCompany` — доставка через транспортную компанию. Для этого способа о…
Перем shippingType Экспорт;

// supplyId - Строка - ID поставки
Перем supplyId Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("shippingDt") <> Неопределено Тогда
		shippingDt = Значения.Получить("shippingDt");
	КонецЕсли;
	Если Значения.Получить("shippingPointId") <> Неопределено Тогда
		shippingPointId = Значения.Получить("shippingPointId");
	КонецЕсли;
	Если Значения.Получить("shippingType") <> Неопределено Тогда
		shippingType = Значения.Получить("shippingType");
	КонецЕсли;
	Если Значения.Получить("supplyId") <> Неопределено Тогда
		supplyId = Значения.Получить("supplyId");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если shippingDt <> Неопределено Тогда
		Результат.Вставить("shippingDt", ЗначениеДляJSON(shippingDt));
	КонецЕсли;
	Если shippingPointId <> Неопределено Тогда
		Результат.Вставить("shippingPointId", ЗначениеДляJSON(shippingPointId));
	КонецЕсли;
	Если shippingType <> Неопределено Тогда
		Результат.Вставить("shippingType", ЗначениеДляJSON(shippingType));
	КонецЕсли;
	Если supplyId <> Неопределено Тогда
		Результат.Вставить("supplyId", ЗначениеДляJSON(supplyId));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

