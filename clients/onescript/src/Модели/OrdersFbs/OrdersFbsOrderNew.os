// address - Order_address
Перем address Экспорт;

// ddate - Строка - Планируемая дата доставки заказа покупателю. Поле отображается для сборочных заданий со сверхгабаритными товарами `СГТ`, `cargoType: 2`
Перем ddate Экспорт;

// sellerDate - Строка - Рекомендуемая дата доставки СГТ в сортировочный центр или на склад. Поле отображается для сборочных заданий со сверхгабаритными товарами `СГТ`, `cargoType: 2`
Перем sellerDate Экспорт;

// salePrice - Число - Цена продавца в валюте продажи с учётом скидки продавца, без учёта скидки WB Клуба, умноженная на 100. Предоставляется в информационных целях
Перем salePrice Экспорт;

// requiredMeta - Массив - Список идентификаторов маркировки, которые [необходимо добавить](https://dev.wildberries.ru/knowledge-base/articles/019e9273-118b-7b69-a25a-ea1d756f05d9/rabota-…
Перем requiredMeta Экспорт;

// optionalMeta - Массив - Список идентификаторов маркировки, которые [можно добавить](https://dev.wildberries.ru/knowledge-base/articles/019e9273-118b-7b69-a25a-ea1d756f05d9/rabota-s-mar…
Перем optionalMeta Экспорт;

// deliveryType - Строка - Тип доставки: - `fbs` — доставка на склад Wildberries (FBS)
Перем deliveryType Экспорт;

// comment - Строка - Комментарий покупателя
Перем comment Экспорт;

