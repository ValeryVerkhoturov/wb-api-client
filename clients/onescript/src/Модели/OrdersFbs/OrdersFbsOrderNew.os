	Если salePrice <> Неопределено Тогда
		Результат.Вставить("salePrice", ЗначениеДляJSON(salePrice));
	КонецЕсли;
	Если requiredMeta <> Неопределено Тогда
		Результат.Вставить("requiredMeta", ЗначениеДляJSON(requiredMeta));
	КонецЕсли;
	Если optionalMeta <> Неопределено Тогда
		Результат.Вставить("optionalMeta", ЗначениеДляJSON(optionalMeta));
	КонецЕсли;
	Если deliveryType <> Неопределено Тогда
		Результат.Вставить("deliveryType", ЗначениеДляJSON(deliveryType));
	КонецЕсли;
	Если comment <> Неопределено Тогда
		Результат.Вставить("comment", ЗначениеДляJSON(comment));
	КонецЕсли;
	Если scanPrice <> Неопределено Тогда
		Результат.Вставить("scanPrice", ЗначениеДляJSON(scanPrice));
	КонецЕсли;
	Если orderUid <> Неопределено Тогда
		Результат.Вставить("orderUid", ЗначениеДляJSON(orderUid));
	КонецЕсли;
	Если article <> Неопределено Тогда
		Результат.Вставить("article", ЗначениеДляJSON(article));
	КонецЕсли;
	Если colorCode <> Неопределено Тогда
		Результат.Вставить("colorCode", ЗначениеДляJSON(colorCode));
	КонецЕсли;
	Если rid <> Неопределено Тогда
		Результат.Вставить("rid", ЗначениеДляJSON(rid));
	КонецЕсли;
	Если createdAt <> Неопределено Тогда
		Результат.Вставить("createdAt", ЗначениеДляJSON(createdAt));
	КонецЕсли;
	Если offices <> Неопределено Тогда
		Результат.Вставить("offices", ЗначениеДляJSON(offices));
	КонецЕсли;
	Если skus <> Неопределено Тогда
		Результат.Вставить("skus", ЗначениеДляJSON(skus));
	КонецЕсли;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Если warehouseId <> Неопределено Тогда
		Результат.Вставить("warehouseId", ЗначениеДляJSON(warehouseId));
	КонецЕсли;
	Если officeId <> Неопределено Тогда
		Результат.Вставить("officeId", ЗначениеДляJSON(officeId));
	КонецЕсли;
	Если nmId <> Неопределено Тогда
		Результат.Вставить("nmId", ЗначениеДляJSON(nmId));
	КонецЕсли;
