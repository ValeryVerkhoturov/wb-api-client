// OrdersFbsSupply
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// id - Строка - ID поставки
Перем id Экспорт;

// isB2b - Булево - Признак B2B-продажи: - `true` — B2B-продажа - `false` — не B2B-продажа - `null` — признак отсутствует, сборочные задания не добавлены к поставке
Перем isB2b Экспорт;

// isPickupPointShipmentAllowed - Булево - Можно ли отгрузить заказ на ПВЗ: - `false` — нет - `true` — да
Перем isPickupPointShipmentAllowed Экспорт;

// done - Булево - Флаг закрытия поставки: - `true` — закрыта - `false` — открыта
Перем done Экспорт;

// createdAt - Дата - Дата создания поставки (RFC3339)
Перем createdAt Экспорт;

// closedAt - Дата - Дата закрытия поставки (RFC3339)
Перем closedAt Экспорт;

// scanDt - Дата - Дата сканирования поставки или первого заказа (RFC3339)
Перем scanDt Экспорт;

// name - Строка - Наименование поставки
Перем name Экспорт;

// cargoType - Число - Тип товара: - `1` — малогабаритный товар (МГТ) - `2` — сверхгабаритный товар (СГТ) - `3` — крупногабаритный товар (КГТ+)
Перем cargoType Экспорт;

// crossBorderType - Число - Тип поставки: - `0` — внутренняя поставка - `1` — трансграничная поставка - `null` — значение отсутствует
Перем crossBorderType Экспорт;

// destinationOfficeId - Число - ID склада хранения сборочных заданий в поставке. Если `null`, склад не указан
Перем destinationOfficeId Экспорт;

// recommendedWhId - Число - ID рекомендуемого склада для приёмки поставки для Москвы и МО. Рекомендуется ближайший к покупателям склад, который определяется автоматически при передаче пост…
Перем recommendedWhId Экспорт;

// shippingDt - Строка - Планируемая дата отгрузки поставки, формат `YYYY-MM-DD`
Перем shippingDt Экспорт;

// shippingPointId - Число - ID пункта отгрузки. Можно получить в методе получения [пунктов отгрузки поставок](./orders-fbs#tag/fbsSupplies/operation/getV3FbsShippingPoints)
Перем shippingPointId Экспорт;

// shippingType - Строка - Способ доставки до пункта отгрузки: - `selfShipping` — доставка силами продавца - `transportCompany` — доставка через транспортную компанию. Для этого способа о…
Перем shippingType Экспорт;

// waybillUuid - Строка - ID ЭТрН — электронной транспортной накладной. Обязателен при `\"shippingType\":\"transportCompany\"`
Перем waybillUuid Экспорт;

// spotAvailable - Булево - Доступен ли СПОТ для этой поставки: - `true` — да. Используйте метод [получения данных СПОТ](./orders-fbs#tag/fbsSupplies/operation/postV3FbsSuppliesSpotList) -…
Перем spotAvailable Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("id") <> Неопределено Тогда
		id = Значения.Получить("id");
	КонецЕсли;
	Если Значения.Получить("isB2b") <> Неопределено Тогда
		isB2b = Значения.Получить("isB2b");
	КонецЕсли;
	Если Значения.Получить("isPickupPointShipmentAllowed") <> Неопределено Тогда
		isPickupPointShipmentAllowed = Значения.Получить("isPickupPointShipmentAllowed");
	КонецЕсли;
	Если Значения.Получить("done") <> Неопределено Тогда
		done = Значения.Получить("done");
	КонецЕсли;
	Если Значения.Получить("createdAt") <> Неопределено Тогда
		createdAt = Значения.Получить("createdAt");
	КонецЕсли;
	Если Значения.Получить("closedAt") <> Неопределено Тогда
		closedAt = Значения.Получить("closedAt");
	КонецЕсли;
	Если Значения.Получить("scanDt") <> Неопределено Тогда
		scanDt = Значения.Получить("scanDt");
	КонецЕсли;
	Если Значения.Получить("name") <> Неопределено Тогда
		name = Значения.Получить("name");
	КонецЕсли;
	Если Значения.Получить("cargoType") <> Неопределено Тогда
		cargoType = Значения.Получить("cargoType");
	КонецЕсли;
	Если Значения.Получить("crossBorderType") <> Неопределено Тогда
		crossBorderType = Значения.Получить("crossBorderType");
	КонецЕсли;
	Если Значения.Получить("destinationOfficeId") <> Неопределено Тогда
		destinationOfficeId = Значения.Получить("destinationOfficeId");
	КонецЕсли;
	Если Значения.Получить("recommendedWhId") <> Неопределено Тогда
		recommendedWhId = Значения.Получить("recommendedWhId");
	КонецЕсли;
	Если Значения.Получить("shippingDt") <> Неопределено Тогда
		shippingDt = Значения.Получить("shippingDt");
	КонецЕсли;
	Если Значения.Получить("shippingPointId") <> Неопределено Тогда
		shippingPointId = Значения.Получить("shippingPointId");
	КонецЕсли;
	Если Значения.Получить("shippingType") <> Неопределено Тогда
		shippingType = Значения.Получить("shippingType");
	КонецЕсли;
	Если Значения.Получить("waybillUuid") <> Неопределено Тогда
		waybillUuid = Значения.Получить("waybillUuid");
	КонецЕсли;
	Если Значения.Получить("spotAvailable") <> Неопределено Тогда
		spotAvailable = Значения.Получить("spotAvailable");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Если isB2b <> Неопределено Тогда
		Результат.Вставить("isB2b", ЗначениеДляJSON(isB2b));
	КонецЕсли;
	Если isPickupPointShipmentAllowed <> Неопределено Тогда
		Результат.Вставить("isPickupPointShipmentAllowed", ЗначениеДляJSON(isPickupPointShipmentAllowed));
	КонецЕсли;
	Если done <> Неопределено Тогда
		Результат.Вставить("done", ЗначениеДляJSON(done));
	КонецЕсли;
	Если createdAt <> Неопределено Тогда
		Результат.Вставить("createdAt", ЗначениеДляJSON(createdAt));
	КонецЕсли;
	Если closedAt <> Неопределено Тогда
		Результат.Вставить("closedAt", ЗначениеДляJSON(closedAt));
	КонецЕсли;
	Если scanDt <> Неопределено Тогда
		Результат.Вставить("scanDt", ЗначениеДляJSON(scanDt));
	КонецЕсли;
	Если name <> Неопределено Тогда
		Результат.Вставить("name", ЗначениеДляJSON(name));
	КонецЕсли;
	Если cargoType <> Неопределено Тогда
		Результат.Вставить("cargoType", ЗначениеДляJSON(cargoType));
	КонецЕсли;
	Если crossBorderType <> Неопределено Тогда
		Результат.Вставить("crossBorderType", ЗначениеДляJSON(crossBorderType));
	КонецЕсли;
	Если destinationOfficeId <> Неопределено Тогда
		Результат.Вставить("destinationOfficeId", ЗначениеДляJSON(destinationOfficeId));
	КонецЕсли;
	Если recommendedWhId <> Неопределено Тогда
		Результат.Вставить("recommendedWhId", ЗначениеДляJSON(recommendedWhId));
	КонецЕсли;
	Если shippingDt <> Неопределено Тогда
		Результат.Вставить("shippingDt", ЗначениеДляJSON(shippingDt));
	КонецЕсли;
	Если shippingPointId <> Неопределено Тогда
		Результат.Вставить("shippingPointId", ЗначениеДляJSON(shippingPointId));
	КонецЕсли;
	Если shippingType <> Неопределено Тогда
		Результат.Вставить("shippingType", ЗначениеДляJSON(shippingType));
	КонецЕсли;
	Если waybillUuid <> Неопределено Тогда
		Результат.Вставить("waybillUuid", ЗначениеДляJSON(waybillUuid));
	КонецЕсли;
	Если spotAvailable <> Неопределено Тогда
		Результат.Вставить("spotAvailable", ЗначениеДляJSON(spotAvailable));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

