// OrdersFbsSupplySpotData
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// status - Строка - Статус СПОТ: - `pending` — ожидается результат формирования ДОПП — документа о предстоящей поставке - `completed` — ДОПП успешно сформирован. Можно [получить QR…
Перем status Экспорт;

// carrierName - Строка - Наименование перевозчика
Перем carrierName Экспорт;

// carrierTaxNumber - Строка - ИНН перевозчика
Перем carrierTaxNumber Экспорт;

// carrierCountryCode - Строка - Код страны перевозчика по [ОКСМ](./orders-fbs#tag/fbsSupplies/operation/getV3FbsDictionariesCountriesOksm)
Перем carrierCountryCode Экспорт;

// vehicleRegistrationNumber - Строка - Регистрационный номер транспортного средства
Перем vehicleRegistrationNumber Экспорт;

// trailerRegistrationNumber - Строка - Регистрационный номер прицепа
Перем trailerRegistrationNumber Экспорт;

// errorCode - Строка - Код ошибки от сервиса формирования ДОПП — документа о предстоящей поставке. Возвращается при `\"status\": \"failed\"`. Чтобы исправить ошибку, проверьте данные…
Перем errorCode Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("status") <> Неопределено Тогда
		status = Значения.Получить("status");
	КонецЕсли;
	Если Значения.Получить("carrierName") <> Неопределено Тогда
		carrierName = Значения.Получить("carrierName");
	КонецЕсли;
	Если Значения.Получить("carrierTaxNumber") <> Неопределено Тогда
		carrierTaxNumber = Значения.Получить("carrierTaxNumber");
	КонецЕсли;
	Если Значения.Получить("carrierCountryCode") <> Неопределено Тогда
		carrierCountryCode = Значения.Получить("carrierCountryCode");
	КонецЕсли;
	Если Значения.Получить("vehicleRegistrationNumber") <> Неопределено Тогда
		vehicleRegistrationNumber = Значения.Получить("vehicleRegistrationNumber");
	КонецЕсли;
	Если Значения.Получить("trailerRegistrationNumber") <> Неопределено Тогда
		trailerRegistrationNumber = Значения.Получить("trailerRegistrationNumber");
	КонецЕсли;
	Если Значения.Получить("errorCode") <> Неопределено Тогда
		errorCode = Значения.Получить("errorCode");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если status <> Неопределено Тогда
		Результат.Вставить("status", ЗначениеДляJSON(status));
	КонецЕсли;
	Если carrierName <> Неопределено Тогда
		Результат.Вставить("carrierName", ЗначениеДляJSON(carrierName));
	КонецЕсли;
	Если carrierTaxNumber <> Неопределено Тогда
		Результат.Вставить("carrierTaxNumber", ЗначениеДляJSON(carrierTaxNumber));
	КонецЕсли;
	Если carrierCountryCode <> Неопределено Тогда
		Результат.Вставить("carrierCountryCode", ЗначениеДляJSON(carrierCountryCode));
	КонецЕсли;
	Если vehicleRegistrationNumber <> Неопределено Тогда
		Результат.Вставить("vehicleRegistrationNumber", ЗначениеДляJSON(vehicleRegistrationNumber));
	КонецЕсли;
	Если trailerRegistrationNumber <> Неопределено Тогда
		Результат.Вставить("trailerRegistrationNumber", ЗначениеДляJSON(trailerRegistrationNumber));
	КонецЕсли;
	Если errorCode <> Неопределено Тогда
		Результат.Вставить("errorCode", ЗначениеДляJSON(errorCode));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

