// OrdersFbsPass
//
// Данные о пропуске продавца
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// firstName - Строка - Имя водителя
Перем firstName Экспорт;

// dateEnd - Строка - Дата окончания действия пропуска
Перем dateEnd Экспорт;

// lastName - Строка - Фамилия водителя
Перем lastName Экспорт;

// carModel - Строка - Марка машины
Перем carModel Экспорт;

// carNumber - Строка - Номер машины
Перем carNumber Экспорт;

// officeName - Строка - Название склада
Перем officeName Экспорт;

// officeAddress - Строка - Адрес склада
Перем officeAddress Экспорт;

// officeId - Число - ID склада
Перем officeId Экспорт;

// id - Число - ID пропуска
Перем id Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("firstName") <> Неопределено Тогда
		firstName = Значения.Получить("firstName");
	КонецЕсли;
	Если Значения.Получить("dateEnd") <> Неопределено Тогда
		dateEnd = Значения.Получить("dateEnd");
	КонецЕсли;
	Если Значения.Получить("lastName") <> Неопределено Тогда
		lastName = Значения.Получить("lastName");
	КонецЕсли;
	Если Значения.Получить("carModel") <> Неопределено Тогда
		carModel = Значения.Получить("carModel");
	КонецЕсли;
	Если Значения.Получить("carNumber") <> Неопределено Тогда
		carNumber = Значения.Получить("carNumber");
	КонецЕсли;
	Если Значения.Получить("officeName") <> Неопределено Тогда
		officeName = Значения.Получить("officeName");
	КонецЕсли;
	Если Значения.Получить("officeAddress") <> Неопределено Тогда
		officeAddress = Значения.Получить("officeAddress");
	КонецЕсли;
	Если Значения.Получить("officeId") <> Неопределено Тогда
		officeId = Значения.Получить("officeId");
	КонецЕсли;
	Если Значения.Получить("id") <> Неопределено Тогда
		id = Значения.Получить("id");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если firstName <> Неопределено Тогда
		Результат.Вставить("firstName", ЗначениеДляJSON(firstName));
	КонецЕсли;
	Если dateEnd <> Неопределено Тогда
		Результат.Вставить("dateEnd", ЗначениеДляJSON(dateEnd));
	КонецЕсли;
	Если lastName <> Неопределено Тогда
		Результат.Вставить("lastName", ЗначениеДляJSON(lastName));
	КонецЕсли;
	Если carModel <> Неопределено Тогда
		Результат.Вставить("carModel", ЗначениеДляJSON(carModel));
	КонецЕсли;
	Если carNumber <> Неопределено Тогда
		Результат.Вставить("carNumber", ЗначениеДляJSON(carNumber));
	КонецЕсли;
	Если officeName <> Неопределено Тогда
		Результат.Вставить("officeName", ЗначениеДляJSON(officeName));
	КонецЕсли;
	Если officeAddress <> Неопределено Тогда
		Результат.Вставить("officeAddress", ЗначениеДляJSON(officeAddress));
	КонецЕсли;
	Если officeId <> Неопределено Тогда
		Результат.Вставить("officeId", ЗначениеДляJSON(officeId));
	КонецЕсли;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

