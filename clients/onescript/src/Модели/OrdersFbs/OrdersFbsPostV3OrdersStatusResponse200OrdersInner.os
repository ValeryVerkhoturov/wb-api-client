//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Если isCancellable <> Неопределено Тогда
		Результат.Вставить("isCancellable", ЗначениеДляJSON(isCancellable));
	КонецЕсли;
	Если supplierStatus <> Неопределено Тогда
		Результат.Вставить("supplierStatus", ЗначениеДляJSON(supplierStatus));
	КонецЕсли;
	Если wbStatus <> Неопределено Тогда
		Результат.Вставить("wbStatus", ЗначениеДляJSON(wbStatus));
	КонецЕсли;
	Возврат Результат;

