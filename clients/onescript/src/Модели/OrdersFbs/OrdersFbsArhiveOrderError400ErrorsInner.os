// OrdersFbsArhiveOrderError400ErrorsInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// location - Строка - Параметр, где произошла ошибка
Перем location Экспорт;

// message - Строка - Текст ошибки
Перем message Экспорт;

// value - Произвольный - Значение параметра, где произошла ошибка
Перем value Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("location") <> Неопределено Тогда
		location = Значения.Получить("location");
	КонецЕсли;
	Если Значения.Получить("message") <> Неопределено Тогда
		message = Значения.Получить("message");
	КонецЕсли;
	Если Значения.Получить("value") <> Неопределено Тогда
		value = Значения.Получить("value");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если location <> Неопределено Тогда
		Результат.Вставить("location", ЗначениеДляJSON(location));
	КонецЕсли;
	Если message <> Неопределено Тогда
		Результат.Вставить("message", ЗначениеДляJSON(message));
	КонецЕсли;
	Если value <> Неопределено Тогда
		Результат.Вставить("value", ЗначениеДляJSON(value));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

