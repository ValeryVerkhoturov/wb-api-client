// OrdersFbsV3ArchiveOrder
//
// Архивное сборочное задание
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// cargoType - Строка - Тип товара: - `mgt` — малогабаритный товар (МГТ) - `sgt` — сверхгабаритный товар (СГТ) - `kgtPlus` — крупногабаритный товар (КГТ+)
Перем cargoType Экспорт;

// colorCode - Строка - Код цвета для колеруемых товаров
Перем colorCode Экспорт;

// createdAt - Строка - Дата создания заказа
Перем createdAt Экспорт;

// crossBorder - v3_ArchiveOrder_crossBorder
Перем crossBorder Экспорт;

// crossBorderType - Строка - Тип сборочного задания: - `local` — внутренняя поставка - `crossBorder` — трансграничная поставка
Перем crossBorderType Экспорт;

// id - Число - ID сборочного задания
Перем id Экспорт;

// isZeroOrder - Булево - Признак заказа товара с нулевым остатком: - `false` — заказ сделан на товар с ненулевым остатком - `true` — заказ сделан на товар с нулевым остатком
Перем isZeroOrder Экспорт;

// metaDetails - Массив - Детали маркировки
Перем metaDetails Экспорт;

// options - v3_ArchiveOrder_options
Перем options Экспорт;

// orderUid - Строка - ID транзакции для группировки сборочных заданий. Сборочные задания в одной корзине покупателя будут иметь одинаковый `orderUid`
Перем orderUid Экспорт;

// priceInfo - v3_ArchiveOrder_priceInfo
Перем priceInfo Экспорт;

// product - v3_ArchiveOrder_product
Перем product Экспорт;

// rid - Строка - Уникальный ID заказа. Примечание: `rid` — это `srid` в ответах методов: - [Заявки покупателей на возврат](./customer-communication#tag/buyersReturns/operation/g…
Перем rid Экспорт;

// scanPrice - Число - Цена приёмки заказа в копейках
Перем scanPrice Экспорт;

// status - v3_ArchiveOrder_status
Перем status Экспорт;

// stickerId - Число - ID стикера
Перем stickerId Экспорт;

// supplyId - Строка - ID поставки
Перем supplyId Экспорт;

// warehouseId - Число - ID склада продавца, с которого был отгружен товар
Перем warehouseId Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("cargoType") <> Неопределено Тогда
		cargoType = Значения.Получить("cargoType");
	КонецЕсли;
	Если Значения.Получить("colorCode") <> Неопределено Тогда
		colorCode = Значения.Получить("colorCode");
	КонецЕсли;
	Если Значения.Получить("createdAt") <> Неопределено Тогда
		createdAt = Значения.Получить("createdAt");
	КонецЕсли;
	Если Значения.Получить("crossBorder") <> Неопределено Тогда
		crossBorder = Значения.Получить("crossBorder");
	КонецЕсли;
	Если Значения.Получить("crossBorderType") <> Неопределено Тогда
		crossBorderType = Значения.Получить("crossBorderType");
	КонецЕсли;
	Если Значения.Получить("id") <> Неопределено Тогда
		id = Значения.Получить("id");
	КонецЕсли;
	Если Значения.Получить("isZeroOrder") <> Неопределено Тогда
		isZeroOrder = Значения.Получить("isZeroOrder");
	КонецЕсли;
	Если Значения.Получить("metaDetails") <> Неопределено Тогда
		metaDetails = Значения.Получить("metaDetails");
	КонецЕсли;
	Если Значения.Получить("options") <> Неопределено Тогда
		options = Значения.Получить("options");
	КонецЕсли;
	Если Значения.Получить("orderUid") <> Неопределено Тогда
		orderUid = Значения.Получить("orderUid");
	КонецЕсли;
	Если Значения.Получить("priceInfo") <> Неопределено Тогда
		priceInfo = Значения.Получить("priceInfo");
	КонецЕсли;
	Если Значения.Получить("product") <> Неопределено Тогда
		product = Значения.Получить("product");
	КонецЕсли;
	Если Значения.Получить("rid") <> Неопределено Тогда
		rid = Значения.Получить("rid");
	КонецЕсли;
	Если Значения.Получить("scanPrice") <> Неопределено Тогда
		scanPrice = Значения.Получить("scanPrice");
	КонецЕсли;
	Если Значения.Получить("status") <> Неопределено Тогда
		status = Значения.Получить("status");
	КонецЕсли;
	Если Значения.Получить("stickerId") <> Неопределено Тогда
		stickerId = Значения.Получить("stickerId");
	КонецЕсли;
	Если Значения.Получить("supplyId") <> Неопределено Тогда
		supplyId = Значения.Получить("supplyId");
	КонецЕсли;
	Если Значения.Получить("warehouseId") <> Неопределено Тогда
		warehouseId = Значения.Получить("warehouseId");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если cargoType <> Неопределено Тогда
		Результат.Вставить("cargoType", ЗначениеДляJSON(cargoType));
	КонецЕсли;
	Если colorCode <> Неопределено Тогда
		Результат.Вставить("colorCode", ЗначениеДляJSON(colorCode));
	КонецЕсли;
	Если createdAt <> Неопределено Тогда
		Результат.Вставить("createdAt", ЗначениеДляJSON(createdAt));
	КонецЕсли;
	Если crossBorder <> Неопределено Тогда
		Результат.Вставить("crossBorder", ЗначениеДляJSON(crossBorder));
	КонецЕсли;
	Если crossBorderType <> Неопределено Тогда
		Результат.Вставить("crossBorderType", ЗначениеДляJSON(crossBorderType));
	КонецЕсли;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Если isZeroOrder <> Неопределено Тогда
		Результат.Вставить("isZeroOrder", ЗначениеДляJSON(isZeroOrder));
	КонецЕсли;
	Если metaDetails <> Неопределено Тогда
		Результат.Вставить("metaDetails", ЗначениеДляJSON(metaDetails));
	КонецЕсли;
	Если options <> Неопределено Тогда
		Результат.Вставить("options", ЗначениеДляJSON(options));
	КонецЕсли;
	Если orderUid <> Неопределено Тогда
		Результат.Вставить("orderUid", ЗначениеДляJSON(orderUid));
	КонецЕсли;
	Если priceInfo <> Неопределено Тогда
		Результат.Вставить("priceInfo", ЗначениеДляJSON(priceInfo));
	КонецЕсли;
	Если product <> Неопределено Тогда
		Результат.Вставить("product", ЗначениеДляJSON(product));
	КонецЕсли;
	Если rid <> Неопределено Тогда
		Результат.Вставить("rid", ЗначениеДляJSON(rid));
	КонецЕсли;
	Если scanPrice <> Неопределено Тогда
		Результат.Вставить("scanPrice", ЗначениеДляJSON(scanPrice));
	КонецЕсли;
	Если status <> Неопределено Тогда
		Результат.Вставить("status", ЗначениеДляJSON(status));
	КонецЕсли;
	Если stickerId <> Неопределено Тогда
		Результат.Вставить("stickerId", ЗначениеДляJSON(stickerId));
	КонецЕсли;
	Если supplyId <> Неопределено Тогда
		Результат.Вставить("supplyId", ЗначениеДляJSON(supplyId));
	КонецЕсли;
	Если warehouseId <> Неопределено Тогда
		Результат.Вставить("warehouseId", ЗначениеДляJSON(warehouseId));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

