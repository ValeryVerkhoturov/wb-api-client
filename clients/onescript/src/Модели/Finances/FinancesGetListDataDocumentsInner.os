// FinancesGetListDataDocumentsInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// serviceName - Строка - Уникальный ID документа
Перем serviceName Экспорт;

// name - Строка - Название документа
Перем name Экспорт;

// category - Строка - Название [категории документов](./documents-and-accounting#tag/documents/operation/getV1DocumentsCategories) из поля ответа `title`
Перем category Экспорт;

// extensions - Массив - Форматы документа
Перем extensions Экспорт;

// creationTime - Строка - Дата и время создания документа
Перем creationTime Экспорт;

// viewed - Булево - Выгружен ли документ в личном кабинете
Перем viewed Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("serviceName") <> Неопределено Тогда
		serviceName = Значения.Получить("serviceName");
	КонецЕсли;
	Если Значения.Получить("name") <> Неопределено Тогда
		name = Значения.Получить("name");
	КонецЕсли;
	Если Значения.Получить("category") <> Неопределено Тогда
		category = Значения.Получить("category");
	КонецЕсли;
	Если Значения.Получить("extensions") <> Неопределено Тогда
		extensions = Значения.Получить("extensions");
	КонецЕсли;
	Если Значения.Получить("creationTime") <> Неопределено Тогда
		creationTime = Значения.Получить("creationTime");
	КонецЕсли;
	Если Значения.Получить("viewed") <> Неопределено Тогда
		viewed = Значения.Получить("viewed");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если serviceName <> Неопределено Тогда
		Результат.Вставить("serviceName", ЗначениеДляJSON(serviceName));
	КонецЕсли;
	Если name <> Неопределено Тогда
		Результат.Вставить("name", ЗначениеДляJSON(name));
	КонецЕсли;
	Если category <> Неопределено Тогда
		Результат.Вставить("category", ЗначениеДляJSON(category));
	КонецЕсли;
	Если extensions <> Неопределено Тогда
		Результат.Вставить("extensions", ЗначениеДляJSON(extensions));
	КонецЕсли;
	Если creationTime <> Неопределено Тогда
		Результат.Вставить("creationTime", ЗначениеДляJSON(creationTime));
	КонецЕсли;
	Если viewed <> Неопределено Тогда
		Результат.Вставить("viewed", ЗначениеДляJSON(viewed));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

