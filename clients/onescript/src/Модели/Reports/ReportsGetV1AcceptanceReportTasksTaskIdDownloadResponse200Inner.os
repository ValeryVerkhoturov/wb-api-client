// ReportsGetV1AcceptanceReportTasksTaskIdDownloadResponse200Inner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// count - Число - Количество товаров, шт.
Перем count Экспорт;

// giCreateDate - Дата - Дата создания поставки
Перем giCreateDate Экспорт;

// incomeId - Число - Номер поставки
Перем incomeId Экспорт;

// nmID - Число - Артикул WB
Перем nmID Экспорт;

// shkCreateDate - Дата - Дата приёмки
Перем shkCreateDate Экспорт;

// subjectName - Строка - Предмет
Перем subjectName Экспорт;

// total - Число - Суммарная стоимость приёмки, ₽ с копейками
Перем total Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("count") <> Неопределено Тогда
		count = Значения.Получить("count");
	КонецЕсли;
	Если Значения.Получить("giCreateDate") <> Неопределено Тогда
		giCreateDate = Значения.Получить("giCreateDate");
	КонецЕсли;
	Если Значения.Получить("incomeId") <> Неопределено Тогда
		incomeId = Значения.Получить("incomeId");
	КонецЕсли;
	Если Значения.Получить("nmID") <> Неопределено Тогда
		nmID = Значения.Получить("nmID");
	КонецЕсли;
	Если Значения.Получить("shkCreateDate") <> Неопределено Тогда
		shkCreateDate = Значения.Получить("shkCreateDate");
	КонецЕсли;
	Если Значения.Получить("subjectName") <> Неопределено Тогда
		subjectName = Значения.Получить("subjectName");
	КонецЕсли;
	Если Значения.Получить("total") <> Неопределено Тогда
		total = Значения.Получить("total");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если count <> Неопределено Тогда
		Результат.Вставить("count", ЗначениеДляJSON(count));
	КонецЕсли;
	Если giCreateDate <> Неопределено Тогда
		Результат.Вставить("giCreateDate", ЗначениеДляJSON(giCreateDate));
	КонецЕсли;
	Если incomeId <> Неопределено Тогда
		Результат.Вставить("incomeId", ЗначениеДляJSON(incomeId));
	КонецЕсли;
	Если nmID <> Неопределено Тогда
		Результат.Вставить("nmID", ЗначениеДляJSON(nmID));
	КонецЕсли;
	Если shkCreateDate <> Неопределено Тогда
		Результат.Вставить("shkCreateDate", ЗначениеДляJSON(shkCreateDate));
	КонецЕсли;
	Если subjectName <> Неопределено Тогда
		Результат.Вставить("subjectName", ЗначениеДляJSON(subjectName));
	КонецЕсли;
	Если total <> Неопределено Тогда
		Результат.Вставить("total", ЗначениеДляJSON(total));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

