// ReportsWHMDataReportsInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// nmId - Число - Артикул WB
Перем nmId Экспорт;

// subjectName - Строка - Предмет
Перем subjectName Экспорт;

// dimId - Число - ID замера
Перем dimId Экспорт;

// volume - Число - Объём, л
Перем volume Экспорт;

// width - Число - Ширина, см
Перем width Экспорт;

// length - Число - Длина, см
Перем length Экспорт;

// height - Число - Высота, см
Перем height Экспорт;

// photoUrls - Массив - Фото замеров
Перем photoUrls Экспорт;

// dt - Дата - Дата и время
Перем dt Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("nmId") <> Неопределено Тогда
		nmId = Значения.Получить("nmId");
	КонецЕсли;
	Если Значения.Получить("subjectName") <> Неопределено Тогда
		subjectName = Значения.Получить("subjectName");
	КонецЕсли;
	Если Значения.Получить("dimId") <> Неопределено Тогда
		dimId = Значения.Получить("dimId");
	КонецЕсли;
	Если Значения.Получить("volume") <> Неопределено Тогда
		volume = Значения.Получить("volume");
	КонецЕсли;
	Если Значения.Получить("width") <> Неопределено Тогда
		width = Значения.Получить("width");
	КонецЕсли;
	Если Значения.Получить("length") <> Неопределено Тогда
		length = Значения.Получить("length");
	КонецЕсли;
	Если Значения.Получить("height") <> Неопределено Тогда
		height = Значения.Получить("height");
	КонецЕсли;
	Если Значения.Получить("photoUrls") <> Неопределено Тогда
		photoUrls = Значения.Получить("photoUrls");
	КонецЕсли;
	Если Значения.Получить("dt") <> Неопределено Тогда
		dt = Значения.Получить("dt");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если nmId <> Неопределено Тогда
		Результат.Вставить("nmId", ЗначениеДляJSON(nmId));
	КонецЕсли;
	Если subjectName <> Неопределено Тогда
		Результат.Вставить("subjectName", ЗначениеДляJSON(subjectName));
	КонецЕсли;
	Если dimId <> Неопределено Тогда
		Результат.Вставить("dimId", ЗначениеДляJSON(dimId));
	КонецЕсли;
	Если volume <> Неопределено Тогда
		Результат.Вставить("volume", ЗначениеДляJSON(volume));
	КонецЕсли;
	Если width <> Неопределено Тогда
		Результат.Вставить("width", ЗначениеДляJSON(width));
	КонецЕсли;
	Если length <> Неопределено Тогда
		Результат.Вставить("length", ЗначениеДляJSON(length));
	КонецЕсли;
	Если height <> Неопределено Тогда
		Результат.Вставить("height", ЗначениеДляJSON(height));
	КонецЕсли;
	Если photoUrls <> Неопределено Тогда
		Результат.Вставить("photoUrls", ЗначениеДляJSON(photoUrls));
	КонецЕсли;
	Если dt <> Неопределено Тогда
		Результат.Вставить("dt", ЗначениеДляJSON(dt));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

