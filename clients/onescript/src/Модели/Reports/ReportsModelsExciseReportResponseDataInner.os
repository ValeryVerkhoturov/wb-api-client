// ReportsModelsExciseReportResponseDataInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// name - Строка - Страна покупателя
Перем name Экспорт;

// price - Число - Цена товара, с НДС
Перем price Экспорт;

// currency_name_short - Строка - Валюта
Перем currency_name_short Экспорт;

// excise_short - Строка - Код маркировки
Перем excise_short Экспорт;

// barcode - Строка - Баркод
Перем barcode Экспорт;

// nm_id - Число - Артикул WB
Перем nm_id Экспорт;

// operation_type_id - Число - Тип операции, если есть: * `1` — вывод из оборота * `2` — возврат в оборот
Перем operation_type_id Экспорт;

// fiscal_doc_number - Число - Номер фискального документа (чека полного расчёта), если есть
Перем fiscal_doc_number Экспорт;

// fiscal_dt - Строка - Дата фискализации (дата в чеке), если есть, `ГГГГ-ММ-ДД`
Перем fiscal_dt Экспорт;

// fiscal_drive_number - Строка - Номер фискального накопителя, если есть
Перем fiscal_drive_number Экспорт;

// rid - Число - `Rid`
Перем rid Экспорт;

// srid - Строка - `Srid`
Перем srid Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("name") <> Неопределено Тогда
		name = Значения.Получить("name");
	КонецЕсли;
	Если Значения.Получить("price") <> Неопределено Тогда
		price = Значения.Получить("price");
	КонецЕсли;
	Если Значения.Получить("currency_name_short") <> Неопределено Тогда
		currency_name_short = Значения.Получить("currency_name_short");
	КонецЕсли;
	Если Значения.Получить("excise_short") <> Неопределено Тогда
		excise_short = Значения.Получить("excise_short");
	КонецЕсли;
	Если Значения.Получить("barcode") <> Неопределено Тогда
		barcode = Значения.Получить("barcode");
	КонецЕсли;
	Если Значения.Получить("nm_id") <> Неопределено Тогда
		nm_id = Значения.Получить("nm_id");
	КонецЕсли;
	Если Значения.Получить("operation_type_id") <> Неопределено Тогда
		operation_type_id = Значения.Получить("operation_type_id");
	КонецЕсли;
	Если Значения.Получить("fiscal_doc_number") <> Неопределено Тогда
		fiscal_doc_number = Значения.Получить("fiscal_doc_number");
	КонецЕсли;
	Если Значения.Получить("fiscal_dt") <> Неопределено Тогда
		fiscal_dt = Значения.Получить("fiscal_dt");
	КонецЕсли;
	Если Значения.Получить("fiscal_drive_number") <> Неопределено Тогда
		fiscal_drive_number = Значения.Получить("fiscal_drive_number");
	КонецЕсли;
	Если Значения.Получить("rid") <> Неопределено Тогда
		rid = Значения.Получить("rid");
	КонецЕсли;
	Если Значения.Получить("srid") <> Неопределено Тогда
		srid = Значения.Получить("srid");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если name <> Неопределено Тогда
		Результат.Вставить("name", ЗначениеДляJSON(name));
	КонецЕсли;
	Если price <> Неопределено Тогда
		Результат.Вставить("price", ЗначениеДляJSON(price));
	КонецЕсли;
	Если currency_name_short <> Неопределено Тогда
		Результат.Вставить("currency_name_short", ЗначениеДляJSON(currency_name_short));
	КонецЕсли;
	Если excise_short <> Неопределено Тогда
		Результат.Вставить("excise_short", ЗначениеДляJSON(excise_short));
	КонецЕсли;
	Если barcode <> Неопределено Тогда
		Результат.Вставить("barcode", ЗначениеДляJSON(barcode));
	КонецЕсли;
	Если nm_id <> Неопределено Тогда
		Результат.Вставить("nm_id", ЗначениеДляJSON(nm_id));
	КонецЕсли;
	Если operation_type_id <> Неопределено Тогда
		Результат.Вставить("operation_type_id", ЗначениеДляJSON(operation_type_id));
	КонецЕсли;
	Если fiscal_doc_number <> Неопределено Тогда
		Результат.Вставить("fiscal_doc_number", ЗначениеДляJSON(fiscal_doc_number));
	КонецЕсли;
	Если fiscal_dt <> Неопределено Тогда
		Результат.Вставить("fiscal_dt", ЗначениеДляJSON(fiscal_dt));
	КонецЕсли;
	Если fiscal_drive_number <> Неопределено Тогда
		Результат.Вставить("fiscal_drive_number", ЗначениеДляJSON(fiscal_drive_number));
	КонецЕсли;
	Если rid <> Неопределено Тогда
		Результат.Вставить("rid", ЗначениеДляJSON(rid));
	КонецЕсли;
	Если srid <> Неопределено Тогда
		Результат.Вставить("srid", ЗначениеДляJSON(srid));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

