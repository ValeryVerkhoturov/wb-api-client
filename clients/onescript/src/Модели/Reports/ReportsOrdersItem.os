// ReportsOrdersItem
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// date - Строка - Дата и время заказа. Это поле соответствует параметру `dateFrom` в запросе, если параметр `flag`=1. Если часовой пояс не указан, то берётся Московское время (UT…
Перем date Экспорт;

// lastChangeDate - Строка - Дата и время обновления информации в сервисе. Это поле соответствует параметру `dateFrom` в запросе, если параметр `flag`=0 или не указан. Если часовой пояс не…
Перем lastChangeDate Экспорт;

// warehouseName - Строка - Склад отгрузки
Перем warehouseName Экспорт;

// warehouseType - Строка - Тип склада хранения товаров
Перем warehouseType Экспорт;

// countryName - Строка - Страна
Перем countryName Экспорт;

// oblastOkrugName - Строка - Округ
Перем oblastOkrugName Экспорт;

// regionName - Строка - Регион
Перем regionName Экспорт;

// supplierArticle - Строка - Артикул продавца
Перем supplierArticle Экспорт;

// nmId - Число - Артикул WB
Перем nmId Экспорт;

// barcode - Строка - Баркод
Перем barcode Экспорт;

// category - Строка - Категория
Перем category Экспорт;

// subject - Строка - Предмет
Перем subject Экспорт;

// brand - Строка - Бренд
Перем brand Экспорт;

// techSize - Строка - Размер товара
Перем techSize Экспорт;

// incomeID - Число - Номер поставки
Перем incomeID Экспорт;

// isSupply - Булево - Договор поставки
Перем isSupply Экспорт;

// isRealization - Булево - Договор реализации
Перем isRealization Экспорт;

// totalPrice - Число - Цена без скидок
Перем totalPrice Экспорт;

// discountPercent - Число - Скидка продавца, %
Перем discountPercent Экспорт;

// spp - Число - Скидка WB, %
Перем spp Экспорт;

// finishedPrice - Число - Цена с учетом всех скидок, кроме суммы по WB Кошельку
Перем finishedPrice Экспорт;

// priceWithDisc - Число - Цена со скидкой продавца, в том числе со скидкой WB Клуба
Перем priceWithDisc Экспорт;

// isCancel - Булево - Отмена заказа: - `true` — заказ отменен
Перем isCancel Экспорт;

// cancelDate - Строка - Дата и время отмены заказа. Если заказ не был отменен, то \"0001-01-01T00:00:00\".Если часовой пояс не указан, то берётся Московское время UTC+3.
Перем cancelDate Экспорт;

// sticker - Строка - ID стикера
Перем sticker Экспорт;

// gNumber - Строка - ID корзины покупателя. Заказы одной транзакции будут иметь одинаковый `gNumber`
Перем gNumber Экспорт;

// srid - Строка - Уникальный ID заказа. Примечание для использующих API Маркетплейс: `srid` равен `rid` в ответах методов сборочных заданий.
Перем srid Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("date") <> Неопределено Тогда
		date = Значения.Получить("date");
	КонецЕсли;
	Если Значения.Получить("lastChangeDate") <> Неопределено Тогда
		lastChangeDate = Значения.Получить("lastChangeDate");
	КонецЕсли;
	Если Значения.Получить("warehouseName") <> Неопределено Тогда
		warehouseName = Значения.Получить("warehouseName");
	КонецЕсли;
	Если Значения.Получить("warehouseType") <> Неопределено Тогда
		warehouseType = Значения.Получить("warehouseType");
	КонецЕсли;
	Если Значения.Получить("countryName") <> Неопределено Тогда
		countryName = Значения.Получить("countryName");
	КонецЕсли;
	Если Значения.Получить("oblastOkrugName") <> Неопределено Тогда
		oblastOkrugName = Значения.Получить("oblastOkrugName");
	КонецЕсли;
	Если Значения.Получить("regionName") <> Неопределено Тогда
		regionName = Значения.Получить("regionName");
	КонецЕсли;
	Если Значения.Получить("supplierArticle") <> Неопределено Тогда
		supplierArticle = Значения.Получить("supplierArticle");
	КонецЕсли;
	Если Значения.Получить("nmId") <> Неопределено Тогда
		nmId = Значения.Получить("nmId");
	КонецЕсли;
	Если Значения.Получить("barcode") <> Неопределено Тогда
		barcode = Значения.Получить("barcode");
	КонецЕсли;
	Если Значения.Получить("category") <> Неопределено Тогда
		category = Значения.Получить("category");
	КонецЕсли;
	Если Значения.Получить("subject") <> Неопределено Тогда
		subject = Значения.Получить("subject");
	КонецЕсли;
	Если Значения.Получить("brand") <> Неопределено Тогда
		brand = Значения.Получить("brand");
	КонецЕсли;
	Если Значения.Получить("techSize") <> Неопределено Тогда
		techSize = Значения.Получить("techSize");
	КонецЕсли;
	Если Значения.Получить("incomeID") <> Неопределено Тогда
		incomeID = Значения.Получить("incomeID");
	КонецЕсли;
	Если Значения.Получить("isSupply") <> Неопределено Тогда
		isSupply = Значения.Получить("isSupply");
	КонецЕсли;
	Если Значения.Получить("isRealization") <> Неопределено Тогда
		isRealization = Значения.Получить("isRealization");
	КонецЕсли;
	Если Значения.Получить("totalPrice") <> Неопределено Тогда
		totalPrice = Значения.Получить("totalPrice");
	КонецЕсли;
	Если Значения.Получить("discountPercent") <> Неопределено Тогда
		discountPercent = Значения.Получить("discountPercent");
	КонецЕсли;
	Если Значения.Получить("spp") <> Неопределено Тогда
		spp = Значения.Получить("spp");
	КонецЕсли;
	Если Значения.Получить("finishedPrice") <> Неопределено Тогда
		finishedPrice = Значения.Получить("finishedPrice");
	КонецЕсли;
	Если Значения.Получить("priceWithDisc") <> Неопределено Тогда
		priceWithDisc = Значения.Получить("priceWithDisc");
	КонецЕсли;
	Если Значения.Получить("isCancel") <> Неопределено Тогда
		isCancel = Значения.Получить("isCancel");
	КонецЕсли;
	Если Значения.Получить("cancelDate") <> Неопределено Тогда
		cancelDate = Значения.Получить("cancelDate");
	КонецЕсли;
	Если Значения.Получить("sticker") <> Неопределено Тогда
		sticker = Значения.Получить("sticker");
	КонецЕсли;
	Если Значения.Получить("gNumber") <> Неопределено Тогда
		gNumber = Значения.Получить("gNumber");
	КонецЕсли;
	Если Значения.Получить("srid") <> Неопределено Тогда
		srid = Значения.Получить("srid");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если date <> Неопределено Тогда
		Результат.Вставить("date", ЗначениеДляJSON(date));
	КонецЕсли;
	Если lastChangeDate <> Неопределено Тогда
		Результат.Вставить("lastChangeDate", ЗначениеДляJSON(lastChangeDate));
	КонецЕсли;
	Если warehouseName <> Неопределено Тогда
		Результат.Вставить("warehouseName", ЗначениеДляJSON(warehouseName));
	КонецЕсли;
	Если warehouseType <> Неопределено Тогда
		Результат.Вставить("warehouseType", ЗначениеДляJSON(warehouseType));
	КонецЕсли;
	Если countryName <> Неопределено Тогда
		Результат.Вставить("countryName", ЗначениеДляJSON(countryName));
	КонецЕсли;
	Если oblastOkrugName <> Неопределено Тогда
		Результат.Вставить("oblastOkrugName", ЗначениеДляJSON(oblastOkrugName));
	КонецЕсли;
	Если regionName <> Неопределено Тогда
		Результат.Вставить("regionName", ЗначениеДляJSON(regionName));
	КонецЕсли;
	Если supplierArticle <> Неопределено Тогда
		Результат.Вставить("supplierArticle", ЗначениеДляJSON(supplierArticle));
	КонецЕсли;
	Если nmId <> Неопределено Тогда
		Результат.Вставить("nmId", ЗначениеДляJSON(nmId));
	КонецЕсли;
	Если barcode <> Неопределено Тогда
		Результат.Вставить("barcode", ЗначениеДляJSON(barcode));
	КонецЕсли;
	Если category <> Неопределено Тогда
		Результат.Вставить("category", ЗначениеДляJSON(category));
	КонецЕсли;
	Если subject <> Неопределено Тогда
		Результат.Вставить("subject", ЗначениеДляJSON(subject));
	КонецЕсли;
	Если brand <> Неопределено Тогда
		Результат.Вставить("brand", ЗначениеДляJSON(brand));
	КонецЕсли;
	Если techSize <> Неопределено Тогда
		Результат.Вставить("techSize", ЗначениеДляJSON(techSize));
	КонецЕсли;
	Если incomeID <> Неопределено Тогда
		Результат.Вставить("incomeID", ЗначениеДляJSON(incomeID));
	КонецЕсли;
	Если isSupply <> Неопределено Тогда
		Результат.Вставить("isSupply", ЗначениеДляJSON(isSupply));
	КонецЕсли;
	Если isRealization <> Неопределено Тогда
		Результат.Вставить("isRealization", ЗначениеДляJSON(isRealization));
	КонецЕсли;
	Если totalPrice <> Неопределено Тогда
		Результат.Вставить("totalPrice", ЗначениеДляJSON(totalPrice));
	КонецЕсли;
	Если discountPercent <> Неопределено Тогда
		Результат.Вставить("discountPercent", ЗначениеДляJSON(discountPercent));
	КонецЕсли;
	Если spp <> Неопределено Тогда
		Результат.Вставить("spp", ЗначениеДляJSON(spp));
	КонецЕсли;
	Если finishedPrice <> Неопределено Тогда
		Результат.Вставить("finishedPrice", ЗначениеДляJSON(finishedPrice));
	КонецЕсли;
	Если priceWithDisc <> Неопределено Тогда
		Результат.Вставить("priceWithDisc", ЗначениеДляJSON(priceWithDisc));
	КонецЕсли;
	Если isCancel <> Неопределено Тогда
		Результат.Вставить("isCancel", ЗначениеДляJSON(isCancel));
	КонецЕсли;
	Если cancelDate <> Неопределено Тогда
		Результат.Вставить("cancelDate", ЗначениеДляJSON(cancelDate));
	КонецЕсли;
	Если sticker <> Неопределено Тогда
		Результат.Вставить("sticker", ЗначениеДляJSON(sticker));
	КонецЕсли;
	Если gNumber <> Неопределено Тогда
		Результат.Вставить("gNumber", ЗначениеДляJSON(gNumber));
	КонецЕсли;
	Если srid <> Неопределено Тогда
		Результат.Вставить("srid", ЗначениеДляJSON(srid));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

