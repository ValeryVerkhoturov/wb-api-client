// ReportsGetV1Deductions200ResponseDataReportsInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// dtBonus - Дата - Дата и время удержания
Перем dtBonus Экспорт;

// nmId - Число - Артикул WB
Перем nmId Экспорт;

// oldShkId - Число - Старый штрихкод
Перем oldShkId Экспорт;

// oldColor - Строка - Старый цвет
Перем oldColor Экспорт;

// oldSize - Строка - Старый размер
Перем oldSize Экспорт;

// oldSku - Строка - Старый баркод
Перем oldSku Экспорт;

// oldVendorCode - Строка - Старый артикул продавца
Перем oldVendorCode Экспорт;

// newShkId - Число - Новый штрихкод
Перем newShkId Экспорт;

// newColor - Строка - Новый цвет
Перем newColor Экспорт;

// newSize - Строка - Новый размер
Перем newSize Экспорт;

// newSku - Строка - Новый баркод
Перем newSku Экспорт;

// newVendorCode - Строка - Новый артикул продавца
Перем newVendorCode Экспорт;

// bonusSumm - Число - Сумма удержания
Перем bonusSumm Экспорт;

// bonusType - Строка - Причина удержания
Перем bonusType Экспорт;

// photoUrls - Массив - Фото замеров
Перем photoUrls Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("dtBonus") <> Неопределено Тогда
		dtBonus = Значения.Получить("dtBonus");
	КонецЕсли;
	Если Значения.Получить("nmId") <> Неопределено Тогда
		nmId = Значения.Получить("nmId");
	КонецЕсли;
	Если Значения.Получить("oldShkId") <> Неопределено Тогда
		oldShkId = Значения.Получить("oldShkId");
	КонецЕсли;
	Если Значения.Получить("oldColor") <> Неопределено Тогда
		oldColor = Значения.Получить("oldColor");
	КонецЕсли;
	Если Значения.Получить("oldSize") <> Неопределено Тогда
		oldSize = Значения.Получить("oldSize");
	КонецЕсли;
	Если Значения.Получить("oldSku") <> Неопределено Тогда
		oldSku = Значения.Получить("oldSku");
	КонецЕсли;
	Если Значения.Получить("oldVendorCode") <> Неопределено Тогда
		oldVendorCode = Значения.Получить("oldVendorCode");
	КонецЕсли;
	Если Значения.Получить("newShkId") <> Неопределено Тогда
		newShkId = Значения.Получить("newShkId");
	КонецЕсли;
	Если Значения.Получить("newColor") <> Неопределено Тогда
		newColor = Значения.Получить("newColor");
	КонецЕсли;
	Если Значения.Получить("newSize") <> Неопределено Тогда
		newSize = Значения.Получить("newSize");
	КонецЕсли;
	Если Значения.Получить("newSku") <> Неопределено Тогда
		newSku = Значения.Получить("newSku");
	КонецЕсли;
	Если Значения.Получить("newVendorCode") <> Неопределено Тогда
		newVendorCode = Значения.Получить("newVendorCode");
	КонецЕсли;
	Если Значения.Получить("bonusSumm") <> Неопределено Тогда
		bonusSumm = Значения.Получить("bonusSumm");
	КонецЕсли;
	Если Значения.Получить("bonusType") <> Неопределено Тогда
		bonusType = Значения.Получить("bonusType");
	КонецЕсли;
	Если Значения.Получить("photoUrls") <> Неопределено Тогда
		photoUrls = Значения.Получить("photoUrls");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если dtBonus <> Неопределено Тогда
		Результат.Вставить("dtBonus", ЗначениеДляJSON(dtBonus));
	КонецЕсли;
	Если nmId <> Неопределено Тогда
		Результат.Вставить("nmId", ЗначениеДляJSON(nmId));
	КонецЕсли;
	Если oldShkId <> Неопределено Тогда
		Результат.Вставить("oldShkId", ЗначениеДляJSON(oldShkId));
	КонецЕсли;
	Если oldColor <> Неопределено Тогда
		Результат.Вставить("oldColor", ЗначениеДляJSON(oldColor));
	КонецЕсли;
	Если oldSize <> Неопределено Тогда
		Результат.Вставить("oldSize", ЗначениеДляJSON(oldSize));
	КонецЕсли;
	Если oldSku <> Неопределено Тогда
		Результат.Вставить("oldSku", ЗначениеДляJSON(oldSku));
	КонецЕсли;
	Если oldVendorCode <> Неопределено Тогда
		Результат.Вставить("oldVendorCode", ЗначениеДляJSON(oldVendorCode));
	КонецЕсли;
	Если newShkId <> Неопределено Тогда
		Результат.Вставить("newShkId", ЗначениеДляJSON(newShkId));
	КонецЕсли;
	Если newColor <> Неопределено Тогда
		Результат.Вставить("newColor", ЗначениеДляJSON(newColor));
	КонецЕсли;
	Если newSize <> Неопределено Тогда
		Результат.Вставить("newSize", ЗначениеДляJSON(newSize));
	КонецЕсли;
	Если newSku <> Неопределено Тогда
		Результат.Вставить("newSku", ЗначениеДляJSON(newSku));
	КонецЕсли;
	Если newVendorCode <> Неопределено Тогда
		Результат.Вставить("newVendorCode", ЗначениеДляJSON(newVendorCode));
	КонецЕсли;
	Если bonusSumm <> Неопределено Тогда
		Результат.Вставить("bonusSumm", ЗначениеДляJSON(bonusSumm));
	КонецЕсли;
	Если bonusType <> Неопределено Тогда
		Результат.Вставить("bonusType", ЗначениеДляJSON(bonusType));
	КонецЕсли;
	Если photoUrls <> Неопределено Тогда
		Результат.Вставить("photoUrls", ЗначениеДляJSON(photoUrls));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

