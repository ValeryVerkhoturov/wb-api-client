// ReportsGetV1AnalyticsGoodsLabeling200ResponseReportInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// amount - Число - Сумма штрафа, руб
Перем amount Экспорт;

// date - Дата - Дата
Перем date Экспорт;

// incomeId - Число - Номер поставки
Перем incomeId Экспорт;

// nmID - Число - Артикул WB
Перем nmID Экспорт;

// photoUrls - Массив - URL фото товара
Перем photoUrls Экспорт;

// shkID - Число - Штрихкод товара в WB
Перем shkID Экспорт;

// sku - Строка - Баркод из карточки товара
Перем sku Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("amount") <> Неопределено Тогда
		amount = Значения.Получить("amount");
	КонецЕсли;
	Если Значения.Получить("date") <> Неопределено Тогда
		date = Значения.Получить("date");
	КонецЕсли;
	Если Значения.Получить("incomeId") <> Неопределено Тогда
		incomeId = Значения.Получить("incomeId");
	КонецЕсли;
	Если Значения.Получить("nmID") <> Неопределено Тогда
		nmID = Значения.Получить("nmID");
	КонецЕсли;
	Если Значения.Получить("photoUrls") <> Неопределено Тогда
		photoUrls = Значения.Получить("photoUrls");
	КонецЕсли;
	Если Значения.Получить("shkID") <> Неопределено Тогда
		shkID = Значения.Получить("shkID");
	КонецЕсли;
	Если Значения.Получить("sku") <> Неопределено Тогда
		sku = Значения.Получить("sku");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если amount <> Неопределено Тогда
		Результат.Вставить("amount", ЗначениеДляJSON(amount));
	КонецЕсли;
	Если date <> Неопределено Тогда
		Результат.Вставить("date", ЗначениеДляJSON(date));
	КонецЕсли;
	Если incomeId <> Неопределено Тогда
		Результат.Вставить("incomeId", ЗначениеДляJSON(incomeId));
	КонецЕсли;
	Если nmID <> Неопределено Тогда
		Результат.Вставить("nmID", ЗначениеДляJSON(nmID));
	КонецЕсли;
	Если photoUrls <> Неопределено Тогда
		Результат.Вставить("photoUrls", ЗначениеДляJSON(photoUrls));
	КонецЕсли;
	Если shkID <> Неопределено Тогда
		Результат.Вставить("shkID", ЗначениеДляJSON(shkID));
	КонецЕсли;
	Если sku <> Неопределено Тогда
		Результат.Вставить("sku", ЗначениеДляJSON(sku));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

