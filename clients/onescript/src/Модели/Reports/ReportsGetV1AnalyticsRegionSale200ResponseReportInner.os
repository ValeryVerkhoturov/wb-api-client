// ReportsGetV1AnalyticsRegionSale200ResponseReportInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// cityName - Строка - Населённый пункт
Перем cityName Экспорт;

// countryName - Строка - Страна
Перем countryName Экспорт;

// foName - Строка - Федеральный округ
Перем foName Экспорт;

// nmID - Число - Артикул WB
Перем nmID Экспорт;

// regionName - Строка - Регион
Перем regionName Экспорт;

// sa - Строка - Артикул продавца
Перем sa Экспорт;

// saleInvoiceCostPrice - Число - К перечислению за товар, ₽
Перем saleInvoiceCostPrice Экспорт;

// saleInvoiceCostPricePerc - Число - Доля, %
Перем saleInvoiceCostPricePerc Экспорт;

// saleItemInvoiceQty - Число - Выкупили, шт.
Перем saleItemInvoiceQty Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("cityName") <> Неопределено Тогда
		cityName = Значения.Получить("cityName");
	КонецЕсли;
	Если Значения.Получить("countryName") <> Неопределено Тогда
		countryName = Значения.Получить("countryName");
	КонецЕсли;
	Если Значения.Получить("foName") <> Неопределено Тогда
		foName = Значения.Получить("foName");
	КонецЕсли;
	Если Значения.Получить("nmID") <> Неопределено Тогда
		nmID = Значения.Получить("nmID");
	КонецЕсли;
	Если Значения.Получить("regionName") <> Неопределено Тогда
		regionName = Значения.Получить("regionName");
	КонецЕсли;
	Если Значения.Получить("sa") <> Неопределено Тогда
		sa = Значения.Получить("sa");
	КонецЕсли;
	Если Значения.Получить("saleInvoiceCostPrice") <> Неопределено Тогда
		saleInvoiceCostPrice = Значения.Получить("saleInvoiceCostPrice");
	КонецЕсли;
	Если Значения.Получить("saleInvoiceCostPricePerc") <> Неопределено Тогда
		saleInvoiceCostPricePerc = Значения.Получить("saleInvoiceCostPricePerc");
	КонецЕсли;
	Если Значения.Получить("saleItemInvoiceQty") <> Неопределено Тогда
		saleItemInvoiceQty = Значения.Получить("saleItemInvoiceQty");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если cityName <> Неопределено Тогда
		Результат.Вставить("cityName", ЗначениеДляJSON(cityName));
	КонецЕсли;
	Если countryName <> Неопределено Тогда
		Результат.Вставить("countryName", ЗначениеДляJSON(countryName));
	КонецЕсли;
	Если foName <> Неопределено Тогда
		Результат.Вставить("foName", ЗначениеДляJSON(foName));
	КонецЕсли;
	Если nmID <> Неопределено Тогда
		Результат.Вставить("nmID", ЗначениеДляJSON(nmID));
	КонецЕсли;
	Если regionName <> Неопределено Тогда
		Результат.Вставить("regionName", ЗначениеДляJSON(regionName));
	КонецЕсли;
	Если sa <> Неопределено Тогда
		Результат.Вставить("sa", ЗначениеДляJSON(sa));
	КонецЕсли;
	Если saleInvoiceCostPrice <> Неопределено Тогда
		Результат.Вставить("saleInvoiceCostPrice", ЗначениеДляJSON(saleInvoiceCostPrice));
	КонецЕсли;
	Если saleInvoiceCostPricePerc <> Неопределено Тогда
		Результат.Вставить("saleInvoiceCostPricePerc", ЗначениеДляJSON(saleInvoiceCostPricePerc));
	КонецЕсли;
	Если saleItemInvoiceQty <> Неопределено Тогда
		Результат.Вставить("saleItemInvoiceQty", ЗначениеДляJSON(saleItemInvoiceQty));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

