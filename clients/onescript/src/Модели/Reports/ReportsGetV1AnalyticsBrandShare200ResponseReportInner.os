// ReportsGetV1AnalyticsBrandShare200ResponseReportInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// applyDate - Строка - Дата
Перем applyDate Экспорт;

// brandRating - Число - Рейтинг бренда в родительской категории
Перем brandRating Экспорт;

// pricePercent - Число - Доля от продаж в родительской категории — цена, %
Перем pricePercent Экспорт;

// qtyPercent - Число - Доля от продаж в родительской категории — количество, %
Перем qtyPercent Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("applyDate") <> Неопределено Тогда
		applyDate = Значения.Получить("applyDate");
	КонецЕсли;
	Если Значения.Получить("brandRating") <> Неопределено Тогда
		brandRating = Значения.Получить("brandRating");
	КонецЕсли;
	Если Значения.Получить("pricePercent") <> Неопределено Тогда
		pricePercent = Значения.Получить("pricePercent");
	КонецЕсли;
	Если Значения.Получить("qtyPercent") <> Неопределено Тогда
		qtyPercent = Значения.Получить("qtyPercent");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если applyDate <> Неопределено Тогда
		Результат.Вставить("applyDate", ЗначениеДляJSON(applyDate));
	КонецЕсли;
	Если brandRating <> Неопределено Тогда
		Результат.Вставить("brandRating", ЗначениеДляJSON(brandRating));
	КонецЕсли;
	Если pricePercent <> Неопределено Тогда
		Результат.Вставить("pricePercent", ЗначениеДляJSON(pricePercent));
	КонецЕсли;
	Если qtyPercent <> Неопределено Тогда
		Результат.Вставить("qtyPercent", ЗначениеДляJSON(qtyPercent));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

