// ReportsMeasurementPenaltiesDataReportsInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// nmId - Число - Артикул WB
Перем nmId Экспорт;

// subjectName - Строка - Предмет
Перем subjectName Экспорт;

// dimId - Число - ID замера
Перем dimId Экспорт;

// prcOver - Число - Разница в габаритах, %
Перем prcOver Экспорт;

// volume - Число - Объём, л (фактические габариты по замеру на складе)
Перем volume Экспорт;

// width - Число - Ширина, см (фактические габариты по замеру на складе)
Перем width Экспорт;

// length - Число - Длина, см (фактические габариты по замеру на складе)
Перем length Экспорт;

// height - Число - Высота, см (фактические габариты по замеру на складе)
Перем height Экспорт;

// volumeSup - Число - Объём, л (габариты карточки товара)
Перем volumeSup Экспорт;

// widthSup - Число - Ширина, см (габариты карточки товара)
Перем widthSup Экспорт;

// lengthSup - Число - Длина, см (габариты карточки товара)
Перем lengthSup Экспорт;

// heightSup - Число - Высота, см (габариты карточки товара)
Перем heightSup Экспорт;

// photoUrls - Массив - Фото замеров
Перем photoUrls Экспорт;

// dtBonus - Дата - Дата штрафа
Перем dtBonus Экспорт;

// isValid - Булево - Статус обмера: - `false` — отменён - `true` — подтверждён
Перем isValid Экспорт;

// isValidDt - Дата - Дата и время подтверждения или отмены обмера
Перем isValidDt Экспорт;

// reversalAmount - Число - Сумма сторно
Перем reversalAmount Экспорт;

// penaltyAmount - Число - Сумма штрафа
Перем penaltyAmount Экспорт;

// dateStart - Дата - Дата и время начала действия коэффициента
Перем dateStart Экспорт;

// dateEnd - Дата - Дата и время окончания действия коэффициента
Перем dateEnd Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("nmId") <> Неопределено Тогда
		nmId = Значения.Получить("nmId");
	КонецЕсли;
	Если Значения.Получить("subjectName") <> Неопределено Тогда
		subjectName = Значения.Получить("subjectName");
	КонецЕсли;
	Если Значения.Получить("dimId") <> Неопределено Тогда
		dimId = Значения.Получить("dimId");
	КонецЕсли;
	Если Значения.Получить("prcOver") <> Неопределено Тогда
		prcOver = Значения.Получить("prcOver");
	КонецЕсли;
	Если Значения.Получить("volume") <> Неопределено Тогда
		volume = Значения.Получить("volume");
	КонецЕсли;
	Если Значения.Получить("width") <> Неопределено Тогда
		width = Значения.Получить("width");
	КонецЕсли;
	Если Значения.Получить("length") <> Неопределено Тогда
		length = Значения.Получить("length");
	КонецЕсли;
	Если Значения.Получить("height") <> Неопределено Тогда
		height = Значения.Получить("height");
	КонецЕсли;
	Если Значения.Получить("volumeSup") <> Неопределено Тогда
		volumeSup = Значения.Получить("volumeSup");
	КонецЕсли;
	Если Значения.Получить("widthSup") <> Неопределено Тогда
		widthSup = Значения.Получить("widthSup");
	КонецЕсли;
	Если Значения.Получить("lengthSup") <> Неопределено Тогда
		lengthSup = Значения.Получить("lengthSup");
	КонецЕсли;
	Если Значения.Получить("heightSup") <> Неопределено Тогда
		heightSup = Значения.Получить("heightSup");
	КонецЕсли;
	Если Значения.Получить("photoUrls") <> Неопределено Тогда
		photoUrls = Значения.Получить("photoUrls");
	КонецЕсли;
	Если Значения.Получить("dtBonus") <> Неопределено Тогда
		dtBonus = Значения.Получить("dtBonus");
	КонецЕсли;
	Если Значения.Получить("isValid") <> Неопределено Тогда
		isValid = Значения.Получить("isValid");
	КонецЕсли;
	Если Значения.Получить("isValidDt") <> Неопределено Тогда
		isValidDt = Значения.Получить("isValidDt");
	КонецЕсли;
	Если Значения.Получить("reversalAmount") <> Неопределено Тогда
		reversalAmount = Значения.Получить("reversalAmount");
	КонецЕсли;
	Если Значения.Получить("penaltyAmount") <> Неопределено Тогда
		penaltyAmount = Значения.Получить("penaltyAmount");
	КонецЕсли;
	Если Значения.Получить("dateStart") <> Неопределено Тогда
		dateStart = Значения.Получить("dateStart");
	КонецЕсли;
	Если Значения.Получить("dateEnd") <> Неопределено Тогда
		dateEnd = Значения.Получить("dateEnd");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если nmId <> Неопределено Тогда
		Результат.Вставить("nmId", ЗначениеДляJSON(nmId));
	КонецЕсли;
	Если subjectName <> Неопределено Тогда
		Результат.Вставить("subjectName", ЗначениеДляJSON(subjectName));
	КонецЕсли;
	Если dimId <> Неопределено Тогда
		Результат.Вставить("dimId", ЗначениеДляJSON(dimId));
	КонецЕсли;
	Если prcOver <> Неопределено Тогда
		Результат.Вставить("prcOver", ЗначениеДляJSON(prcOver));
	КонецЕсли;
	Если volume <> Неопределено Тогда
		Результат.Вставить("volume", ЗначениеДляJSON(volume));
	КонецЕсли;
	Если width <> Неопределено Тогда
		Результат.Вставить("width", ЗначениеДляJSON(width));
	КонецЕсли;
	Если length <> Неопределено Тогда
		Результат.Вставить("length", ЗначениеДляJSON(length));
	КонецЕсли;
	Если height <> Неопределено Тогда
		Результат.Вставить("height", ЗначениеДляJSON(height));
	КонецЕсли;
	Если volumeSup <> Неопределено Тогда
		Результат.Вставить("volumeSup", ЗначениеДляJSON(volumeSup));
	КонецЕсли;
	Если widthSup <> Неопределено Тогда
		Результат.Вставить("widthSup", ЗначениеДляJSON(widthSup));
	КонецЕсли;
	Если lengthSup <> Неопределено Тогда
		Результат.Вставить("lengthSup", ЗначениеДляJSON(lengthSup));
	КонецЕсли;
	Если heightSup <> Неопределено Тогда
		Результат.Вставить("heightSup", ЗначениеДляJSON(heightSup));
	КонецЕсли;
	Если photoUrls <> Неопределено Тогда
		Результат.Вставить("photoUrls", ЗначениеДляJSON(photoUrls));
	КонецЕсли;
	Если dtBonus <> Неопределено Тогда
		Результат.Вставить("dtBonus", ЗначениеДляJSON(dtBonus));
	КонецЕсли;
	Если isValid <> Неопределено Тогда
		Результат.Вставить("isValid", ЗначениеДляJSON(isValid));
	КонецЕсли;
	Если isValidDt <> Неопределено Тогда
		Результат.Вставить("isValidDt", ЗначениеДляJSON(isValidDt));
	КонецЕсли;
	Если reversalAmount <> Неопределено Тогда
		Результат.Вставить("reversalAmount", ЗначениеДляJSON(reversalAmount));
	КонецЕсли;
	Если penaltyAmount <> Неопределено Тогда
		Результат.Вставить("penaltyAmount", ЗначениеДляJSON(penaltyAmount));
	КонецЕсли;
	Если dateStart <> Неопределено Тогда
		Результат.Вставить("dateStart", ЗначениеДляJSON(dateStart));
	КонецЕсли;
	Если dateEnd <> Неопределено Тогда
		Результат.Вставить("dateEnd", ЗначениеДляJSON(dateEnd));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

