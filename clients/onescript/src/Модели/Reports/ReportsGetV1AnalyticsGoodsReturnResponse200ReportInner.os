// ReportsGetV1AnalyticsGoodsReturnResponse200ReportInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// barcode - Строка - Баркод
Перем barcode Экспорт;

// brand - Строка - Бренд
Перем brand Экспорт;

// completedDt - Строка - Дата и время выдачи возврата продавцу
Перем completedDt Экспорт;

// dstOfficeAddress - Строка - Адрес ПВЗ выдачи возврата
Перем dstOfficeAddress Экспорт;

// dstOfficeId - Число - ID ПВЗ выдачи возврата
Перем dstOfficeId Экспорт;

// expiredDt - Строка - Дата и время истечения срока хранения возврата
Перем expiredDt Экспорт;

// isStatusActive - Число - Тип статуса возврата: * `0` — архивный * `1` — активный
Перем isStatusActive Экспорт;

// nmId - Число - Артикул WB
Перем nmId Экспорт;

// orderDt - Дата - Дата заказа на возврат
Перем orderDt Экспорт;

// orderId - Число - Номер сборочного задания
Перем orderId Экспорт;

// readyToReturnDt - Строка - Дата и время готовности возврата к выдаче
Перем readyToReturnDt Экспорт;

// reason - Строка - Причина возврата
Перем reason Экспорт;

// returnType - Строка - Тип возврата
Перем returnType Экспорт;

// shkId - Число - Штрихкод
Перем shkId Экспорт;

// srid - Строка - Уникальный ID заказа на возврат
Перем srid Экспорт;

// status - Строка - Статус возврата
Перем status Экспорт;

// stickerId - Строка - Стикер заказа на возврат
Перем stickerId Экспорт;

// subjectName - Строка - Предмет
Перем subjectName Экспорт;

// techSize - Строка - Размер
Перем techSize Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("barcode") <> Неопределено Тогда
		barcode = Значения.Получить("barcode");
	КонецЕсли;
	Если Значения.Получить("brand") <> Неопределено Тогда
		brand = Значения.Получить("brand");
	КонецЕсли;
	Если Значения.Получить("completedDt") <> Неопределено Тогда
		completedDt = Значения.Получить("completedDt");
	КонецЕсли;
	Если Значения.Получить("dstOfficeAddress") <> Неопределено Тогда
		dstOfficeAddress = Значения.Получить("dstOfficeAddress");
	КонецЕсли;
	Если Значения.Получить("dstOfficeId") <> Неопределено Тогда
		dstOfficeId = Значения.Получить("dstOfficeId");
	КонецЕсли;
	Если Значения.Получить("expiredDt") <> Неопределено Тогда
		expiredDt = Значения.Получить("expiredDt");
	КонецЕсли;
	Если Значения.Получить("isStatusActive") <> Неопределено Тогда
		isStatusActive = Значения.Получить("isStatusActive");
	КонецЕсли;
	Если Значения.Получить("nmId") <> Неопределено Тогда
		nmId = Значения.Получить("nmId");
	КонецЕсли;
	Если Значения.Получить("orderDt") <> Неопределено Тогда
		orderDt = Значения.Получить("orderDt");
	КонецЕсли;
	Если Значения.Получить("orderId") <> Неопределено Тогда
		orderId = Значения.Получить("orderId");
	КонецЕсли;
	Если Значения.Получить("readyToReturnDt") <> Неопределено Тогда
		readyToReturnDt = Значения.Получить("readyToReturnDt");
	КонецЕсли;
	Если Значения.Получить("reason") <> Неопределено Тогда
		reason = Значения.Получить("reason");
	КонецЕсли;
	Если Значения.Получить("returnType") <> Неопределено Тогда
		returnType = Значения.Получить("returnType");
	КонецЕсли;
	Если Значения.Получить("shkId") <> Неопределено Тогда
		shkId = Значения.Получить("shkId");
	КонецЕсли;
	Если Значения.Получить("srid") <> Неопределено Тогда
		srid = Значения.Получить("srid");
	КонецЕсли;
	Если Значения.Получить("status") <> Неопределено Тогда
		status = Значения.Получить("status");
	КонецЕсли;
	Если Значения.Получить("stickerId") <> Неопределено Тогда
		stickerId = Значения.Получить("stickerId");
	КонецЕсли;
	Если Значения.Получить("subjectName") <> Неопределено Тогда
		subjectName = Значения.Получить("subjectName");
	КонецЕсли;
	Если Значения.Получить("techSize") <> Неопределено Тогда
		techSize = Значения.Получить("techSize");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если barcode <> Неопределено Тогда
		Результат.Вставить("barcode", ЗначениеДляJSON(barcode));
	КонецЕсли;
	Если brand <> Неопределено Тогда
		Результат.Вставить("brand", ЗначениеДляJSON(brand));
	КонецЕсли;
	Если completedDt <> Неопределено Тогда
		Результат.Вставить("completedDt", ЗначениеДляJSON(completedDt));
	КонецЕсли;
	Если dstOfficeAddress <> Неопределено Тогда
		Результат.Вставить("dstOfficeAddress", ЗначениеДляJSON(dstOfficeAddress));
	КонецЕсли;
	Если dstOfficeId <> Неопределено Тогда
		Результат.Вставить("dstOfficeId", ЗначениеДляJSON(dstOfficeId));
	КонецЕсли;
	Если expiredDt <> Неопределено Тогда
		Результат.Вставить("expiredDt", ЗначениеДляJSON(expiredDt));
	КонецЕсли;
	Если isStatusActive <> Неопределено Тогда
		Результат.Вставить("isStatusActive", ЗначениеДляJSON(isStatusActive));
	КонецЕсли;
	Если nmId <> Неопределено Тогда
		Результат.Вставить("nmId", ЗначениеДляJSON(nmId));
	КонецЕсли;
	Если orderDt <> Неопределено Тогда
		Результат.Вставить("orderDt", ЗначениеДляJSON(orderDt));
	КонецЕсли;
	Если orderId <> Неопределено Тогда
		Результат.Вставить("orderId", ЗначениеДляJSON(orderId));
	КонецЕсли;
	Если readyToReturnDt <> Неопределено Тогда
		Результат.Вставить("readyToReturnDt", ЗначениеДляJSON(readyToReturnDt));
	КонецЕсли;
	Если reason <> Неопределено Тогда
		Результат.Вставить("reason", ЗначениеДляJSON(reason));
	КонецЕсли;
	Если returnType <> Неопределено Тогда
		Результат.Вставить("returnType", ЗначениеДляJSON(returnType));
	КонецЕсли;
	Если shkId <> Неопределено Тогда
		Результат.Вставить("shkId", ЗначениеДляJSON(shkId));
	КонецЕсли;
	Если srid <> Неопределено Тогда
		Результат.Вставить("srid", ЗначениеДляJSON(srid));
	КонецЕсли;
	Если status <> Неопределено Тогда
		Результат.Вставить("status", ЗначениеДляJSON(status));
	КонецЕсли;
	Если stickerId <> Неопределено Тогда
		Результат.Вставить("stickerId", ЗначениеДляJSON(stickerId));
	КонецЕсли;
	Если subjectName <> Неопределено Тогда
		Результат.Вставить("subjectName", ЗначениеДляJSON(subjectName));
	КонецЕсли;
	Если techSize <> Неопределено Тогда
		Результат.Вставить("techSize", ЗначениеДляJSON(techSize));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

