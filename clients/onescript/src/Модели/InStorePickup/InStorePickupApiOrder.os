// InStorePickupApiOrder
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// article - Строка - Артикул продавца
Перем article Экспорт;

// cargoType - Число - Тип товара: - `1` — малогабаритный товар (МГТ) - `2` — сверхгабаритный товар (СГТ) - `3` — крупногабаритный товар (КГТ+)
Перем cargoType Экспорт;

// chrtId - Число - ID размера товара в системе WB
Перем chrtId Экспорт;

// createdAt - Дата - Дата и время создания сборочного задания
Перем createdAt Экспорт;

// price - Число - Цена в валюте продажи с учетом всех скидок, кроме скидки по WB Кошельку, умноженная на 100. Код валюты продажи указан в поле `currencyCode`. Предоставляется в и…
Перем price Экспорт;

// finalPrice - Число - Сумма к оплате покупателем в валюте продажи с учётом всех скидок, умноженная на 100. Код валюты продажи указан в поле `currencyCode`. Предоставляется в информац…
Перем finalPrice Экспорт;

// convertedPrice - Число - Цена в валюте страны продавца с учетом всех скидок, кроме скидки по WB Кошельку, умноженная на 100. Код валюты продажи указан в поле `currencyCode`. Предоставля…
Перем convertedPrice Экспорт;

// convertedFinalPrice - Число - Сумма к оплате покупателем в валюте страны продавца с учетом всех скидок, умноженная на 100. Предоставляется в информационных целях. Используйте значение поля `…
Перем convertedFinalPrice Экспорт;

// currencyCode - Число - Код валюты продажи
Перем currencyCode Экспорт;

// convertedCurrencyCode - Число - Код валюты страны продавца
Перем convertedCurrencyCode Экспорт;

// id - Число - ID сборочного задания
Перем id Экспорт;

// isZeroOrder - Булево - Признак заказа товара с нулевым остатком: - `false` — заказ сделан на товар с ненулевым остатком - `true` — заказ сделан на товар с нулевым остатком. Такой зака…
Перем isZeroOrder Экспорт;

// nmId - Число - Артикул WB
Перем nmId Экспорт;

// orderCode - Строка - Уникальный ID заказа покупателя
Перем orderCode Экспорт;

// payMode - Строка - Режим оплаты: - `prepaid` — предоплатный - `postpaid` — постоплатный - `unknown` — неизвестный
Перем payMode Экспорт;

// rid - Строка - Уникальный ID заказа. Примечание: `rid` — это `srid` в ответах методов: - [Заявки покупателей на возврат](./customer-communication#tag/buyersReturns/operation/g…
Перем rid Экспорт;

// skus - Массив - Массив баркодов товара
Перем skus Экспорт;

// warehouseAddress - Строка - Адрес магазина (склада продавца), на который поступило сборочное задание
Перем warehouseAddress Экспорт;

// warehouseId - Число - ID склада продавца, на который поступило сборочное задание
Перем warehouseId Экспорт;

// tireService - Булево - Указал ли покупатель, что ему требуется услуга шиномонтажа: - `false` — нет, услуга шиномонтажа не требуется - `true` — да, услуга шиномонтажа требуется
Перем tireService Экспорт;

// options - api_Order_options
Перем options Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("article") <> Неопределено Тогда
		article = Значения.Получить("article");
	КонецЕсли;
	Если Значения.Получить("cargoType") <> Неопределено Тогда
		cargoType = Значения.Получить("cargoType");
	КонецЕсли;
	Если Значения.Получить("chrtId") <> Неопределено Тогда
		chrtId = Значения.Получить("chrtId");
	КонецЕсли;
	Если Значения.Получить("createdAt") <> Неопределено Тогда
		createdAt = Значения.Получить("createdAt");
	КонецЕсли;
	Если Значения.Получить("price") <> Неопределено Тогда
		price = Значения.Получить("price");
	КонецЕсли;
	Если Значения.Получить("finalPrice") <> Неопределено Тогда
		finalPrice = Значения.Получить("finalPrice");
	КонецЕсли;
	Если Значения.Получить("convertedPrice") <> Неопределено Тогда
		convertedPrice = Значения.Получить("convertedPrice");
	КонецЕсли;
	Если Значения.Получить("convertedFinalPrice") <> Неопределено Тогда
		convertedFinalPrice = Значения.Получить("convertedFinalPrice");
	КонецЕсли;
	Если Значения.Получить("currencyCode") <> Неопределено Тогда
		currencyCode = Значения.Получить("currencyCode");
	КонецЕсли;
	Если Значения.Получить("convertedCurrencyCode") <> Неопределено Тогда
		convertedCurrencyCode = Значения.Получить("convertedCurrencyCode");
	КонецЕсли;
	Если Значения.Получить("id") <> Неопределено Тогда
		id = Значения.Получить("id");
	КонецЕсли;
	Если Значения.Получить("isZeroOrder") <> Неопределено Тогда
		isZeroOrder = Значения.Получить("isZeroOrder");
	КонецЕсли;
	Если Значения.Получить("nmId") <> Неопределено Тогда
		nmId = Значения.Получить("nmId");
	КонецЕсли;
	Если Значения.Получить("orderCode") <> Неопределено Тогда
		orderCode = Значения.Получить("orderCode");
	КонецЕсли;
	Если Значения.Получить("payMode") <> Неопределено Тогда
		payMode = Значения.Получить("payMode");
	КонецЕсли;
	Если Значения.Получить("rid") <> Неопределено Тогда
		rid = Значения.Получить("rid");
	КонецЕсли;
	Если Значения.Получить("skus") <> Неопределено Тогда
		skus = Значения.Получить("skus");
	КонецЕсли;
	Если Значения.Получить("warehouseAddress") <> Неопределено Тогда
		warehouseAddress = Значения.Получить("warehouseAddress");
	КонецЕсли;
	Если Значения.Получить("warehouseId") <> Неопределено Тогда
		warehouseId = Значения.Получить("warehouseId");
	КонецЕсли;
	Если Значения.Получить("tireService") <> Неопределено Тогда
		tireService = Значения.Получить("tireService");
	КонецЕсли;
	Если Значения.Получить("options") <> Неопределено Тогда
		options = Значения.Получить("options");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если article <> Неопределено Тогда
		Результат.Вставить("article", ЗначениеДляJSON(article));
	КонецЕсли;
	Если cargoType <> Неопределено Тогда
		Результат.Вставить("cargoType", ЗначениеДляJSON(cargoType));
	КонецЕсли;
	Если chrtId <> Неопределено Тогда
		Результат.Вставить("chrtId", ЗначениеДляJSON(chrtId));
	КонецЕсли;
	Если createdAt <> Неопределено Тогда
		Результат.Вставить("createdAt", ЗначениеДляJSON(createdAt));
	КонецЕсли;
	Если price <> Неопределено Тогда
		Результат.Вставить("price", ЗначениеДляJSON(price));
	КонецЕсли;
	Если finalPrice <> Неопределено Тогда
		Результат.Вставить("finalPrice", ЗначениеДляJSON(finalPrice));
	КонецЕсли;
	Если convertedPrice <> Неопределено Тогда
		Результат.Вставить("convertedPrice", ЗначениеДляJSON(convertedPrice));
	КонецЕсли;
	Если convertedFinalPrice <> Неопределено Тогда
		Результат.Вставить("convertedFinalPrice", ЗначениеДляJSON(convertedFinalPrice));
	КонецЕсли;
	Если currencyCode <> Неопределено Тогда
		Результат.Вставить("currencyCode", ЗначениеДляJSON(currencyCode));
	КонецЕсли;
	Если convertedCurrencyCode <> Неопределено Тогда
		Результат.Вставить("convertedCurrencyCode", ЗначениеДляJSON(convertedCurrencyCode));
	КонецЕсли;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Если isZeroOrder <> Неопределено Тогда
		Результат.Вставить("isZeroOrder", ЗначениеДляJSON(isZeroOrder));
	КонецЕсли;
	Если nmId <> Неопределено Тогда
		Результат.Вставить("nmId", ЗначениеДляJSON(nmId));
	КонецЕсли;
	Если orderCode <> Неопределено Тогда
		Результат.Вставить("orderCode", ЗначениеДляJSON(orderCode));
	КонецЕсли;
	Если payMode <> Неопределено Тогда
		Результат.Вставить("payMode", ЗначениеДляJSON(payMode));
	КонецЕсли;
	Если rid <> Неопределено Тогда
		Результат.Вставить("rid", ЗначениеДляJSON(rid));
	КонецЕсли;
	Если skus <> Неопределено Тогда
		Результат.Вставить("skus", ЗначениеДляJSON(skus));
	КонецЕсли;
	Если warehouseAddress <> Неопределено Тогда
		Результат.Вставить("warehouseAddress", ЗначениеДляJSON(warehouseAddress));
	КонецЕсли;
	Если warehouseId <> Неопределено Тогда
		Результат.Вставить("warehouseId", ЗначениеДляJSON(warehouseId));
	КонецЕсли;
	Если tireService <> Неопределено Тогда
		Результат.Вставить("tireService", ЗначениеДляJSON(tireService));
	КонецЕсли;
	Если options <> Неопределено Тогда
		Результат.Вставить("options", ЗначениеДляJSON(options));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

