// ItemsWholesaleDiscountThresholdRes
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// minQuantity - Число - Минимальное количество единиц товара для скидки
Перем minQuantity Экспорт;

// wholesaleDiscount - Число - Скидка, %
Перем wholesaleDiscount Экспорт;

// level - Число - Уровень скидки
Перем level Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("minQuantity") <> Неопределено Тогда
		minQuantity = Значения.Получить("minQuantity");
	КонецЕсли;
	Если Значения.Получить("wholesaleDiscount") <> Неопределено Тогда
		wholesaleDiscount = Значения.Получить("wholesaleDiscount");
	КонецЕсли;
	Если Значения.Получить("level") <> Неопределено Тогда
		level = Значения.Получить("level");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если minQuantity <> Неопределено Тогда
		Результат.Вставить("minQuantity", ЗначениеДляJSON(minQuantity));
	КонецЕсли;
	Если wholesaleDiscount <> Неопределено Тогда
		Результат.Вставить("wholesaleDiscount", ЗначениеДляJSON(wholesaleDiscount));
	КонецЕсли;
	Если level <> Неопределено Тогда
		Результат.Вставить("level", ЗначениеДляJSON(level));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

