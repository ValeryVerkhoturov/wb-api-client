// ItemsPostV2CardsUpdateRequestInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// nmID - Число - Артикул WB
Перем nmID Экспорт;

// vendorCode - Строка - Артикул продавца
Перем vendorCode Экспорт;

// kizMarked - Булево - Подтверждение, что на товар нанесён обязательный код маркировки [Честного знака](https://честныйзнак.рф/): - `true` — продавец подтверждает, что на товар нанесё…
Перем kizMarked Экспорт;

// brand - Строка - Бренд
Перем brand Экспорт;

// title - Строка - Наименование товара
Перем title Экспорт;

// description - Строка - Описание товара. Максимальное количество символов зависит от категории товара Стандарт — 2000, минимум — 1000, максимум — 5000 Подробно о \\*\\*правилах заполне…
Перем description Экспорт;

// dimensions - postV2CardsUpdate_request_inner_dimensions
Перем dimensions Экспорт;

// documents - postV2CardsUpdate_request_inner_documents
Перем documents Экспорт;

// characteristics - Массив - Характеристики товара. Можно получить методом [Характеристики предмета](./item-management#tag/categoriesSubcategoriesAndCharacteristics/operation/getV2ObjectCha…
Перем characteristics Экспорт;

// sizes - Массив - Массив размеров Для безразмерного товара всё равно нужно передавать данный массив без параметров (wbSize и techSize), но с баркодом
Перем sizes Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("nmID") <> Неопределено Тогда
		nmID = Значения.Получить("nmID");
	КонецЕсли;
	Если Значения.Получить("vendorCode") <> Неопределено Тогда
		vendorCode = Значения.Получить("vendorCode");
	КонецЕсли;
	Если Значения.Получить("kizMarked") <> Неопределено Тогда
		kizMarked = Значения.Получить("kizMarked");
	КонецЕсли;
	Если Значения.Получить("brand") <> Неопределено Тогда
		brand = Значения.Получить("brand");
	КонецЕсли;
	Если Значения.Получить("title") <> Неопределено Тогда
		title = Значения.Получить("title");
	КонецЕсли;
	Если Значения.Получить("description") <> Неопределено Тогда
		description = Значения.Получить("description");
	КонецЕсли;
	Если Значения.Получить("dimensions") <> Неопределено Тогда
		dimensions = Значения.Получить("dimensions");
	КонецЕсли;
	Если Значения.Получить("documents") <> Неопределено Тогда
		documents = Значения.Получить("documents");
	КонецЕсли;
	Если Значения.Получить("characteristics") <> Неопределено Тогда
		characteristics = Значения.Получить("characteristics");
	КонецЕсли;
	Если Значения.Получить("sizes") <> Неопределено Тогда
		sizes = Значения.Получить("sizes");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если nmID <> Неопределено Тогда
		Результат.Вставить("nmID", ЗначениеДляJSON(nmID));
	КонецЕсли;
	Если vendorCode <> Неопределено Тогда
		Результат.Вставить("vendorCode", ЗначениеДляJSON(vendorCode));
	КонецЕсли;
	Если kizMarked <> Неопределено Тогда
		Результат.Вставить("kizMarked", ЗначениеДляJSON(kizMarked));
	КонецЕсли;
	Если brand <> Неопределено Тогда
		Результат.Вставить("brand", ЗначениеДляJSON(brand));
	КонецЕсли;
	Если title <> Неопределено Тогда
		Результат.Вставить("title", ЗначениеДляJSON(title));
	КонецЕсли;
	Если description <> Неопределено Тогда
		Результат.Вставить("description", ЗначениеДляJSON(description));
	КонецЕсли;
	Если dimensions <> Неопределено Тогда
		Результат.Вставить("dimensions", ЗначениеДляJSON(dimensions));
	КонецЕсли;
	Если documents <> Неопределено Тогда
		Результат.Вставить("documents", ЗначениеДляJSON(documents));
	КонецЕсли;
	Если characteristics <> Неопределено Тогда
		Результат.Вставить("characteristics", ЗначениеДляJSON(characteristics));
	КонецЕсли;
	Если sizes <> Неопределено Тогда
		Результат.Вставить("sizes", ЗначениеДляJSON(sizes));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

