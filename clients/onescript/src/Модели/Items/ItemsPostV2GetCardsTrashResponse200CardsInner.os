	Если Значения.Получить("subjectID") <> Неопределено Тогда
		subjectID = Значения.Получить("subjectID");
	КонецЕсли;
	Если Значения.Получить("subjectName") <> Неопределено Тогда
		subjectName = Значения.Получить("subjectName");
	КонецЕсли;
	Если Значения.Получить("photos") <> Неопределено Тогда
		photos = Значения.Получить("photos");
	КонецЕсли;
	Если Значения.Получить("video") <> Неопределено Тогда
		video = Значения.Получить("video");
	КонецЕсли;
	Если Значения.Получить("wholesale") <> Неопределено Тогда
		wholesale = Значения.Получить("wholesale");
	КонецЕсли;
	Если Значения.Получить("sizes") <> Неопределено Тогда
		sizes = Значения.Получить("sizes");
	КонецЕсли;
	Если Значения.Получить("dimensions") <> Неопределено Тогда
		dimensions = Значения.Получить("dimensions");
	КонецЕсли;
	Если Значения.Получить("characteristics") <> Неопределено Тогда
		characteristics = Значения.Получить("characteristics");
	КонецЕсли;
	Если Значения.Получить("createdAt") <> Неопределено Тогда
		createdAt = Значения.Получить("createdAt");
