// ItemsPostV2GetCardsListRequestSettingsFilter
//
// Параметры фильтрации
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// withPhoto - Число - Фильтр по фото: * `-1` — любые карточки товаров * `0` — только карточки без фото. С [16 июня](https://dev.wildberries.ru/release-notes?id=531) — любые карточки…
Перем withPhoto Экспорт;

// textSearch - Строка - Поиск по артикулу продавца, артикулу WB, баркоду
Перем textSearch Экспорт;

// tagIDs - Массив - Поиск по ID ярлыков
Перем tagIDs Экспорт;

// allowedCategoriesOnly - Булево - Фильтр по категории: - `true` — только разрешённые - `false` — все Не используется в песочнице
Перем allowedCategoriesOnly Экспорт;

// objectIDs - Массив - Поиск по ID предметов
Перем objectIDs Экспорт;

// brands - Массив - Поиск по брендам
Перем brands Экспорт;

// imtID - Число - Поиск по [ID для объединённых карточек товаров](https://dev.wildberries.ru/knowledge-base/articles/019d49a4-1320-71bb-9dac-8ba07e7177ce/rabota-s-tovarami#obuedi…
Перем imtID Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("withPhoto") <> Неопределено Тогда
		withPhoto = Значения.Получить("withPhoto");
	КонецЕсли;
	Если Значения.Получить("textSearch") <> Неопределено Тогда
		textSearch = Значения.Получить("textSearch");
	КонецЕсли;
	Если Значения.Получить("tagIDs") <> Неопределено Тогда
		tagIDs = Значения.Получить("tagIDs");
	КонецЕсли;
	Если Значения.Получить("allowedCategoriesOnly") <> Неопределено Тогда
		allowedCategoriesOnly = Значения.Получить("allowedCategoriesOnly");
	КонецЕсли;
	Если Значения.Получить("objectIDs") <> Неопределено Тогда
		objectIDs = Значения.Получить("objectIDs");
	КонецЕсли;
	Если Значения.Получить("brands") <> Неопределено Тогда
		brands = Значения.Получить("brands");
	КонецЕсли;
	Если Значения.Получить("imtID") <> Неопределено Тогда
		imtID = Значения.Получить("imtID");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если withPhoto <> Неопределено Тогда
		Результат.Вставить("withPhoto", ЗначениеДляJSON(withPhoto));
	КонецЕсли;
	Если textSearch <> Неопределено Тогда
		Результат.Вставить("textSearch", ЗначениеДляJSON(textSearch));
	КонецЕсли;
	Если tagIDs <> Неопределено Тогда
		Результат.Вставить("tagIDs", ЗначениеДляJSON(tagIDs));
	КонецЕсли;
	Если allowedCategoriesOnly <> Неопределено Тогда
		Результат.Вставить("allowedCategoriesOnly", ЗначениеДляJSON(allowedCategoriesOnly));
	КонецЕсли;
	Если objectIDs <> Неопределено Тогда
		Результат.Вставить("objectIDs", ЗначениеДляJSON(objectIDs));
	КонецЕсли;
	Если brands <> Неопределено Тогда
		Результат.Вставить("brands", ЗначениеДляJSON(brands));
	КонецЕсли;
	Если imtID <> Неопределено Тогда
		Результат.Вставить("imtID", ЗначениеДляJSON(imtID));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

