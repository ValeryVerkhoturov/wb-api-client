// ItemsSellerTaskMetadataBuffer
//
// Данные ответа
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// uploadID - Число - ID загрузки
Перем uploadID Экспорт;

// status - Число - Статус загрузки: `1` — в обработке
Перем status Экспорт;

// uploadDate - Дата - Дата и время, когда загрузка создана
Перем uploadDate Экспорт;

// activationDate - Дата - Дата и время, когда загрузка отправляется в обработку
Перем activationDate Экспорт;

// overAllGoodsNumber - Число - Всего товаров
Перем overAllGoodsNumber Экспорт;

// successGoodsNumber - Число - Товаров без ошибок (0, потому что загрузка в обработке)
Перем successGoodsNumber Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("uploadID") <> Неопределено Тогда
		uploadID = Значения.Получить("uploadID");
	КонецЕсли;
	Если Значения.Получить("status") <> Неопределено Тогда
		status = Значения.Получить("status");
	КонецЕсли;
	Если Значения.Получить("uploadDate") <> Неопределено Тогда
		uploadDate = Значения.Получить("uploadDate");
	КонецЕсли;
	Если Значения.Получить("activationDate") <> Неопределено Тогда
		activationDate = Значения.Получить("activationDate");
	КонецЕсли;
	Если Значения.Получить("overAllGoodsNumber") <> Неопределено Тогда
		overAllGoodsNumber = Значения.Получить("overAllGoodsNumber");
	КонецЕсли;
	Если Значения.Получить("successGoodsNumber") <> Неопределено Тогда
		successGoodsNumber = Значения.Получить("successGoodsNumber");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если uploadID <> Неопределено Тогда
		Результат.Вставить("uploadID", ЗначениеДляJSON(uploadID));
	КонецЕсли;
	Если status <> Неопределено Тогда
		Результат.Вставить("status", ЗначениеДляJSON(status));
	КонецЕсли;
	Если uploadDate <> Неопределено Тогда
		Результат.Вставить("uploadDate", ЗначениеДляJSON(uploadDate));
	КонецЕсли;
	Если activationDate <> Неопределено Тогда
		Результат.Вставить("activationDate", ЗначениеДляJSON(activationDate));
	КонецЕсли;
	Если overAllGoodsNumber <> Неопределено Тогда
		Результат.Вставить("overAllGoodsNumber", ЗначениеДляJSON(overAllGoodsNumber));
	КонецЕсли;
	Если successGoodsNumber <> Неопределено Тогда
		Результат.Вставить("successGoodsNumber", ЗначениеДляJSON(successGoodsNumber));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

