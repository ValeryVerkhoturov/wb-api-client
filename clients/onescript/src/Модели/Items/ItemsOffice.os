// ItemsOffice
//
// Данные о складе WB
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// address - Строка - Адрес
Перем address Экспорт;

// name - Строка - Название
Перем name Экспорт;

// city - Строка - Город
Перем city Экспорт;

// id - Число - ID
Перем id Экспорт;

// longitude - Число - Долгота
Перем longitude Экспорт;

// latitude - Число - Широта
Перем latitude Экспорт;

// cargoType - Число - Тип товара, который принимает склад: - `1` — малогабаритный товар (МГТ) - `3` — крупногабаритный товар (КГТ+)
Перем cargoType Экспорт;

// deliveryType - Число - Тип доставки, который принимает склад: - `1` — доставка на склад WB (FBS) - `2` — доставка силами продавца (DBS) - `3` — Деливери WB (DBW) - `5` — самовывоз (C&…
Перем deliveryType Экспорт;

// federalDistrict - Строка - Федеральный округ склада WB. Если `null`, склад находится за пределами РФ или федеральный округ не указан
Перем federalDistrict Экспорт;

// selected - Булево - Признак того, что склад уже выбран продавцом
Перем selected Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("address") <> Неопределено Тогда
		address = Значения.Получить("address");
	КонецЕсли;
	Если Значения.Получить("name") <> Неопределено Тогда
		name = Значения.Получить("name");
	КонецЕсли;
	Если Значения.Получить("city") <> Неопределено Тогда
		city = Значения.Получить("city");
	КонецЕсли;
	Если Значения.Получить("id") <> Неопределено Тогда
		id = Значения.Получить("id");
	КонецЕсли;
	Если Значения.Получить("longitude") <> Неопределено Тогда
		longitude = Значения.Получить("longitude");
	КонецЕсли;
	Если Значения.Получить("latitude") <> Неопределено Тогда
		latitude = Значения.Получить("latitude");
	КонецЕсли;
	Если Значения.Получить("cargoType") <> Неопределено Тогда
		cargoType = Значения.Получить("cargoType");
	КонецЕсли;
	Если Значения.Получить("deliveryType") <> Неопределено Тогда
		deliveryType = Значения.Получить("deliveryType");
	КонецЕсли;
	Если Значения.Получить("federalDistrict") <> Неопределено Тогда
		federalDistrict = Значения.Получить("federalDistrict");
	КонецЕсли;
	Если Значения.Получить("selected") <> Неопределено Тогда
		selected = Значения.Получить("selected");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если address <> Неопределено Тогда
		Результат.Вставить("address", ЗначениеДляJSON(address));
	КонецЕсли;
	Если name <> Неопределено Тогда
		Результат.Вставить("name", ЗначениеДляJSON(name));
	КонецЕсли;
	Если city <> Неопределено Тогда
		Результат.Вставить("city", ЗначениеДляJSON(city));
	КонецЕсли;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Если longitude <> Неопределено Тогда
		Результат.Вставить("longitude", ЗначениеДляJSON(longitude));
	КонецЕсли;
	Если latitude <> Неопределено Тогда
		Результат.Вставить("latitude", ЗначениеДляJSON(latitude));
	КонецЕсли;
	Если cargoType <> Неопределено Тогда
		Результат.Вставить("cargoType", ЗначениеДляJSON(cargoType));
	КонецЕсли;
	Если deliveryType <> Неопределено Тогда
		Результат.Вставить("deliveryType", ЗначениеДляJSON(deliveryType));
	КонецЕсли;
	Если federalDistrict <> Неопределено Тогда
		Результат.Вставить("federalDistrict", ЗначениеДляJSON(federalDistrict));
	КонецЕсли;
	Если selected <> Неопределено Тогда
		Результат.Вставить("selected", ЗначениеДляJSON(selected));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

