// ItemsDocumentsRequest
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// type - Число - Тип документа: - `1` — Сертификат соответствия - `2` — Декларация о соответствии - `3` — Свидетельство о государственной регистрации (СГР) - `4` — Регистрационн…
Перем type Экспорт;

// number - Строка - Номер документа
Перем number Экспорт;

// productNumber - Строка - Дополнительный номер документа
Перем productNumber Экспорт;

// tradeName - Строка - Торговое наименование
Перем tradeName Экспорт;

// applicant - Строка - Представитель изготовителя медицинского изделия
Перем applicant Экспорт;

// startDate - Дата - Дата и время начала срока действия документа
Перем startDate Экспорт;

// endDate - Дата - Дата и время окончания срока действия документа
Перем endDate Экспорт;

// isEndless - Булево - Бессрочный ли документ: - `true` — да, документ бессрочный - `false` — нет, у документа есть срок действия
Перем isEndless Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("type") <> Неопределено Тогда
		type = Значения.Получить("type");
	КонецЕсли;
	Если Значения.Получить("number") <> Неопределено Тогда
		number = Значения.Получить("number");
	КонецЕсли;
	Если Значения.Получить("productNumber") <> Неопределено Тогда
		productNumber = Значения.Получить("productNumber");
	КонецЕсли;
	Если Значения.Получить("tradeName") <> Неопределено Тогда
		tradeName = Значения.Получить("tradeName");
	КонецЕсли;
	Если Значения.Получить("applicant") <> Неопределено Тогда
		applicant = Значения.Получить("applicant");
	КонецЕсли;
	Если Значения.Получить("startDate") <> Неопределено Тогда
		startDate = Значения.Получить("startDate");
	КонецЕсли;
	Если Значения.Получить("endDate") <> Неопределено Тогда
		endDate = Значения.Получить("endDate");
	КонецЕсли;
	Если Значения.Получить("isEndless") <> Неопределено Тогда
		isEndless = Значения.Получить("isEndless");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если type <> Неопределено Тогда
		Результат.Вставить("type", ЗначениеДляJSON(type));
	КонецЕсли;
	Если number <> Неопределено Тогда
		Результат.Вставить("number", ЗначениеДляJSON(number));
	КонецЕсли;
	Если productNumber <> Неопределено Тогда
		Результат.Вставить("productNumber", ЗначениеДляJSON(productNumber));
	КонецЕсли;
	Если tradeName <> Неопределено Тогда
		Результат.Вставить("tradeName", ЗначениеДляJSON(tradeName));
	КонецЕсли;
	Если applicant <> Неопределено Тогда
		Результат.Вставить("applicant", ЗначениеДляJSON(applicant));
	КонецЕсли;
	Если startDate <> Неопределено Тогда
		Результат.Вставить("startDate", ЗначениеДляJSON(startDate));
	КонецЕсли;
	Если endDate <> Неопределено Тогда
		Результат.Вставить("endDate", ЗначениеДляJSON(endDate));
	КонецЕсли;
	Если isEndless <> Неопределено Тогда
		Результат.Вставить("isEndless", ЗначениеДляJSON(isEndless));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

