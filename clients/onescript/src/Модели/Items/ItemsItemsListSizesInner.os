// ItemsItemsListSizesInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// sizeID - Число - ID размера. В методах Контента это поле `chrtID`
Перем sizeID Экспорт;

// price - Число - Цена
Перем price Экспорт;

// discountedPrice - Число - Цена со скидкой
Перем discountedPrice Экспорт;

// clubDiscountedPrice - Число - Цена со скидкой, включая скидку WB Клуба
Перем clubDiscountedPrice Экспорт;

// techSizeName - Строка - Размер товара
Перем techSizeName Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("sizeID") <> Неопределено Тогда
		sizeID = Значения.Получить("sizeID");
	КонецЕсли;
	Если Значения.Получить("price") <> Неопределено Тогда
		price = Значения.Получить("price");
	КонецЕсли;
	Если Значения.Получить("discountedPrice") <> Неопределено Тогда
		discountedPrice = Значения.Получить("discountedPrice");
	КонецЕсли;
	Если Значения.Получить("clubDiscountedPrice") <> Неопределено Тогда
		clubDiscountedPrice = Значения.Получить("clubDiscountedPrice");
	КонецЕсли;
	Если Значения.Получить("techSizeName") <> Неопределено Тогда
		techSizeName = Значения.Получить("techSizeName");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если sizeID <> Неопределено Тогда
		Результат.Вставить("sizeID", ЗначениеДляJSON(sizeID));
	КонецЕсли;
	Если price <> Неопределено Тогда
		Результат.Вставить("price", ЗначениеДляJSON(price));
	КонецЕсли;
	Если discountedPrice <> Неопределено Тогда
		Результат.Вставить("discountedPrice", ЗначениеДляJSON(discountedPrice));
	КонецЕсли;
	Если clubDiscountedPrice <> Неопределено Тогда
		Результат.Вставить("clubDiscountedPrice", ЗначениеДляJSON(clubDiscountedPrice));
	КонецЕсли;
	Если techSizeName <> Неопределено Тогда
		Результат.Вставить("techSizeName", ЗначениеДляJSON(techSizeName));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

