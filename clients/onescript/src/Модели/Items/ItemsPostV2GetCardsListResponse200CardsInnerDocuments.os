// ItemsPostV2GetCardsListResponse200CardsInnerDocuments
//
// Документы
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// items - Массив - Список документов
Перем items Экспорт;

// overallVerdict - PostV2GetCardsListResponse200_cards_inner_documents_overallVerdict
Перем overallVerdict Экспорт;

// excludeDocuments - Булево - Исключены ли документы из проверки карточки товара: - `true` — да, документы не проверяются при проверке карточки - `false` — нет, документы проверяются при про…
Перем excludeDocuments Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("items") <> Неопределено Тогда
		items = Значения.Получить("items");
	КонецЕсли;
	Если Значения.Получить("overallVerdict") <> Неопределено Тогда
		overallVerdict = Значения.Получить("overallVerdict");
	КонецЕсли;
	Если Значения.Получить("excludeDocuments") <> Неопределено Тогда
		excludeDocuments = Значения.Получить("excludeDocuments");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если items <> Неопределено Тогда
		Результат.Вставить("items", ЗначениеДляJSON(items));
	КонецЕсли;
	Если overallVerdict <> Неопределено Тогда
		Результат.Вставить("overallVerdict", ЗначениеДляJSON(overallVerdict));
	КонецЕсли;
	Если excludeDocuments <> Неопределено Тогда
		Результат.Вставить("excludeDocuments", ЗначениеДляJSON(excludeDocuments));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

