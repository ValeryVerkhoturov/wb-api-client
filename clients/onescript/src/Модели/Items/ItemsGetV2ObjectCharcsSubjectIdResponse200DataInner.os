		popular = Значения.Получить("popular");
	КонецЕсли;
	Если Значения.Получить("charcType") <> Неопределено Тогда
		charcType = Значения.Получить("charcType");
	КонецЕсли;
	Если Значения.Получить("hasFilter") <> Неопределено Тогда
		hasFilter = Значения.Получить("hasFilter");
	КонецЕсли;
