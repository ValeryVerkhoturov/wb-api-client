// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если charcID <> Неопределено Тогда
		Результат.Вставить("charcID", ЗначениеДляJSON(charcID));
	КонецЕсли;
	Если subjectName <> Неопределено Тогда
		Результат.Вставить("subjectName", ЗначениеДляJSON(subjectName));
	КонецЕсли;
	Если subjectID <> Неопределено Тогда
		Результат.Вставить("subjectID", ЗначениеДляJSON(subjectID));
	КонецЕсли;
	Если name <> Неопределено Тогда
		Результат.Вставить("name", ЗначениеДляJSON(name));
	КонецЕсли;
	Если required <> Неопределено Тогда
		Результат.Вставить("required", ЗначениеДляJSON(required));
	КонецЕсли;
	Если unitName <> Неопределено Тогда
		Результат.Вставить("unitName", ЗначениеДляJSON(unitName));
	КонецЕсли;
	Если maxCount <> Неопределено Тогда
		Результат.Вставить("maxCount", ЗначениеДляJSON(maxCount));
	КонецЕсли;
	Если popular <> Неопределено Тогда
		Результат.Вставить("popular", ЗначениеДляJSON(popular));
	КонецЕсли;
	Если charcType <> Неопределено Тогда
		Результат.Вставить("charcType", ЗначениеДляJSON(charcType));
	КонецЕсли;
	Если hasFilter <> Неопределено Тогда
		Результат.Вставить("hasFilter", ЗначениеДляJSON(hasFilter));
	КонецЕсли;
	Если isVariable <> Неопределено Тогда
		Результат.Вставить("isVariable", ЗначениеДляJSON(isVariable));
	КонецЕсли;
	Если existNamedField <> Неопределено Тогда
		Результат.Вставить("existNamedField", ЗначениеДляJSON(existNamedField));
	КонецЕсли;
	Возврат Результат;

