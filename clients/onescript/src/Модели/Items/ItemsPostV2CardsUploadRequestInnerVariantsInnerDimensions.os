// ItemsPostV2CardsUploadRequestInnerVariantsInnerDimensions
//
// Габариты и вес товара \\*\\*c упаковкой\\*\\*.
// Укажите в `сантиметрах` и `килограммах` для любого товара.
// Если данные не указаны, автоматически сгенерируются нулевые значения длины, ширины, высоты и веса.
// Синхронизация данных новой карточки с сервисом может занимать до 30 минут
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// length - Число - Длина, см
Перем length Экспорт;

// width - Число - Ширина, см
Перем width Экспорт;

// height - Число - Высота, см
Перем height Экспорт;

// weightBrutto - Число - Вес, кг Количество знаков после запятой <=3
Перем weightBrutto Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("length") <> Неопределено Тогда
		length = Значения.Получить("length");
	КонецЕсли;
	Если Значения.Получить("width") <> Неопределено Тогда
		width = Значения.Получить("width");
	КонецЕсли;
	Если Значения.Получить("height") <> Неопределено Тогда
		height = Значения.Получить("height");
	КонецЕсли;
	Если Значения.Получить("weightBrutto") <> Неопределено Тогда
		weightBrutto = Значения.Получить("weightBrutto");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если length <> Неопределено Тогда
		Результат.Вставить("length", ЗначениеДляJSON(length));
	КонецЕсли;
	Если width <> Неопределено Тогда
		Результат.Вставить("width", ЗначениеДляJSON(width));
	КонецЕсли;
	Если height <> Неопределено Тогда
		Результат.Вставить("height", ЗначениеДляJSON(height));
	КонецЕсли;
	Если weightBrutto <> Неопределено Тогда
		Результат.Вставить("weightBrutto", ЗначениеДляJSON(weightBrutto));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

