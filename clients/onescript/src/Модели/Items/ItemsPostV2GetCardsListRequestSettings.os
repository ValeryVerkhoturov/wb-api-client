// ItemsPostV2GetCardsListRequestSettings
//
// Настройки
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// sort - postV2GetCardsList_request_settings_sort
Перем sort Экспорт;

// filter - postV2GetCardsList_request_settings_filter
Перем filter Экспорт;

// cursor - postV2GetCardsList_request_settings_cursor
Перем cursor Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("sort") <> Неопределено Тогда
		sort = Значения.Получить("sort");
	КонецЕсли;
	Если Значения.Получить("filter") <> Неопределено Тогда
		filter = Значения.Получить("filter");
	КонецЕсли;
	Если Значения.Получить("cursor") <> Неопределено Тогда
		cursor = Значения.Получить("cursor");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если sort <> Неопределено Тогда
		Результат.Вставить("sort", ЗначениеДляJSON(sort));
	КонецЕсли;
	Если filter <> Неопределено Тогда
		Результат.Вставить("filter", ЗначениеДляJSON(filter));
	КонецЕсли;
	Если cursor <> Неопределено Тогда
		Результат.Вставить("cursor", ЗначениеДляJSON(cursor));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

