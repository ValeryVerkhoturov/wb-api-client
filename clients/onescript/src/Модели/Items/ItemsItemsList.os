// ItemsItemsList
//
// Размеры товара
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// nmID - Число - Артикул WB
Перем nmID Экспорт;

// vendorCode - Строка - Артикул продавца
Перем vendorCode Экспорт;

// sizes - Массив - Размер
Перем sizes Экспорт;

// currencyIsoCode4217 - Строка - Валюта, по стандарту ISO 4217
Перем currencyIsoCode4217 Экспорт;

// discount - Число - Скидка, %
Перем discount Экспорт;

// clubDiscount - Число - Скидка WB Клуба, %
Перем clubDiscount Экспорт;

// editableSizePrice - Булево - Можно ли устанавливать цены отдельно для разных размеров (зависит от категории товара): - `true` — можно - `false` — нельзя
Перем editableSizePrice Экспорт;

// wholesaleDiscountThreshold - Массив - Оптовые скидки разных уровней для B2B
Перем wholesaleDiscountThreshold Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("nmID") <> Неопределено Тогда
		nmID = Значения.Получить("nmID");
	КонецЕсли;
	Если Значения.Получить("vendorCode") <> Неопределено Тогда
		vendorCode = Значения.Получить("vendorCode");
	КонецЕсли;
	Если Значения.Получить("sizes") <> Неопределено Тогда
		sizes = Значения.Получить("sizes");
	КонецЕсли;
	Если Значения.Получить("currencyIsoCode4217") <> Неопределено Тогда
		currencyIsoCode4217 = Значения.Получить("currencyIsoCode4217");
	КонецЕсли;
	Если Значения.Получить("discount") <> Неопределено Тогда
		discount = Значения.Получить("discount");
	КонецЕсли;
	Если Значения.Получить("clubDiscount") <> Неопределено Тогда
		clubDiscount = Значения.Получить("clubDiscount");
	КонецЕсли;
	Если Значения.Получить("editableSizePrice") <> Неопределено Тогда
		editableSizePrice = Значения.Получить("editableSizePrice");
	КонецЕсли;
	Если Значения.Получить("wholesaleDiscountThreshold") <> Неопределено Тогда
		wholesaleDiscountThreshold = Значения.Получить("wholesaleDiscountThreshold");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если nmID <> Неопределено Тогда
		Результат.Вставить("nmID", ЗначениеДляJSON(nmID));
	КонецЕсли;
	Если vendorCode <> Неопределено Тогда
		Результат.Вставить("vendorCode", ЗначениеДляJSON(vendorCode));
	КонецЕсли;
	Если sizes <> Неопределено Тогда
		Результат.Вставить("sizes", ЗначениеДляJSON(sizes));
	КонецЕсли;
	Если currencyIsoCode4217 <> Неопределено Тогда
		Результат.Вставить("currencyIsoCode4217", ЗначениеДляJSON(currencyIsoCode4217));
	КонецЕсли;
	Если discount <> Неопределено Тогда
		Результат.Вставить("discount", ЗначениеДляJSON(discount));
	КонецЕсли;
	Если clubDiscount <> Неопределено Тогда
		Результат.Вставить("clubDiscount", ЗначениеДляJSON(clubDiscount));
	КонецЕсли;
	Если editableSizePrice <> Неопределено Тогда
		Результат.Вставить("editableSizePrice", ЗначениеДляJSON(editableSizePrice));
	КонецЕсли;
	Если wholesaleDiscountThreshold <> Неопределено Тогда
		Результат.Вставить("wholesaleDiscountThreshold", ЗначениеДляJSON(wholesaleDiscountThreshold));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

