// ItemsQuarantineItems
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// nmID - Число - Артикул WB
Перем nmID Экспорт;

// sizeID - Число - Не используется
Перем sizeID Экспорт;

// techSizeName - Строка - Не используется
Перем techSizeName Экспорт;

// currencyIsoCode4217 - Строка - Валюта по стандарту ISO 4217
Перем currencyIsoCode4217 Экспорт;

// newPrice - Число - Новая цена продавца до скидки
Перем newPrice Экспорт;

// oldPrice - Число - Текущая цена продавца до скидки
Перем oldPrice Экспорт;

// newDiscount - Число - Новая скидка продавца, %
Перем newDiscount Экспорт;

// oldDiscount - Число - Текущая скидка продавца, %
Перем oldDiscount Экспорт;

// priceDiff - Число - Разница: `newPrice` * (1 - `newDiscount` / 100) - `oldPrice` * (1 - `oldDiscount` / 100)
Перем priceDiff Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("nmID") <> Неопределено Тогда
		nmID = Значения.Получить("nmID");
	КонецЕсли;
	Если Значения.Получить("sizeID") <> Неопределено Тогда
		sizeID = Значения.Получить("sizeID");
	КонецЕсли;
	Если Значения.Получить("techSizeName") <> Неопределено Тогда
		techSizeName = Значения.Получить("techSizeName");
	КонецЕсли;
	Если Значения.Получить("currencyIsoCode4217") <> Неопределено Тогда
		currencyIsoCode4217 = Значения.Получить("currencyIsoCode4217");
	КонецЕсли;
	Если Значения.Получить("newPrice") <> Неопределено Тогда
		newPrice = Значения.Получить("newPrice");
	КонецЕсли;
	Если Значения.Получить("oldPrice") <> Неопределено Тогда
		oldPrice = Значения.Получить("oldPrice");
	КонецЕсли;
	Если Значения.Получить("newDiscount") <> Неопределено Тогда
		newDiscount = Значения.Получить("newDiscount");
	КонецЕсли;
	Если Значения.Получить("oldDiscount") <> Неопределено Тогда
		oldDiscount = Значения.Получить("oldDiscount");
	КонецЕсли;
	Если Значения.Получить("priceDiff") <> Неопределено Тогда
		priceDiff = Значения.Получить("priceDiff");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если nmID <> Неопределено Тогда
		Результат.Вставить("nmID", ЗначениеДляJSON(nmID));
	КонецЕсли;
	Если sizeID <> Неопределено Тогда
		Результат.Вставить("sizeID", ЗначениеДляJSON(sizeID));
	КонецЕсли;
	Если techSizeName <> Неопределено Тогда
		Результат.Вставить("techSizeName", ЗначениеДляJSON(techSizeName));
	КонецЕсли;
	Если currencyIsoCode4217 <> Неопределено Тогда
		Результат.Вставить("currencyIsoCode4217", ЗначениеДляJSON(currencyIsoCode4217));
	КонецЕсли;
	Если newPrice <> Неопределено Тогда
		Результат.Вставить("newPrice", ЗначениеДляJSON(newPrice));
	КонецЕсли;
	Если oldPrice <> Неопределено Тогда
		Результат.Вставить("oldPrice", ЗначениеДляJSON(oldPrice));
	КонецЕсли;
	Если newDiscount <> Неопределено Тогда
		Результат.Вставить("newDiscount", ЗначениеДляJSON(newDiscount));
	КонецЕсли;
	Если oldDiscount <> Неопределено Тогда
		Результат.Вставить("oldDiscount", ЗначениеДляJSON(oldDiscount));
	КонецЕсли;
	Если priceDiff <> Неопределено Тогда
		Результат.Вставить("priceDiff", ЗначениеДляJSON(priceDiff));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

