// ItemsGetRecomResDataInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// nmId - Число - Артикул WB
Перем nmId Экспорт;

// imtId - Число - ID для [объединённых](https://dev.wildberries.ru/knowledge-base/articles/019d49a4-1320-71bb-9dac-8ba07e7177ce/rabota-s-tovarami#obuedinenie-i-razuedinenie-karto…
Перем imtId Экспорт;

// vendorCode - Строка - Артикул продавца
Перем vendorCode Экспорт;

// brandName - Строка - Бренд
Перем brandName Экспорт;

// updatedAt - Дата - Дата и время последнего обновления рекомендаций
Перем updatedAt Экспорт;

// picsCount - Число - Количество изображений в карточке товара
Перем picsCount Экспорт;

// title - Строка - Название товара
Перем title Экспорт;

// subjectName - Строка - Предмет
Перем subjectName Экспорт;

// pic - Строка - URL основного изображения в карточке товара
Перем pic Экспорт;

// recomCount - Число - Количество рекомендуемых товаров
Перем recomCount Экспорт;

// recomPics - Массив - Список URL основных изображений рекомендуемых товаров
Перем recomPics Экспорт;

// recomNms - Массив - Список `nmId` рекомендуемых товаров
Перем recomNms Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("nmId") <> Неопределено Тогда
		nmId = Значения.Получить("nmId");
	КонецЕсли;
	Если Значения.Получить("imtId") <> Неопределено Тогда
		imtId = Значения.Получить("imtId");
	КонецЕсли;
	Если Значения.Получить("vendorCode") <> Неопределено Тогда
		vendorCode = Значения.Получить("vendorCode");
	КонецЕсли;
	Если Значения.Получить("brandName") <> Неопределено Тогда
		brandName = Значения.Получить("brandName");
	КонецЕсли;
	Если Значения.Получить("updatedAt") <> Неопределено Тогда
		updatedAt = Значения.Получить("updatedAt");
	КонецЕсли;
	Если Значения.Получить("picsCount") <> Неопределено Тогда
		picsCount = Значения.Получить("picsCount");
	КонецЕсли;
	Если Значения.Получить("title") <> Неопределено Тогда
		title = Значения.Получить("title");
	КонецЕсли;
	Если Значения.Получить("subjectName") <> Неопределено Тогда
		subjectName = Значения.Получить("subjectName");
	КонецЕсли;
	Если Значения.Получить("pic") <> Неопределено Тогда
		pic = Значения.Получить("pic");
	КонецЕсли;
	Если Значения.Получить("recomCount") <> Неопределено Тогда
		recomCount = Значения.Получить("recomCount");
	КонецЕсли;
	Если Значения.Получить("recomPics") <> Неопределено Тогда
		recomPics = Значения.Получить("recomPics");
	КонецЕсли;
	Если Значения.Получить("recomNms") <> Неопределено Тогда
		recomNms = Значения.Получить("recomNms");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если nmId <> Неопределено Тогда
		Результат.Вставить("nmId", ЗначениеДляJSON(nmId));
	КонецЕсли;
	Если imtId <> Неопределено Тогда
		Результат.Вставить("imtId", ЗначениеДляJSON(imtId));
	КонецЕсли;
	Если vendorCode <> Неопределено Тогда
		Результат.Вставить("vendorCode", ЗначениеДляJSON(vendorCode));
	КонецЕсли;
	Если brandName <> Неопределено Тогда
		Результат.Вставить("brandName", ЗначениеДляJSON(brandName));
	КонецЕсли;
	Если updatedAt <> Неопределено Тогда
		Результат.Вставить("updatedAt", ЗначениеДляJSON(updatedAt));
	КонецЕсли;
	Если picsCount <> Неопределено Тогда
		Результат.Вставить("picsCount", ЗначениеДляJSON(picsCount));
	КонецЕсли;
	Если title <> Неопределено Тогда
		Результат.Вставить("title", ЗначениеДляJSON(title));
	КонецЕсли;
	Если subjectName <> Неопределено Тогда
		Результат.Вставить("subjectName", ЗначениеДляJSON(subjectName));
	КонецЕсли;
	Если pic <> Неопределено Тогда
		Результат.Вставить("pic", ЗначениеДляJSON(pic));
	КонецЕсли;
	Если recomCount <> Неопределено Тогда
		Результат.Вставить("recomCount", ЗначениеДляJSON(recomCount));
	КонецЕсли;
	Если recomPics <> Неопределено Тогда
		Результат.Вставить("recomPics", ЗначениеДляJSON(recomPics));
	КонецЕсли;
	Если recomNms <> Неопределено Тогда
		Результат.Вставить("recomNms", ЗначениеДляJSON(recomNms));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

