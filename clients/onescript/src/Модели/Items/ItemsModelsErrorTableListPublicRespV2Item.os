// ItemsModelsErrorTableListPublicRespV2Item
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// batchUUID - Строка - ID пакета
Перем batchUUID Экспорт;

// subjects - Соответствие - Предметы. Разбивка по `vendorCodes`
Перем subjects Экспорт;

// brands - Соответствие - Бренды. Разбивка по `vendorCodes`
Перем brands Экспорт;

// vendorCodes - Массив - Артикулы продавца
Перем vendorCodes Экспорт;

// errors - Соответствие - Ошибки. Разбивка по `vendorCodes`
Перем errors Экспорт;

// updatedAt - Дата - Дата и время создания или редактирования пакета
Перем updatedAt Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("batchUUID") <> Неопределено Тогда
		batchUUID = Значения.Получить("batchUUID");
	КонецЕсли;
	Если Значения.Получить("subjects") <> Неопределено Тогда
		subjects = Значения.Получить("subjects");
	КонецЕсли;
	Если Значения.Получить("brands") <> Неопределено Тогда
		brands = Значения.Получить("brands");
	КонецЕсли;
	Если Значения.Получить("vendorCodes") <> Неопределено Тогда
		vendorCodes = Значения.Получить("vendorCodes");
	КонецЕсли;
	Если Значения.Получить("errors") <> Неопределено Тогда
		errors = Значения.Получить("errors");
	КонецЕсли;
	Если Значения.Получить("updatedAt") <> Неопределено Тогда
		updatedAt = Значения.Получить("updatedAt");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если batchUUID <> Неопределено Тогда
		Результат.Вставить("batchUUID", ЗначениеДляJSON(batchUUID));
	КонецЕсли;
	Если subjects <> Неопределено Тогда
		Результат.Вставить("subjects", ЗначениеДляJSON(subjects));
	КонецЕсли;
	Если brands <> Неопределено Тогда
		Результат.Вставить("brands", ЗначениеДляJSON(brands));
	КонецЕсли;
	Если vendorCodes <> Неопределено Тогда
		Результат.Вставить("vendorCodes", ЗначениеДляJSON(vendorCodes));
	КонецЕсли;
	Если errors <> Неопределено Тогда
		Результат.Вставить("errors", ЗначениеДляJSON(errors));
	КонецЕсли;
	Если updatedAt <> Неопределено Тогда
		Результат.Вставить("updatedAt", ЗначениеДляJSON(updatedAt));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

