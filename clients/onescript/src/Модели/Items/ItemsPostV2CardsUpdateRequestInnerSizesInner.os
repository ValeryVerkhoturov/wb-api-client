// ItemsPostV2CardsUpdateRequestInnerSizesInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// chrtID - Число - ID размера для данного артикула WB Обязателен к заполнению для существующих размеров Для добавляемых размеров не указывается
Перем chrtID Экспорт;

// techSize - Строка - Размер товара (например, XL, S, 45)
Перем techSize Экспорт;

// wbSize - Строка - Российский размер товара
Перем wbSize Экспорт;

// price - Число - Цена товара, ₽ Указывается при добавлении размера
Перем price Экспорт;

// skus - Массив - Баркоды
Перем skus Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("chrtID") <> Неопределено Тогда
		chrtID = Значения.Получить("chrtID");
	КонецЕсли;
	Если Значения.Получить("techSize") <> Неопределено Тогда
		techSize = Значения.Получить("techSize");
	КонецЕсли;
	Если Значения.Получить("wbSize") <> Неопределено Тогда
		wbSize = Значения.Получить("wbSize");
	КонецЕсли;
	Если Значения.Получить("price") <> Неопределено Тогда
		price = Значения.Получить("price");
	КонецЕсли;
	Если Значения.Получить("skus") <> Неопределено Тогда
		skus = Значения.Получить("skus");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если chrtID <> Неопределено Тогда
		Результат.Вставить("chrtID", ЗначениеДляJSON(chrtID));
	КонецЕсли;
	Если techSize <> Неопределено Тогда
		Результат.Вставить("techSize", ЗначениеДляJSON(techSize));
	КонецЕсли;
	Если wbSize <> Неопределено Тогда
		Результат.Вставить("wbSize", ЗначениеДляJSON(wbSize));
	КонецЕсли;
	Если price <> Неопределено Тогда
		Результат.Вставить("price", ЗначениеДляJSON(price));
	КонецЕсли;
	Если skus <> Неопределено Тогда
		Результат.Вставить("skus", ЗначениеДляJSON(skus));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

