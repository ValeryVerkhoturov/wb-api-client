// CommunicationsOpenapiSellerLimitsResponseDataSubscription
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// perUnitLimit - Число - Максимальное количество закреплённых отзывов в одной карточке товара или в группе [объединённых](https://dev.wildberries.ru/knowledge-base/articles/019d49a4-132…
Перем perUnitLimit Экспорт;

// remaining - Число - Сколько ещё отзывов можно закрепить
Перем remaining Экспорт;

// totalLimit - Число - Общий лимит закреплений
Перем totalLimit Экспорт;

// unlimited - Булево - Количество закреплённых отзывов не ограничено: - `true` — да - `false` — нет
Перем unlimited Экспорт;

// used - Число - Текущее количество закреплённых отзывов
Перем used Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("perUnitLimit") <> Неопределено Тогда
		perUnitLimit = Значения.Получить("perUnitLimit");
	КонецЕсли;
	Если Значения.Получить("remaining") <> Неопределено Тогда
		remaining = Значения.Получить("remaining");
	КонецЕсли;
	Если Значения.Получить("totalLimit") <> Неопределено Тогда
		totalLimit = Значения.Получить("totalLimit");
	КонецЕсли;
	Если Значения.Получить("unlimited") <> Неопределено Тогда
		unlimited = Значения.Получить("unlimited");
	КонецЕсли;
	Если Значения.Получить("used") <> Неопределено Тогда
		used = Значения.Получить("used");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если perUnitLimit <> Неопределено Тогда
		Результат.Вставить("perUnitLimit", ЗначениеДляJSON(perUnitLimit));
	КонецЕсли;
	Если remaining <> Неопределено Тогда
		Результат.Вставить("remaining", ЗначениеДляJSON(remaining));
	КонецЕсли;
	Если totalLimit <> Неопределено Тогда
		Результат.Вставить("totalLimit", ЗначениеДляJSON(totalLimit));
	КонецЕсли;
	Если unlimited <> Неопределено Тогда
		Результат.Вставить("unlimited", ЗначениеДляJSON(unlimited));
	КонецЕсли;
	Если used <> Неопределено Тогда
		Результат.Вставить("used", ЗначениеДляJSON(used));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

