// CommunicationsGetV1QuestionsCountResponse200
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// data - Число - Количество вопросов
Перем data Экспорт;

// error - Булево - Есть ли ошибка
Перем error Экспорт;

// errorText - Строка - Описание ошибки
Перем errorText Экспорт;

// additionalErrors - Массив - Дополнительные ошибки
Перем additionalErrors Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("data") <> Неопределено Тогда
		data = Значения.Получить("data");
	КонецЕсли;
	Если Значения.Получить("error") <> Неопределено Тогда
		error = Значения.Получить("error");
	КонецЕсли;
	Если Значения.Получить("errorText") <> Неопределено Тогда
		errorText = Значения.Получить("errorText");
	КонецЕсли;
	Если Значения.Получить("additionalErrors") <> Неопределено Тогда
		additionalErrors = Значения.Получить("additionalErrors");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если data <> Неопределено Тогда
		Результат.Вставить("data", ЗначениеДляJSON(data));
	КонецЕсли;
	Если error <> Неопределено Тогда
		Результат.Вставить("error", ЗначениеДляJSON(error));
	КонецЕсли;
	Если errorText <> Неопределено Тогда
		Результат.Вставить("errorText", ЗначениеДляJSON(errorText));
	КонецЕсли;
	Если additionalErrors <> Неопределено Тогда
		Результат.Вставить("additionalErrors", ЗначениеДляJSON(additionalErrors));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

