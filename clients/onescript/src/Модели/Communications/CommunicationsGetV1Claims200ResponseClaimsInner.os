// CommunicationsGetV1Claims200ResponseClaimsInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// id - Строка - ID заявки
Перем id Экспорт;

// claim_type - Число - Источник заявки: * `1` — портал покупателей * `3` — чат
Перем claim_type Экспорт;

// status - Число - Решение по возврату покупателю: * `0` — на рассмотрении * `1` — отказ * `2` — одобрено
Перем status Экспорт;

// status_ex - Число - Статус товара: * `0` — заявка на рассмотрении * `1` — товар остается у покупателя (Заявка отклонена) * `2` — покупатель сдает товар на WB, товар отправляется в…
Перем status_ex Экспорт;

// nm_id - Число - Артикул WB
Перем nm_id Экспорт;

// user_comment - Строка - Комментарий покупателя
Перем user_comment Экспорт;

// wb_comment - Строка - Ответ покупателю
Перем wb_comment Экспорт;

// dt - Строка - Дата и время оформления заявки покупателем. UTC+3
Перем dt Экспорт;

// imt_name - Строка - Название товара
Перем imt_name Экспорт;

// order_dt - Строка - Дата и время заказа
Перем order_dt Экспорт;

// dt_update - Строка - Дата и время рассмотрения заявки. Для нерассмотренной заявки — дата и время оформления. UTC+3
Перем dt_update Экспорт;

// photos - Массив - Фотографии из заявки покупателя
Перем photos Экспорт;

// video_paths - Массив - Видео из заявки покупателя
Перем video_paths Экспорт;

// actions - Массив - Варианты [ответа продавца на заявку](./customer-communication#tag/buyersReturns/operation/patchV1Claim). Отклонённые заявки можно пересмотреть. Если массив пуст…
Перем actions Экспорт;

// price - Число - Фактическая цена с учетом всех скидок. Взимается с покупателя
Перем price Экспорт;

// currency_code - Строка - Код валюты цены
Перем currency_code Экспорт;

// srid - Строка - Уникальный ID заказа, по товару которого создана заявка
Перем srid Экспорт;

// origin_id_info - Строка - Результат сверки [IMEI](https://seller.wildberries.ru/instructions/ru/ru/material/items-labeling-in-fbs#imei) для возврата через ПВЗ Wildberries. Значение показ…
Перем origin_id_info Экспорт;

// delivery_dt - Строка - Дата и время получения заказа покупателем
Перем delivery_dt Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("id") <> Неопределено Тогда
		id = Значения.Получить("id");
	КонецЕсли;
	Если Значения.Получить("claim_type") <> Неопределено Тогда
		claim_type = Значения.Получить("claim_type");
	КонецЕсли;
	Если Значения.Получить("status") <> Неопределено Тогда
		status = Значения.Получить("status");
	КонецЕсли;
	Если Значения.Получить("status_ex") <> Неопределено Тогда
		status_ex = Значения.Получить("status_ex");
	КонецЕсли;
	Если Значения.Получить("nm_id") <> Неопределено Тогда
		nm_id = Значения.Получить("nm_id");
	КонецЕсли;
	Если Значения.Получить("user_comment") <> Неопределено Тогда
		user_comment = Значения.Получить("user_comment");
	КонецЕсли;
	Если Значения.Получить("wb_comment") <> Неопределено Тогда
		wb_comment = Значения.Получить("wb_comment");
	КонецЕсли;
	Если Значения.Получить("dt") <> Неопределено Тогда
		dt = Значения.Получить("dt");
	КонецЕсли;
	Если Значения.Получить("imt_name") <> Неопределено Тогда
		imt_name = Значения.Получить("imt_name");
	КонецЕсли;
	Если Значения.Получить("order_dt") <> Неопределено Тогда
		order_dt = Значения.Получить("order_dt");
	КонецЕсли;
	Если Значения.Получить("dt_update") <> Неопределено Тогда
		dt_update = Значения.Получить("dt_update");
	КонецЕсли;
	Если Значения.Получить("photos") <> Неопределено Тогда
		photos = Значения.Получить("photos");
	КонецЕсли;
	Если Значения.Получить("video_paths") <> Неопределено Тогда
		video_paths = Значения.Получить("video_paths");
	КонецЕсли;
	Если Значения.Получить("actions") <> Неопределено Тогда
		actions = Значения.Получить("actions");
	КонецЕсли;
	Если Значения.Получить("price") <> Неопределено Тогда
		price = Значения.Получить("price");
	КонецЕсли;
	Если Значения.Получить("currency_code") <> Неопределено Тогда
		currency_code = Значения.Получить("currency_code");
	КонецЕсли;
	Если Значения.Получить("srid") <> Неопределено Тогда
		srid = Значения.Получить("srid");
	КонецЕсли;
	Если Значения.Получить("origin_id_info") <> Неопределено Тогда
		origin_id_info = Значения.Получить("origin_id_info");
	КонецЕсли;
	Если Значения.Получить("delivery_dt") <> Неопределено Тогда
		delivery_dt = Значения.Получить("delivery_dt");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Если claim_type <> Неопределено Тогда
		Результат.Вставить("claim_type", ЗначениеДляJSON(claim_type));
	КонецЕсли;
	Если status <> Неопределено Тогда
		Результат.Вставить("status", ЗначениеДляJSON(status));
	КонецЕсли;
	Если status_ex <> Неопределено Тогда
		Результат.Вставить("status_ex", ЗначениеДляJSON(status_ex));
	КонецЕсли;
	Если nm_id <> Неопределено Тогда
		Результат.Вставить("nm_id", ЗначениеДляJSON(nm_id));
	КонецЕсли;
	Если user_comment <> Неопределено Тогда
		Результат.Вставить("user_comment", ЗначениеДляJSON(user_comment));
	КонецЕсли;
	Если wb_comment <> Неопределено Тогда
		Результат.Вставить("wb_comment", ЗначениеДляJSON(wb_comment));
	КонецЕсли;
	Если dt <> Неопределено Тогда
		Результат.Вставить("dt", ЗначениеДляJSON(dt));
	КонецЕсли;
	Если imt_name <> Неопределено Тогда
		Результат.Вставить("imt_name", ЗначениеДляJSON(imt_name));
	КонецЕсли;
	Если order_dt <> Неопределено Тогда
		Результат.Вставить("order_dt", ЗначениеДляJSON(order_dt));
	КонецЕсли;
	Если dt_update <> Неопределено Тогда
		Результат.Вставить("dt_update", ЗначениеДляJSON(dt_update));
	КонецЕсли;
	Если photos <> Неопределено Тогда
		Результат.Вставить("photos", ЗначениеДляJSON(photos));
	КонецЕсли;
	Если video_paths <> Неопределено Тогда
		Результат.Вставить("video_paths", ЗначениеДляJSON(video_paths));
	КонецЕсли;
	Если actions <> Неопределено Тогда
		Результат.Вставить("actions", ЗначениеДляJSON(actions));
	КонецЕсли;
	Если price <> Неопределено Тогда
		Результат.Вставить("price", ЗначениеДляJSON(price));
	КонецЕсли;
	Если currency_code <> Неопределено Тогда
		Результат.Вставить("currency_code", ЗначениеДляJSON(currency_code));
	КонецЕсли;
	Если srid <> Неопределено Тогда
		Результат.Вставить("srid", ЗначениеДляJSON(srid));
	КонецЕсли;
	Если origin_id_info <> Неопределено Тогда
		Результат.Вставить("origin_id_info", ЗначениеДляJSON(origin_id_info));
	КонецЕсли;
	Если delivery_dt <> Неопределено Тогда
		Результат.Вставить("delivery_dt", ЗначениеДляJSON(delivery_dt));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

