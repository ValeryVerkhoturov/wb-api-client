// CommunicationsChat
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// chatID - Строка - ID чата
Перем chatID Экспорт;

// replySign - Строка - Подпись чата. Требуется при [отправке сообщения](./customer-communication#tag/buyersChat/operation/postV1SellerMessage)
Перем replySign Экспорт;

// clientName - Строка - Имя покупателя
Перем clientName Экспорт;

// goodCard - Listing
Перем goodCard Экспорт;

// lastMessage - LastMessage - Последнее сообщение в чате
Перем lastMessage Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("chatID") <> Неопределено Тогда
		chatID = Значения.Получить("chatID");
	КонецЕсли;
	Если Значения.Получить("replySign") <> Неопределено Тогда
		replySign = Значения.Получить("replySign");
	КонецЕсли;
	Если Значения.Получить("clientName") <> Неопределено Тогда
		clientName = Значения.Получить("clientName");
	КонецЕсли;
	Если Значения.Получить("goodCard") <> Неопределено Тогда
		goodCard = Значения.Получить("goodCard");
	КонецЕсли;
	Если Значения.Получить("lastMessage") <> Неопределено Тогда
		lastMessage = Значения.Получить("lastMessage");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если chatID <> Неопределено Тогда
		Результат.Вставить("chatID", ЗначениеДляJSON(chatID));
	КонецЕсли;
	Если replySign <> Неопределено Тогда
		Результат.Вставить("replySign", ЗначениеДляJSON(replySign));
	КонецЕсли;
	Если clientName <> Неопределено Тогда
		Результат.Вставить("clientName", ЗначениеДляJSON(clientName));
	КонецЕсли;
	Если goodCard <> Неопределено Тогда
		Результат.Вставить("goodCard", ЗначениеДляJSON(goodCard));
	КонецЕсли;
	Если lastMessage <> Неопределено Тогда
		Результат.Вставить("lastMessage", ЗначениеДляJSON(lastMessage));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

