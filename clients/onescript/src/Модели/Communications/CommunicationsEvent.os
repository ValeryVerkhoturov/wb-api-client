// CommunicationsEvent
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// chatID - Строка - ID чата
Перем chatID Экспорт;

// eventID - Строка - ID события
Перем eventID Экспорт;

// eventType - EventType
Перем eventType Экспорт;

// isNewChat - Булево - Признак нового чата: - `false` — чат не новый - `true` — чат новый
Перем isNewChat Экспорт;

// message - Event_message
Перем message Экспорт;

// source - Строка - Источник отправки сообщения: - `seller-portal` — портал продавцов - `seller-public-api` — API Чата с покупателями - `rusite` — портал покупателей - `global` — п…
Перем source Экспорт;

// addTimestamp - Число - Время появления события на сервере. Формат Unix timestamp
Перем addTimestamp Экспорт;

// addTime - Строка - Время появления события на сервере в UTC
Перем addTime Экспорт;

// replySign - Строка - Подпись чата. Доступна только при `\"isNewChat\": true`. Требуется при [отправке сообщения](./customer-communication#tag/buyersChat/operation/postV1SellerMessag…
Перем replySign Экспорт;

// sender - Sender
Перем sender Экспорт;

// clientName - Строка - Имя покупателя
Перем clientName Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("chatID") <> Неопределено Тогда
		chatID = Значения.Получить("chatID");
	КонецЕсли;
	Если Значения.Получить("eventID") <> Неопределено Тогда
		eventID = Значения.Получить("eventID");
	КонецЕсли;
	Если Значения.Получить("eventType") <> Неопределено Тогда
		eventType = Значения.Получить("eventType");
	КонецЕсли;
	Если Значения.Получить("isNewChat") <> Неопределено Тогда
		isNewChat = Значения.Получить("isNewChat");
	КонецЕсли;
	Если Значения.Получить("message") <> Неопределено Тогда
		message = Значения.Получить("message");
	КонецЕсли;
	Если Значения.Получить("source") <> Неопределено Тогда
		source = Значения.Получить("source");
	КонецЕсли;
	Если Значения.Получить("addTimestamp") <> Неопределено Тогда
		addTimestamp = Значения.Получить("addTimestamp");
	КонецЕсли;
	Если Значения.Получить("addTime") <> Неопределено Тогда
		addTime = Значения.Получить("addTime");
	КонецЕсли;
	Если Значения.Получить("replySign") <> Неопределено Тогда
		replySign = Значения.Получить("replySign");
	КонецЕсли;
	Если Значения.Получить("sender") <> Неопределено Тогда
		sender = Значения.Получить("sender");
	КонецЕсли;
	Если Значения.Получить("clientName") <> Неопределено Тогда
		clientName = Значения.Получить("clientName");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если chatID <> Неопределено Тогда
		Результат.Вставить("chatID", ЗначениеДляJSON(chatID));
	КонецЕсли;
	Если eventID <> Неопределено Тогда
		Результат.Вставить("eventID", ЗначениеДляJSON(eventID));
	КонецЕсли;
	Если eventType <> Неопределено Тогда
		Результат.Вставить("eventType", ЗначениеДляJSON(eventType));
	КонецЕсли;
	Если isNewChat <> Неопределено Тогда
		Результат.Вставить("isNewChat", ЗначениеДляJSON(isNewChat));
	КонецЕсли;
	Если message <> Неопределено Тогда
		Результат.Вставить("message", ЗначениеДляJSON(message));
	КонецЕсли;
	Если source <> Неопределено Тогда
		Результат.Вставить("source", ЗначениеДляJSON(source));
	КонецЕсли;
	Если addTimestamp <> Неопределено Тогда
		Результат.Вставить("addTimestamp", ЗначениеДляJSON(addTimestamp));
	КонецЕсли;
	Если addTime <> Неопределено Тогда
		Результат.Вставить("addTime", ЗначениеДляJSON(addTime));
	КонецЕсли;
	Если replySign <> Неопределено Тогда
		Результат.Вставить("replySign", ЗначениеДляJSON(replySign));
	КонецЕсли;
	Если sender <> Неопределено Тогда
		Результат.Вставить("sender", ЗначениеДляJSON(sender));
	КонецЕсли;
	Если clientName <> Неопределено Тогда
		Результат.Вставить("clientName", ЗначениеДляJSON(clientName));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

