// CommunicationsGetV1FeedbacksResponse200DataFeedbacksInnerVideo
//
// Структура видео
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// previewImage - Строка - Ссылка на обложку видео
Перем previewImage Экспорт;

// link - Строка - Ссылка на файл плейлиста видео (доступно по протоколу HLS)
Перем link Экспорт;

// durationSec - Число - Общая продолжительность видео
Перем durationSec Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("previewImage") <> Неопределено Тогда
		previewImage = Значения.Получить("previewImage");
	КонецЕсли;
	Если Значения.Получить("link") <> Неопределено Тогда
		link = Значения.Получить("link");
	КонецЕсли;
	Если Значения.Получить("durationSec") <> Неопределено Тогда
		durationSec = Значения.Получить("durationSec");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если previewImage <> Неопределено Тогда
		Результат.Вставить("previewImage", ЗначениеДляJSON(previewImage));
	КонецЕсли;
	Если link <> Неопределено Тогда
		Результат.Вставить("link", ЗначениеДляJSON(link));
	КонецЕсли;
	Если durationSec <> Неопределено Тогда
		Результат.Вставить("durationSec", ЗначениеДляJSON(durationSec));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

