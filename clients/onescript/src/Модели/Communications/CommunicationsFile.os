// CommunicationsFile
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// contentType - Строка - Тип файла
Перем contentType Экспорт;

// date - Строка - Дата загрузки файла
Перем date Экспорт;

// downloadID - Строка - ID файла. [Получить файл](./customer-communication#tag/buyersChat/operation/getV1SellerDownloadId)
Перем downloadID Экспорт;

// name - Строка - Название файла
Перем name Экспорт;

// url - Строка - URL для получения файла
Перем url Экспорт;

// size - Число - Размер файла в байтах
Перем size Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("contentType") <> Неопределено Тогда
		contentType = Значения.Получить("contentType");
	КонецЕсли;
	Если Значения.Получить("date") <> Неопределено Тогда
		date = Значения.Получить("date");
	КонецЕсли;
	Если Значения.Получить("downloadID") <> Неопределено Тогда
		downloadID = Значения.Получить("downloadID");
	КонецЕсли;
	Если Значения.Получить("name") <> Неопределено Тогда
		name = Значения.Получить("name");
	КонецЕсли;
	Если Значения.Получить("url") <> Неопределено Тогда
		url = Значения.Получить("url");
	КонецЕсли;
	Если Значения.Получить("size") <> Неопределено Тогда
		size = Значения.Получить("size");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если contentType <> Неопределено Тогда
		Результат.Вставить("contentType", ЗначениеДляJSON(contentType));
	КонецЕсли;
	Если date <> Неопределено Тогда
		Результат.Вставить("date", ЗначениеДляJSON(date));
	КонецЕсли;
	Если downloadID <> Неопределено Тогда
		Результат.Вставить("downloadID", ЗначениеДляJSON(downloadID));
	КонецЕсли;
	Если name <> Неопределено Тогда
		Результат.Вставить("name", ЗначениеДляJSON(name));
	КонецЕсли;
	Если url <> Неопределено Тогда
		Результат.Вставить("url", ЗначениеДляJSON(url));
	КонецЕсли;
	Если size <> Неопределено Тогда
		Результат.Вставить("size", ЗначениеДляJSON(size));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

