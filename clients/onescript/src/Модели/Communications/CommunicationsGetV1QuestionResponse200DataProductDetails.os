// CommunicationsGetV1QuestionResponse200DataProductDetails
//
// Item information
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// nmId - Число - Артикул WB
Перем nmId Экспорт;

// imtId - Число - ID для [объединённых](https://dev.wildberries.ru/knowledge-base/articles/019d49a4-1320-71bb-9dac-8ba07e7177ce/rabota-s-tovarami#obuedinenie-i-razuedinenie-karto…
Перем imtId Экспорт;

// productName - Строка - Название товара
Перем productName Экспорт;

// supplierArticle - Строка - Артикул продавца
Перем supplierArticle Экспорт;

// supplierName - Строка - Имя продавца
Перем supplierName Экспорт;

// brandName - Строка - Название бренда
Перем brandName Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("nmId") <> Неопределено Тогда
		nmId = Значения.Получить("nmId");
	КонецЕсли;
	Если Значения.Получить("imtId") <> Неопределено Тогда
		imtId = Значения.Получить("imtId");
	КонецЕсли;
	Если Значения.Получить("productName") <> Неопределено Тогда
		productName = Значения.Получить("productName");
	КонецЕсли;
	Если Значения.Получить("supplierArticle") <> Неопределено Тогда
		supplierArticle = Значения.Получить("supplierArticle");
	КонецЕсли;
	Если Значения.Получить("supplierName") <> Неопределено Тогда
		supplierName = Значения.Получить("supplierName");
	КонецЕсли;
	Если Значения.Получить("brandName") <> Неопределено Тогда
		brandName = Значения.Получить("brandName");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если nmId <> Неопределено Тогда
		Результат.Вставить("nmId", ЗначениеДляJSON(nmId));
	КонецЕсли;
	Если imtId <> Неопределено Тогда
		Результат.Вставить("imtId", ЗначениеДляJSON(imtId));
	КонецЕсли;
	Если productName <> Неопределено Тогда
		Результат.Вставить("productName", ЗначениеДляJSON(productName));
	КонецЕсли;
	Если supplierArticle <> Неопределено Тогда
		Результат.Вставить("supplierArticle", ЗначениеДляJSON(supplierArticle));
	КонецЕсли;
	Если supplierName <> Неопределено Тогда
		Результат.Вставить("supplierName", ЗначениеДляJSON(supplierName));
	КонецЕсли;
	Если brandName <> Неопределено Тогда
		Результат.Вставить("brandName", ЗначениеДляJSON(brandName));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

