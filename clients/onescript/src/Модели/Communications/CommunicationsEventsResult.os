// CommunicationsEventsResult
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// next - Число - Пагинатор. Значение поля необходимо указать в запросе для получения следующего пакета данных
Перем next Экспорт;

// newestEventTime - Дата - Время новейшего события в ответе
Перем newestEventTime Экспорт;

// oldestEventTime - Дата - Время старейшего события в ответе
Перем oldestEventTime Экспорт;

// totalEvents - Число - Количество событий
Перем totalEvents Экспорт;

// events - Массив
Перем events Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("next") <> Неопределено Тогда
		next = Значения.Получить("next");
	КонецЕсли;
	Если Значения.Получить("newestEventTime") <> Неопределено Тогда
		newestEventTime = Значения.Получить("newestEventTime");
	КонецЕсли;
	Если Значения.Получить("oldestEventTime") <> Неопределено Тогда
		oldestEventTime = Значения.Получить("oldestEventTime");
	КонецЕсли;
	Если Значения.Получить("totalEvents") <> Неопределено Тогда
		totalEvents = Значения.Получить("totalEvents");
	КонецЕсли;
	Если Значения.Получить("events") <> Неопределено Тогда
		events = Значения.Получить("events");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если next <> Неопределено Тогда
		Результат.Вставить("next", ЗначениеДляJSON(next));
	КонецЕсли;
	Если newestEventTime <> Неопределено Тогда
		Результат.Вставить("newestEventTime", ЗначениеДляJSON(newestEventTime));
	КонецЕсли;
	Если oldestEventTime <> Неопределено Тогда
		Результат.Вставить("oldestEventTime", ЗначениеДляJSON(oldestEventTime));
	КонецЕсли;
	Если totalEvents <> Неопределено Тогда
		Результат.Вставить("totalEvents", ЗначениеДляJSON(totalEvents));
	КонецЕсли;
	Если events <> Неопределено Тогда
		Результат.Вставить("events", ЗначениеДляJSON(events));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

