// CommunicationsOpenapiPinnedReviewItemResult
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// changeStateAt - Дата - Дата и время закрепления или открепления
Перем changeStateAt Экспорт;

// imtId - Число - ID для [объединённых](https://dev.wildberries.ru/knowledge-base/articles/019d49a4-1320-71bb-9dac-8ba07e7177ce/rabota-s-tovarami#obuedinenie-i-razuedinenie-karto…
Перем imtId Экспорт;

// nmId - Число - Артикул WB
Перем nmId Экспорт;

// pinId - Число - ID операции закрепления отзыва
Перем pinId Экспорт;

// pinMethod - domain.ReviewPinMethod - Метод закрепления: - `subscription` — подписка Джем - `tariff` — тарифная опция
Перем pinMethod Экспорт;

// pinOn - domain.ReviewPinOn - Место закрепления отзыва: - `nm` — карточка товара - `imt` — группа [объединённых](https://dev.wildberries.ru/knowledge-base/articles/019d49a4-1320-71bb-9dac-8b…
Перем pinOn Экспорт;

// feedbackId - Строка - ID отзыва
Перем feedbackId Экспорт;

// state - domain.ReviewState - Закреплён ли отзыв: - `pinned` — да - `unpinned` — нет
Перем state Экспорт;

// unpinnedCause - Строка - Причина открепления отзыва: - `sysTariffUnpinned` — закончилась подписка или тарифная опция - `sysLimitReached` — закончился общий лимит по подписке - `sysNorat…
Перем unpinnedCause Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("changeStateAt") <> Неопределено Тогда
		changeStateAt = Значения.Получить("changeStateAt");
	КонецЕсли;
	Если Значения.Получить("imtId") <> Неопределено Тогда
		imtId = Значения.Получить("imtId");
	КонецЕсли;
	Если Значения.Получить("nmId") <> Неопределено Тогда
		nmId = Значения.Получить("nmId");
	КонецЕсли;
	Если Значения.Получить("pinId") <> Неопределено Тогда
		pinId = Значения.Получить("pinId");
	КонецЕсли;
	Если Значения.Получить("pinMethod") <> Неопределено Тогда
		pinMethod = Значения.Получить("pinMethod");
	КонецЕсли;
	Если Значения.Получить("pinOn") <> Неопределено Тогда
		pinOn = Значения.Получить("pinOn");
	КонецЕсли;
	Если Значения.Получить("feedbackId") <> Неопределено Тогда
		feedbackId = Значения.Получить("feedbackId");
	КонецЕсли;
	Если Значения.Получить("state") <> Неопределено Тогда
		state = Значения.Получить("state");
	КонецЕсли;
	Если Значения.Получить("unpinnedCause") <> Неопределено Тогда
		unpinnedCause = Значения.Получить("unpinnedCause");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если changeStateAt <> Неопределено Тогда
		Результат.Вставить("changeStateAt", ЗначениеДляJSON(changeStateAt));
	КонецЕсли;
	Если imtId <> Неопределено Тогда
		Результат.Вставить("imtId", ЗначениеДляJSON(imtId));
	КонецЕсли;
	Если nmId <> Неопределено Тогда
		Результат.Вставить("nmId", ЗначениеДляJSON(nmId));
	КонецЕсли;
	Если pinId <> Неопределено Тогда
		Результат.Вставить("pinId", ЗначениеДляJSON(pinId));
	КонецЕсли;
	Если pinMethod <> Неопределено Тогда
		Результат.Вставить("pinMethod", ЗначениеДляJSON(pinMethod));
	КонецЕсли;
	Если pinOn <> Неопределено Тогда
		Результат.Вставить("pinOn", ЗначениеДляJSON(pinOn));
	КонецЕсли;
	Если feedbackId <> Неопределено Тогда
		Результат.Вставить("feedbackId", ЗначениеДляJSON(feedbackId));
	КонецЕсли;
	Если state <> Неопределено Тогда
		Результат.Вставить("state", ЗначениеДляJSON(state));
	КонецЕсли;
	Если unpinnedCause <> Неопределено Тогда
		Результат.Вставить("unpinnedCause", ЗначениеДляJSON(unpinnedCause));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

