// CommunicationsGetV1FeedbacksResponse200Data
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// countUnanswered - Число - Количество необработанных отзывов
Перем countUnanswered Экспорт;

// countArchive - Число - Количество обработанных отзывов
Перем countArchive Экспорт;

// feedbacks - Массив - Массив отзывов
Перем feedbacks Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("countUnanswered") <> Неопределено Тогда
		countUnanswered = Значения.Получить("countUnanswered");
	КонецЕсли;
	Если Значения.Получить("countArchive") <> Неопределено Тогда
		countArchive = Значения.Получить("countArchive");
	КонецЕсли;
	Если Значения.Получить("feedbacks") <> Неопределено Тогда
		feedbacks = Значения.Получить("feedbacks");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если countUnanswered <> Неопределено Тогда
		Результат.Вставить("countUnanswered", ЗначениеДляJSON(countUnanswered));
	КонецЕсли;
	Если countArchive <> Неопределено Тогда
		Результат.Вставить("countArchive", ЗначениеДляJSON(countArchive));
	КонецЕсли;
	Если feedbacks <> Неопределено Тогда
		Результат.Вставить("feedbacks", ЗначениеДляJSON(feedbacks));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

