// OrdersFbwModelsOptionsResultModelResultInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// barcode - Строка - Баркод из карточки товара
Перем barcode Экспорт;

// error - models_OptionsResultModel_result_inner_error
Перем error Экспорт;

// isError - Булево - Наличие ошибки: - `true` — ошибка есть - Поля нет — ошибка отсутствует
Перем isError Экспорт;

// warehouses - Массив - Список складов. При наличии ошибки будет `null`
Перем warehouses Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("barcode") <> Неопределено Тогда
		barcode = Значения.Получить("barcode");
	КонецЕсли;
	Если Значения.Получить("error") <> Неопределено Тогда
		error = Значения.Получить("error");
	КонецЕсли;
	Если Значения.Получить("isError") <> Неопределено Тогда
		isError = Значения.Получить("isError");
	КонецЕсли;
	Если Значения.Получить("warehouses") <> Неопределено Тогда
		warehouses = Значения.Получить("warehouses");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если barcode <> Неопределено Тогда
		Результат.Вставить("barcode", ЗначениеДляJSON(barcode));
	КонецЕсли;
	Если error <> Неопределено Тогда
		Результат.Вставить("error", ЗначениеДляJSON(error));
	КонецЕсли;
	Если isError <> Неопределено Тогда
		Результат.Вставить("isError", ЗначениеДляJSON(isError));
	КонецЕсли;
	Если warehouses <> Неопределено Тогда
		Результат.Вставить("warehouses", ЗначениеДляJSON(warehouses));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

