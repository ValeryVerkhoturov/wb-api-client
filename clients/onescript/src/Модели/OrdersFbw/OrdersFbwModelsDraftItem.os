// OrdersFbwModelsDraftItem
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// draftId - Строка - ID черновика
Перем draftId Экспорт;

// phone - Строка - Телефон пользователя, создавшего черновик
Перем phone Экспорт;

// createdAt - Строка - Дата и время создания черновика
Перем createdAt Экспорт;

// updatedAt - Строка - Дата и время последнего обновления черновика
Перем updatedAt Экспорт;

// skuQuantity - Число - Количество баркодов
Перем skuQuantity Экспорт;

// itemQuantity - Число - Количество единиц товара
Перем itemQuantity Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("draftId") <> Неопределено Тогда
		draftId = Значения.Получить("draftId");
	КонецЕсли;
	Если Значения.Получить("phone") <> Неопределено Тогда
		phone = Значения.Получить("phone");
	КонецЕсли;
	Если Значения.Получить("createdAt") <> Неопределено Тогда
		createdAt = Значения.Получить("createdAt");
	КонецЕсли;
	Если Значения.Получить("updatedAt") <> Неопределено Тогда
		updatedAt = Значения.Получить("updatedAt");
	КонецЕсли;
	Если Значения.Получить("skuQuantity") <> Неопределено Тогда
		skuQuantity = Значения.Получить("skuQuantity");
	КонецЕсли;
	Если Значения.Получить("itemQuantity") <> Неопределено Тогда
		itemQuantity = Значения.Получить("itemQuantity");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если draftId <> Неопределено Тогда
		Результат.Вставить("draftId", ЗначениеДляJSON(draftId));
	КонецЕсли;
	Если phone <> Неопределено Тогда
		Результат.Вставить("phone", ЗначениеДляJSON(phone));
	КонецЕсли;
	Если createdAt <> Неопределено Тогда
		Результат.Вставить("createdAt", ЗначениеДляJSON(createdAt));
	КонецЕсли;
	Если updatedAt <> Неопределено Тогда
		Результат.Вставить("updatedAt", ЗначениеДляJSON(updatedAt));
	КонецЕсли;
	Если skuQuantity <> Неопределено Тогда
		Результат.Вставить("skuQuantity", ЗначениеДляJSON(skuQuantity));
	КонецЕсли;
	Если itemQuantity <> Неопределено Тогда
		Результат.Вставить("itemQuantity", ЗначениеДляJSON(itemQuantity));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

