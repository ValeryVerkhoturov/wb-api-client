// OrdersFbwModelsDiscrepancyResponseItem
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// declaredSku - Строка - Баркод, заявленный при формировании поставки
Перем declaredSku Экспорт;

// discrepancyType - Строка - Тип расхождения в целом по коробу: - `surplus` — товара в коробе больше заявленного - `shortage` — товара в коробе меньше заявленного - `re-sorting` — баркод пр…
Перем discrepancyType Экспорт;

// declaredAmount - Число - Количество товара, заявленное при формировании поставки
Перем declaredAmount Экспорт;

// actualAmount - Число - Фактическое количество товара
Перем actualAmount Экспорт;

// discrepancyQuantity - Число - Разница между заявленным и фактическим количеством товара
Перем discrepancyQuantity Экспорт;

// actualSku - Строка - Фактический баркод
Перем actualSku Экспорт;

// skuScans - Массив - Результаты сканирования товаров
Перем skuScans Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("declaredSku") <> Неопределено Тогда
		declaredSku = Значения.Получить("declaredSku");
	КонецЕсли;
	Если Значения.Получить("discrepancyType") <> Неопределено Тогда
		discrepancyType = Значения.Получить("discrepancyType");
	КонецЕсли;
	Если Значения.Получить("declaredAmount") <> Неопределено Тогда
		declaredAmount = Значения.Получить("declaredAmount");
	КонецЕсли;
	Если Значения.Получить("actualAmount") <> Неопределено Тогда
		actualAmount = Значения.Получить("actualAmount");
	КонецЕсли;
	Если Значения.Получить("discrepancyQuantity") <> Неопределено Тогда
		discrepancyQuantity = Значения.Получить("discrepancyQuantity");
	КонецЕсли;
	Если Значения.Получить("actualSku") <> Неопределено Тогда
		actualSku = Значения.Получить("actualSku");
	КонецЕсли;
	Если Значения.Получить("skuScans") <> Неопределено Тогда
		skuScans = Значения.Получить("skuScans");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если declaredSku <> Неопределено Тогда
		Результат.Вставить("declaredSku", ЗначениеДляJSON(declaredSku));
	КонецЕсли;
	Если discrepancyType <> Неопределено Тогда
		Результат.Вставить("discrepancyType", ЗначениеДляJSON(discrepancyType));
	КонецЕсли;
	Если declaredAmount <> Неопределено Тогда
		Результат.Вставить("declaredAmount", ЗначениеДляJSON(declaredAmount));
	КонецЕсли;
	Если actualAmount <> Неопределено Тогда
		Результат.Вставить("actualAmount", ЗначениеДляJSON(actualAmount));
	КонецЕсли;
	Если discrepancyQuantity <> Неопределено Тогда
		Результат.Вставить("discrepancyQuantity", ЗначениеДляJSON(discrepancyQuantity));
	КонецЕсли;
	Если actualSku <> Неопределено Тогда
		Результат.Вставить("actualSku", ЗначениеДляJSON(actualSku));
	КонецЕсли;
	Если skuScans <> Неопределено Тогда
		Результат.Вставить("skuScans", ЗначениеДляJSON(skuScans));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

