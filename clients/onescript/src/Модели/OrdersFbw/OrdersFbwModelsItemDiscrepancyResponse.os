// OrdersFbwModelsItemDiscrepancyResponse
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// packageCode - Строка - ID упаковки
Перем packageCode Экспорт;

// videoUrl - Строка - Видео фиксации расхождений в процессе приёмки
Перем videoUrl Экспорт;

// videoStartsAt - Дата - Дата и время видеофиксации расхождений в процессе приемки
Перем videoStartsAt Экспорт;

// videoUnavailable - Булево - Доступность видео: - `false` — видео доступно - `true` — видео недоступно
Перем videoUnavailable Экспорт;

// items - Массив - Товары поставки
Перем items Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("packageCode") <> Неопределено Тогда
		packageCode = Значения.Получить("packageCode");
	КонецЕсли;
	Если Значения.Получить("videoUrl") <> Неопределено Тогда
		videoUrl = Значения.Получить("videoUrl");
	КонецЕсли;
	Если Значения.Получить("videoStartsAt") <> Неопределено Тогда
		videoStartsAt = Значения.Получить("videoStartsAt");
	КонецЕсли;
	Если Значения.Получить("videoUnavailable") <> Неопределено Тогда
		videoUnavailable = Значения.Получить("videoUnavailable");
	КонецЕсли;
	Если Значения.Получить("items") <> Неопределено Тогда
		items = Значения.Получить("items");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если packageCode <> Неопределено Тогда
		Результат.Вставить("packageCode", ЗначениеДляJSON(packageCode));
	КонецЕсли;
	Если videoUrl <> Неопределено Тогда
		Результат.Вставить("videoUrl", ЗначениеДляJSON(videoUrl));
	КонецЕсли;
	Если videoStartsAt <> Неопределено Тогда
		Результат.Вставить("videoStartsAt", ЗначениеДляJSON(videoStartsAt));
	КонецЕсли;
	Если videoUnavailable <> Неопределено Тогда
		Результат.Вставить("videoUnavailable", ЗначениеДляJSON(videoUnavailable));
	КонецЕсли;
	Если items <> Неопределено Тогда
		Результат.Вставить("items", ЗначениеДляJSON(items));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

