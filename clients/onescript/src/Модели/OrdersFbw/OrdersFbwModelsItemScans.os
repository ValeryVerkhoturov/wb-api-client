// OrdersFbwModelsItemScans
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// scanId - Число - ID сканирования
Перем scanId Экспорт;

// declaredSku - Строка - Баркод, заявленный при формировании поставки
Перем declaredSku Экспорт;

// scanTime - Дата - Дата и время сканирования
Перем scanTime Экспорт;

// discrepancyLabel - Строка - Тип расхождения товара: - `surplus` — товара больше, чем заявлено - `shortage` — товара меньше, чем заявлено - `re-sorting` — баркод принятого товара не соответ…
Перем discrepancyLabel Экспорт;

// actualSku - Строка - Фактический баркод
Перем actualSku Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("scanId") <> Неопределено Тогда
		scanId = Значения.Получить("scanId");
	КонецЕсли;
	Если Значения.Получить("declaredSku") <> Неопределено Тогда
		declaredSku = Значения.Получить("declaredSku");
	КонецЕсли;
	Если Значения.Получить("scanTime") <> Неопределено Тогда
		scanTime = Значения.Получить("scanTime");
	КонецЕсли;
	Если Значения.Получить("discrepancyLabel") <> Неопределено Тогда
		discrepancyLabel = Значения.Получить("discrepancyLabel");
	КонецЕсли;
	Если Значения.Получить("actualSku") <> Неопределено Тогда
		actualSku = Значения.Получить("actualSku");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если scanId <> Неопределено Тогда
		Результат.Вставить("scanId", ЗначениеДляJSON(scanId));
	КонецЕсли;
	Если declaredSku <> Неопределено Тогда
		Результат.Вставить("declaredSku", ЗначениеДляJSON(declaredSku));
	КонецЕсли;
	Если scanTime <> Неопределено Тогда
		Результат.Вставить("scanTime", ЗначениеДляJSON(scanTime));
	КонецЕсли;
	Если discrepancyLabel <> Неопределено Тогда
		Результат.Вставить("discrepancyLabel", ЗначениеДляJSON(discrepancyLabel));
	КонецЕсли;
	Если actualSku <> Неопределено Тогда
		Результат.Вставить("actualSku", ЗначениеДляJSON(actualSku));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

