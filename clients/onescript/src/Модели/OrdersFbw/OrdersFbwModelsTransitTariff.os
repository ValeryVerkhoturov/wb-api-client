// OrdersFbwModelsTransitTariff
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// transitWarehouseName - Строка - Транзитный склад
Перем transitWarehouseName Экспорт;

// destinationWarehouseName - Строка - Склад назначения
Перем destinationWarehouseName Экспорт;

// activeFrom - Дата - С какого числа доступно транзитное направление
Перем activeFrom Экспорт;

// boxTariff - Массив - Тариф за транзит коробов. Если `null`, транзит для коробов недоступен
Перем boxTariff Экспорт;

// palletTariff - Число - Тариф за паллету, ₽
Перем palletTariff Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("transitWarehouseName") <> Неопределено Тогда
		transitWarehouseName = Значения.Получить("transitWarehouseName");
	КонецЕсли;
	Если Значения.Получить("destinationWarehouseName") <> Неопределено Тогда
		destinationWarehouseName = Значения.Получить("destinationWarehouseName");
	КонецЕсли;
	Если Значения.Получить("activeFrom") <> Неопределено Тогда
		activeFrom = Значения.Получить("activeFrom");
	КонецЕсли;
	Если Значения.Получить("boxTariff") <> Неопределено Тогда
		boxTariff = Значения.Получить("boxTariff");
	КонецЕсли;
	Если Значения.Получить("palletTariff") <> Неопределено Тогда
		palletTariff = Значения.Получить("palletTariff");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если transitWarehouseName <> Неопределено Тогда
		Результат.Вставить("transitWarehouseName", ЗначениеДляJSON(transitWarehouseName));
	КонецЕсли;
	Если destinationWarehouseName <> Неопределено Тогда
		Результат.Вставить("destinationWarehouseName", ЗначениеДляJSON(destinationWarehouseName));
	КонецЕсли;
	Если activeFrom <> Неопределено Тогда
		Результат.Вставить("activeFrom", ЗначениеДляJSON(activeFrom));
	КонецЕсли;
	Если boxTariff <> Неопределено Тогда
		Результат.Вставить("boxTariff", ЗначениеДляJSON(boxTariff));
	КонецЕсли;
	Если palletTariff <> Неопределено Тогда
		Результат.Вставить("palletTariff", ЗначениеДляJSON(palletTariff));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

