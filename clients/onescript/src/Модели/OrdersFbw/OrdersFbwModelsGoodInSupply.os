// OrdersFbwModelsGoodInSupply
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// barcode - Строка - Баркод товара
Перем barcode Экспорт;

// vendorCode - Строка - Артикул продавца
Перем vendorCode Экспорт;

// nmID - Число - Артикул WB
Перем nmID Экспорт;

// needKiz - Булево - Нужен ли [код маркировки Честного знака](https://честныйзнак.рф/) для этого товара: - `false` — не нужен - `true` — нужен
Перем needKiz Экспорт;

// tnved - Строка - Код ТНВЭД. Если `\"needKiz\":true`, а `\"tnved\":null`, нужно заполнить характеристику товара \\*\\*ТН ВЭД\\*\\* в [личном кабинете](https://seller.wildberries.…
Перем tnved Экспорт;

// techSize - Строка - Размер товара, указанный продавцом
Перем techSize Экспорт;

// color - Строка - Цвет товара
Перем color Экспорт;

// supplierBoxAmount - Число - Указано в упаковке, шт
Перем supplierBoxAmount Экспорт;

// quantity - Число - Указано в поставке/заказе, шт
Перем quantity Экспорт;

// readyForSaleQuantity - Число - Поступило в продажу, шт
Перем readyForSaleQuantity Экспорт;

// acceptedQuantity - Число - Принято, шт
Перем acceptedQuantity Экспорт;

// unloadingQuantity - Число - Количество товара на раскладке, шт
Перем unloadingQuantity Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("barcode") <> Неопределено Тогда
		barcode = Значения.Получить("barcode");
	КонецЕсли;
	Если Значения.Получить("vendorCode") <> Неопределено Тогда
		vendorCode = Значения.Получить("vendorCode");
	КонецЕсли;
	Если Значения.Получить("nmID") <> Неопределено Тогда
		nmID = Значения.Получить("nmID");
	КонецЕсли;
	Если Значения.Получить("needKiz") <> Неопределено Тогда
		needKiz = Значения.Получить("needKiz");
	КонецЕсли;
	Если Значения.Получить("tnved") <> Неопределено Тогда
		tnved = Значения.Получить("tnved");
	КонецЕсли;
	Если Значения.Получить("techSize") <> Неопределено Тогда
		techSize = Значения.Получить("techSize");
	КонецЕсли;
	Если Значения.Получить("color") <> Неопределено Тогда
		color = Значения.Получить("color");
	КонецЕсли;
	Если Значения.Получить("supplierBoxAmount") <> Неопределено Тогда
		supplierBoxAmount = Значения.Получить("supplierBoxAmount");
	КонецЕсли;
	Если Значения.Получить("quantity") <> Неопределено Тогда
		quantity = Значения.Получить("quantity");
	КонецЕсли;
	Если Значения.Получить("readyForSaleQuantity") <> Неопределено Тогда
		readyForSaleQuantity = Значения.Получить("readyForSaleQuantity");
	КонецЕсли;
	Если Значения.Получить("acceptedQuantity") <> Неопределено Тогда
		acceptedQuantity = Значения.Получить("acceptedQuantity");
	КонецЕсли;
	Если Значения.Получить("unloadingQuantity") <> Неопределено Тогда
		unloadingQuantity = Значения.Получить("unloadingQuantity");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если barcode <> Неопределено Тогда
		Результат.Вставить("barcode", ЗначениеДляJSON(barcode));
	КонецЕсли;
	Если vendorCode <> Неопределено Тогда
		Результат.Вставить("vendorCode", ЗначениеДляJSON(vendorCode));
	КонецЕсли;
	Если nmID <> Неопределено Тогда
		Результат.Вставить("nmID", ЗначениеДляJSON(nmID));
	КонецЕсли;
	Если needKiz <> Неопределено Тогда
		Результат.Вставить("needKiz", ЗначениеДляJSON(needKiz));
	КонецЕсли;
	Если tnved <> Неопределено Тогда
		Результат.Вставить("tnved", ЗначениеДляJSON(tnved));
	КонецЕсли;
	Если techSize <> Неопределено Тогда
		Результат.Вставить("techSize", ЗначениеДляJSON(techSize));
	КонецЕсли;
	Если color <> Неопределено Тогда
		Результат.Вставить("color", ЗначениеДляJSON(color));
	КонецЕсли;
	Если supplierBoxAmount <> Неопределено Тогда
		Результат.Вставить("supplierBoxAmount", ЗначениеДляJSON(supplierBoxAmount));
	КонецЕсли;
	Если quantity <> Неопределено Тогда
		Результат.Вставить("quantity", ЗначениеДляJSON(quantity));
	КонецЕсли;
	Если readyForSaleQuantity <> Неопределено Тогда
		Результат.Вставить("readyForSaleQuantity", ЗначениеДляJSON(readyForSaleQuantity));
	КонецЕсли;
	Если acceptedQuantity <> Неопределено Тогда
		Результат.Вставить("acceptedQuantity", ЗначениеДляJSON(acceptedQuantity));
	КонецЕсли;
	Если unloadingQuantity <> Неопределено Тогда
		Результат.Вставить("unloadingQuantity", ЗначениеДляJSON(unloadingQuantity));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

