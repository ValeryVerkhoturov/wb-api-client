Перем originalPrice Экспорт;

// convertedOriginalPrice - Число - Цена продавца в валюте страны продавца без учёта скидок, умноженная на 100. Предоставляется в информационных целях
Перем convertedOriginalPrice Экспорт;

// originalFinalPrice - Число - Сумма к оплате покупателем в валюте продажи с учетом всех скидок и кэшбека, умноженная на 100. Код валюты продажи указан в поле `currencyCode`. Предоставляется…
Перем originalFinalPrice Экспорт;

// convertedOriginalFinalPrice - Число - Сумма к оплате покупателем в валюте страны продавца с учетом всех скидок и кэшбека, умноженная на 100. Предоставляется в информационных целях
Перем convertedOriginalFinalPrice Экспорт;

// currencyCode - Число - Код валюты продажи
Перем currencyCode Экспорт;

// convertedCurrencyCode - Число - Код валюты страны продавца
Перем convertedCurrencyCode Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("originalPrice") <> Неопределено Тогда
		originalPrice = Значения.Получить("originalPrice");
	КонецЕсли;
	Если Значения.Получить("convertedOriginalPrice") <> Неопределено Тогда
		convertedOriginalPrice = Значения.Получить("convertedOriginalPrice");
	КонецЕсли;
	Если Значения.Получить("originalFinalPrice") <> Неопределено Тогда
		originalFinalPrice = Значения.Получить("originalFinalPrice");
	КонецЕсли;
	Если Значения.Получить("convertedOriginalFinalPrice") <> Неопределено Тогда
		convertedOriginalFinalPrice = Значения.Получить("convertedOriginalFinalPrice");
	КонецЕсли;
	Если Значения.Получить("currencyCode") <> Неопределено Тогда
		currencyCode = Значения.Получить("currencyCode");
	КонецЕсли;
	Если Значения.Получить("convertedCurrencyCode") <> Неопределено Тогда
		convertedCurrencyCode = Значения.Получить("convertedCurrencyCode");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если originalPrice <> Неопределено Тогда
		Результат.Вставить("originalPrice", ЗначениеДляJSON(originalPrice));
	КонецЕсли;
	Если convertedOriginalPrice <> Неопределено Тогда
		Результат.Вставить("convertedOriginalPrice", ЗначениеДляJSON(convertedOriginalPrice));
	КонецЕсли;
	Если originalFinalPrice <> Неопределено Тогда
		Результат.Вставить("originalFinalPrice", ЗначениеДляJSON(originalFinalPrice));
	КонецЕсли;
	Если convertedOriginalFinalPrice <> Неопределено Тогда
		Результат.Вставить("convertedOriginalFinalPrice", ЗначениеДляJSON(convertedOriginalFinalPrice));
	КонецЕсли;
	Если currencyCode <> Неопределено Тогда
		Результат.Вставить("currencyCode", ЗначениеДляJSON(currencyCode));
	КонецЕсли;
	Если convertedCurrencyCode <> Неопределено Тогда
		Результат.Вставить("convertedCurrencyCode", ЗначениеДляJSON(convertedCurrencyCode));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

