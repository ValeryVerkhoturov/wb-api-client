// DbsApiOrderStatusV2
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// errors - Массив - Информация об ошибке
Перем errors Экспорт;

// orderId - Число - ID сборочного задания
Перем orderId Экспорт;

// supplierStatus - Строка - Статус сборочного задания, установленный продавцом
Перем supplierStatus Экспорт;

// wbStatus - Строка - Статус сборочного задания в системе Wildberries
Перем wbStatus Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("errors") <> Неопределено Тогда
		errors = Значения.Получить("errors");
	КонецЕсли;
	Если Значения.Получить("orderId") <> Неопределено Тогда
		orderId = Значения.Получить("orderId");
	КонецЕсли;
	Если Значения.Получить("supplierStatus") <> Неопределено Тогда
		supplierStatus = Значения.Получить("supplierStatus");
	КонецЕсли;
	Если Значения.Получить("wbStatus") <> Неопределено Тогда
		wbStatus = Значения.Получить("wbStatus");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если errors <> Неопределено Тогда
		Результат.Вставить("errors", ЗначениеДляJSON(errors));
	КонецЕсли;
	Если orderId <> Неопределено Тогда
		Результат.Вставить("orderId", ЗначениеДляJSON(orderId));
	КонецЕсли;
	Если supplierStatus <> Неопределено Тогда
		Результат.Вставить("supplierStatus", ЗначениеДляJSON(supplierStatus));
	КонецЕсли;
	Если wbStatus <> Неопределено Тогда
		Результат.Вставить("wbStatus", ЗначениеДляJSON(wbStatus));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

