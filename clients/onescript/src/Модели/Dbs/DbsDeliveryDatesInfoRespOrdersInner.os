// DbsDeliveryDatesInfoRespOrdersInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// dTimeFrom - Строка - Актуальное время доставки \"с\"
Перем dTimeFrom Экспорт;

// dTimeTo - Строка - Актуальное время доставки \"по\"
Перем dTimeTo Экспорт;

// dTimeFromOld - Строка - Прежнее время доставки \"с\". Доступно первые сутки после изменения
Перем dTimeFromOld Экспорт;

// dTimeToOld - Строка - Прежнее время доставки \"по\". Доступно первые сутки после изменения
Перем dTimeToOld Экспорт;

// dDateOld - Строка - Прежняя дата доставки. Доступна первые сутки после изменения
Перем dDateOld Экспорт;

// dDate - Строка - Актуальная дата доставки, указанная покупателем
Перем dDate Экспорт;

// dDateFrom - Строка - Не используется
Перем dDateFrom Экспорт;

// dDateTo - Строка - Не используется
Перем dDateTo Экспорт;

// id - Число - ID сборочного задания
Перем id Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("dTimeFrom") <> Неопределено Тогда
		dTimeFrom = Значения.Получить("dTimeFrom");
	КонецЕсли;
	Если Значения.Получить("dTimeTo") <> Неопределено Тогда
		dTimeTo = Значения.Получить("dTimeTo");
	КонецЕсли;
	Если Значения.Получить("dTimeFromOld") <> Неопределено Тогда
		dTimeFromOld = Значения.Получить("dTimeFromOld");
	КонецЕсли;
	Если Значения.Получить("dTimeToOld") <> Неопределено Тогда
		dTimeToOld = Значения.Получить("dTimeToOld");
	КонецЕсли;
	Если Значения.Получить("dDateOld") <> Неопределено Тогда
		dDateOld = Значения.Получить("dDateOld");
	КонецЕсли;
	Если Значения.Получить("dDate") <> Неопределено Тогда
		dDate = Значения.Получить("dDate");
	КонецЕсли;
	Если Значения.Получить("dDateFrom") <> Неопределено Тогда
		dDateFrom = Значения.Получить("dDateFrom");
	КонецЕсли;
	Если Значения.Получить("dDateTo") <> Неопределено Тогда
		dDateTo = Значения.Получить("dDateTo");
	КонецЕсли;
	Если Значения.Получить("id") <> Неопределено Тогда
		id = Значения.Получить("id");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если dTimeFrom <> Неопределено Тогда
		Результат.Вставить("dTimeFrom", ЗначениеДляJSON(dTimeFrom));
	КонецЕсли;
	Если dTimeTo <> Неопределено Тогда
		Результат.Вставить("dTimeTo", ЗначениеДляJSON(dTimeTo));
	КонецЕсли;
	Если dTimeFromOld <> Неопределено Тогда
		Результат.Вставить("dTimeFromOld", ЗначениеДляJSON(dTimeFromOld));
	КонецЕсли;
	Если dTimeToOld <> Неопределено Тогда
		Результат.Вставить("dTimeToOld", ЗначениеДляJSON(dTimeToOld));
	КонецЕсли;
	Если dDateOld <> Неопределено Тогда
		Результат.Вставить("dDateOld", ЗначениеДляJSON(dDateOld));
	КонецЕсли;
	Если dDate <> Неопределено Тогда
		Результат.Вставить("dDate", ЗначениеДляJSON(dDate));
	КонецЕсли;
	Если dDateFrom <> Неопределено Тогда
		Результат.Вставить("dDateFrom", ЗначениеДляJSON(dDateFrom));
	КонецЕсли;
	Если dDateTo <> Неопределено Тогда
		Результат.Вставить("dDateTo", ЗначениеДляJSON(dDateTo));
	КонецЕсли;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

