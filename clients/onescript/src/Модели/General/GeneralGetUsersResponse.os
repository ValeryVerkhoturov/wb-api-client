// GeneralGetUsersResponse
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// total - Число - Общее количество активных или приглашённых пользователей
Перем total Экспорт;

// countInResponse - Число - Количество активных или приглашённых пользователей на текущей странице
Перем countInResponse Экспорт;

// users - Массив - Информация о пользователях
Перем users Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("total") <> Неопределено Тогда
		total = Значения.Получить("total");
	КонецЕсли;
	Если Значения.Получить("countInResponse") <> Неопределено Тогда
		countInResponse = Значения.Получить("countInResponse");
	КонецЕсли;
	Если Значения.Получить("users") <> Неопределено Тогда
		users = Значения.Получить("users");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если total <> Неопределено Тогда
		Результат.Вставить("total", ЗначениеДляJSON(total));
	КонецЕсли;
	Если countInResponse <> Неопределено Тогда
		Результат.Вставить("countInResponse", ЗначениеДляJSON(countInResponse));
	КонецЕсли;
	Если users <> Неопределено Тогда
		Результат.Вставить("users", ЗначениеДляJSON(users));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

