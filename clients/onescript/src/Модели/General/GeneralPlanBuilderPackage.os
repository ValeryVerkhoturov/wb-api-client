// GeneralPlanBuilderPackage
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// id - Строка - ID пакета
Перем id Экспорт;

// slug - Строка - Код пакета
Перем slug Экспорт;

// name - Строка - Название пакета на языке из параметра `locale`
Перем name Экспорт;

// status - Строка - Статус пакета: - `active` — активен - `pendingActivation` — подключён, начнёт работать с 00:00 следующего дня - `pendingDeactivation` — отключён, перестанет раб…
Перем status Экспорт;

// activatedAt - Дата - Дата активации пакета
Перем activatedAt Экспорт;

// expiresAt - Дата - Дата окончания минимального срока действия пакета. До этого дня пакет опций нельзя отключить
Перем expiresAt Экспорт;

// commissionRate - Число - Комиссия за пакет, % от оборота
Перем commissionRate Экспорт;

// periodDuration - Число - Минимальный срок действия пакета в днях
Перем periodDuration Экспорт;

// options - Массив - Опции, которые входят в пакет
Перем options Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("id") <> Неопределено Тогда
		id = Значения.Получить("id");
	КонецЕсли;
	Если Значения.Получить("slug") <> Неопределено Тогда
		slug = Значения.Получить("slug");
	КонецЕсли;
	Если Значения.Получить("name") <> Неопределено Тогда
		name = Значения.Получить("name");
	КонецЕсли;
	Если Значения.Получить("status") <> Неопределено Тогда
		status = Значения.Получить("status");
	КонецЕсли;
	Если Значения.Получить("activatedAt") <> Неопределено Тогда
		activatedAt = Значения.Получить("activatedAt");
	КонецЕсли;
	Если Значения.Получить("expiresAt") <> Неопределено Тогда
		expiresAt = Значения.Получить("expiresAt");
	КонецЕсли;
	Если Значения.Получить("commissionRate") <> Неопределено Тогда
		commissionRate = Значения.Получить("commissionRate");
	КонецЕсли;
	Если Значения.Получить("periodDuration") <> Неопределено Тогда
		periodDuration = Значения.Получить("periodDuration");
	КонецЕсли;
	Если Значения.Получить("options") <> Неопределено Тогда
		options = Значения.Получить("options");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Если slug <> Неопределено Тогда
		Результат.Вставить("slug", ЗначениеДляJSON(slug));
	КонецЕсли;
	Если name <> Неопределено Тогда
		Результат.Вставить("name", ЗначениеДляJSON(name));
	КонецЕсли;
	Если status <> Неопределено Тогда
		Результат.Вставить("status", ЗначениеДляJSON(status));
	КонецЕсли;
	Если activatedAt <> Неопределено Тогда
		Результат.Вставить("activatedAt", ЗначениеДляJSON(activatedAt));
	КонецЕсли;
	Если expiresAt <> Неопределено Тогда
		Результат.Вставить("expiresAt", ЗначениеДляJSON(expiresAt));
	КонецЕсли;
	Если commissionRate <> Неопределено Тогда
		Результат.Вставить("commissionRate", ЗначениеДляJSON(commissionRate));
	КонецЕсли;
	Если periodDuration <> Неопределено Тогда
		Результат.Вставить("periodDuration", ЗначениеДляJSON(periodDuration));
	КонецЕсли;
	Если options <> Неопределено Тогда
		Результат.Вставить("options", ЗначениеДляJSON(options));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

