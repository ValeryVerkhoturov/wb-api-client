// GeneralCreateInviteResponse
//
// Данные приглашения
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// inviteID - Строка - ID приглашения
Перем inviteID Экспорт;

// expiredAt - Дата - Дата и время окончания срока действия приглашения
Перем expiredAt Экспорт;

// isSuccess - Булево - - `true` — приглашение создано успешно - `false` — повторите запрос
Перем isSuccess Экспорт;

// inviteUrl - Строка - URL приглашения, по которому должен перейти пользователь
Перем inviteUrl Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("inviteID") <> Неопределено Тогда
		inviteID = Значения.Получить("inviteID");
	КонецЕсли;
	Если Значения.Получить("expiredAt") <> Неопределено Тогда
		expiredAt = Значения.Получить("expiredAt");
	КонецЕсли;
	Если Значения.Получить("isSuccess") <> Неопределено Тогда
		isSuccess = Значения.Получить("isSuccess");
	КонецЕсли;
	Если Значения.Получить("inviteUrl") <> Неопределено Тогда
		inviteUrl = Значения.Получить("inviteUrl");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если inviteID <> Неопределено Тогда
		Результат.Вставить("inviteID", ЗначениеДляJSON(inviteID));
	КонецЕсли;
	Если expiredAt <> Неопределено Тогда
		Результат.Вставить("expiredAt", ЗначениеДляJSON(expiredAt));
	КонецЕсли;
	Если isSuccess <> Неопределено Тогда
		Результат.Вставить("isSuccess", ЗначениеДляJSON(isSuccess));
	КонецЕсли;
	Если inviteUrl <> Неопределено Тогда
		Результат.Вставить("inviteUrl", ЗначениеДляJSON(inviteUrl));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

