// GeneralPlanBuilderOptionsInfo
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// activeOptionCount - Число - Количество активных опций, не включённых в пакеты
Перем activeOptionCount Экспорт;

// activePackageCount - Число - Количество активных пакетов опций
Перем activePackageCount Экспорт;

// totalCommissionRate - Число - Итоговая комиссия за подключённые опции и пакеты, % от оборота
Перем totalCommissionRate Экспорт;

// packages - Массив - Подключённые пакеты опций
Перем packages Экспорт;

// options - Массив - Подключённые опции
Перем options Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("activeOptionCount") <> Неопределено Тогда
		activeOptionCount = Значения.Получить("activeOptionCount");
	КонецЕсли;
	Если Значения.Получить("activePackageCount") <> Неопределено Тогда
		activePackageCount = Значения.Получить("activePackageCount");
	КонецЕсли;
	Если Значения.Получить("totalCommissionRate") <> Неопределено Тогда
		totalCommissionRate = Значения.Получить("totalCommissionRate");
	КонецЕсли;
	Если Значения.Получить("packages") <> Неопределено Тогда
		packages = Значения.Получить("packages");
	КонецЕсли;
	Если Значения.Получить("options") <> Неопределено Тогда
		options = Значения.Получить("options");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если activeOptionCount <> Неопределено Тогда
		Результат.Вставить("activeOptionCount", ЗначениеДляJSON(activeOptionCount));
	КонецЕсли;
	Если activePackageCount <> Неопределено Тогда
		Результат.Вставить("activePackageCount", ЗначениеДляJSON(activePackageCount));
	КонецЕсли;
	Если totalCommissionRate <> Неопределено Тогда
		Результат.Вставить("totalCommissionRate", ЗначениеДляJSON(totalCommissionRate));
	КонецЕсли;
	Если packages <> Неопределено Тогда
		Результат.Вставить("packages", ЗначениеДляJSON(packages));
	КонецЕсли;
	Если options <> Неопределено Тогда
		Результат.Вставить("options", ЗначениеДляJSON(options));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

