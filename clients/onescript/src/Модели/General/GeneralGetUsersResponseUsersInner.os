// GeneralGetUsersResponseUsersInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// id - Число - ID пользователя
Перем id Экспорт;

// role - Строка - Роль пользователя: * `user` — пользователь, который активировал доступ * ` ` (пустая строка) — пользователь, который не активировал доступ
Перем role Экспорт;

// position - Строка - Должность пользователя
Перем position Экспорт;

// phone - Строка - Номер телефона пользователя
Перем phone Экспорт;

// email - Строка - Email пользователя
Перем email Экспорт;

// isOwner - Булево - Является ли пользователь владельцем профиля продавца
Перем isOwner Экспорт;

// firstName - Строка - Имя пользователя
Перем firstName Экспорт;

// secondName - Строка - Фамилия пользователя
Перем secondName Экспорт;

// patronymic - Строка - Отчество пользователя
Перем patronymic Экспорт;

// goodsReturn - Булево - Может ли пользователь одобрять возвраты товаров
Перем goodsReturn Экспорт;

// isInvitee - Булево - Приглашён ли пользователь
Перем isInvitee Экспорт;

// inviteeInfo - getUsersResponse_users_inner_inviteeInfo
Перем inviteeInfo Экспорт;

// access - Массив - Настройки доступа к разделам профиля продавца
Перем access Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("id") <> Неопределено Тогда
		id = Значения.Получить("id");
	КонецЕсли;
	Если Значения.Получить("role") <> Неопределено Тогда
		role = Значения.Получить("role");
	КонецЕсли;
	Если Значения.Получить("position") <> Неопределено Тогда
		position = Значения.Получить("position");
	КонецЕсли;
	Если Значения.Получить("phone") <> Неопределено Тогда
		phone = Значения.Получить("phone");
	КонецЕсли;
	Если Значения.Получить("email") <> Неопределено Тогда
		email = Значения.Получить("email");
	КонецЕсли;
	Если Значения.Получить("isOwner") <> Неопределено Тогда
		isOwner = Значения.Получить("isOwner");
	КонецЕсли;
	Если Значения.Получить("firstName") <> Неопределено Тогда
		firstName = Значения.Получить("firstName");
	КонецЕсли;
	Если Значения.Получить("secondName") <> Неопределено Тогда
		secondName = Значения.Получить("secondName");
	КонецЕсли;
	Если Значения.Получить("patronymic") <> Неопределено Тогда
		patronymic = Значения.Получить("patronymic");
	КонецЕсли;
	Если Значения.Получить("goodsReturn") <> Неопределено Тогда
		goodsReturn = Значения.Получить("goodsReturn");
	КонецЕсли;
	Если Значения.Получить("isInvitee") <> Неопределено Тогда
		isInvitee = Значения.Получить("isInvitee");
	КонецЕсли;
	Если Значения.Получить("inviteeInfo") <> Неопределено Тогда
		inviteeInfo = Значения.Получить("inviteeInfo");
	КонецЕсли;
	Если Значения.Получить("access") <> Неопределено Тогда
		access = Значения.Получить("access");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если id <> Неопределено Тогда
		Результат.Вставить("id", ЗначениеДляJSON(id));
	КонецЕсли;
	Если role <> Неопределено Тогда
		Результат.Вставить("role", ЗначениеДляJSON(role));
	КонецЕсли;
	Если position <> Неопределено Тогда
		Результат.Вставить("position", ЗначениеДляJSON(position));
	КонецЕсли;
	Если phone <> Неопределено Тогда
		Результат.Вставить("phone", ЗначениеДляJSON(phone));
	КонецЕсли;
	Если email <> Неопределено Тогда
		Результат.Вставить("email", ЗначениеДляJSON(email));
	КонецЕсли;
	Если isOwner <> Неопределено Тогда
		Результат.Вставить("isOwner", ЗначениеДляJSON(isOwner));
	КонецЕсли;
	Если firstName <> Неопределено Тогда
		Результат.Вставить("firstName", ЗначениеДляJSON(firstName));
	КонецЕсли;
	Если secondName <> Неопределено Тогда
		Результат.Вставить("secondName", ЗначениеДляJSON(secondName));
	КонецЕсли;
	Если patronymic <> Неопределено Тогда
		Результат.Вставить("patronymic", ЗначениеДляJSON(patronymic));
	КонецЕсли;
	Если goodsReturn <> Неопределено Тогда
		Результат.Вставить("goodsReturn", ЗначениеДляJSON(goodsReturn));
	КонецЕсли;
	Если isInvitee <> Неопределено Тогда
		Результат.Вставить("isInvitee", ЗначениеДляJSON(isInvitee));
	КонецЕсли;
	Если inviteeInfo <> Неопределено Тогда
		Результат.Вставить("inviteeInfo", ЗначениеДляJSON(inviteeInfo));
	КонецЕсли;
	Если access <> Неопределено Тогда
		Результат.Вставить("access", ЗначениеДляJSON(access));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

