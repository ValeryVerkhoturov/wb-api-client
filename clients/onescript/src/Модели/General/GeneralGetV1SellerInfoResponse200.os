// GeneralGetV1SellerInfoResponse200
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// name - Строка - Наименование продавца
Перем name Экспорт;

// sid - Строка - Уникальный ID продавца на Wildberries, [находящийся в публичном поле токена](./api-information#tag/authorization/Kak-ustroen-token)
Перем sid Экспорт;

// tin - Строка - ИНН
Перем tin Экспорт;

// tradeMark - Строка - Торговое наименование продавца
Перем tradeMark Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("name") <> Неопределено Тогда
		name = Значения.Получить("name");
	КонецЕсли;
	Если Значения.Получить("sid") <> Неопределено Тогда
		sid = Значения.Получить("sid");
	КонецЕсли;
	Если Значения.Получить("tin") <> Неопределено Тогда
		tin = Значения.Получить("tin");
	КонецЕсли;
	Если Значения.Получить("tradeMark") <> Неопределено Тогда
		tradeMark = Значения.Получить("tradeMark");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если name <> Неопределено Тогда
		Результат.Вставить("name", ЗначениеДляJSON(name));
	КонецЕсли;
	Если sid <> Неопределено Тогда
		Результат.Вставить("sid", ЗначениеДляJSON(sid));
	КонецЕсли;
	Если tin <> Неопределено Тогда
		Результат.Вставить("tin", ЗначениеДляJSON(tin));
	КонецЕсли;
	Если tradeMark <> Неопределено Тогда
		Результат.Вставить("tradeMark", ЗначениеДляJSON(tradeMark));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

