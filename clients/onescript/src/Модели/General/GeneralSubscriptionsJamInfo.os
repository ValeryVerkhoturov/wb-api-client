// GeneralSubscriptionsJamInfo
//
// Информация о подписке Джем
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// state - Строка - Статус подписки: - `active` — активна - `inactive` — истекла или отменена
Перем state Экспорт;

// activationSource - Строка - Источник подключения подписки: - `constructor` — покупка через раздел **Конструктор тарифов** - `jam` — покупка через раздел **Подписка «Джем»**
Перем activationSource Экспорт;

// level - Строка - Уровень подписки: - `standard` - `advanced` - `premium`
Перем level Экспорт;

// since - Дата - Дата и время первой активации подписки. Не меняется при продлении или повторной активации
Перем since Экспорт;

// till - Дата - Дата и время окончания подписки
Перем till Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("state") <> Неопределено Тогда
		state = Значения.Получить("state");
	КонецЕсли;
	Если Значения.Получить("activationSource") <> Неопределено Тогда
		activationSource = Значения.Получить("activationSource");
	КонецЕсли;
	Если Значения.Получить("level") <> Неопределено Тогда
		level = Значения.Получить("level");
	КонецЕсли;
	Если Значения.Получить("since") <> Неопределено Тогда
		since = Значения.Получить("since");
	КонецЕсли;
	Если Значения.Получить("till") <> Неопределено Тогда
		till = Значения.Получить("till");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если state <> Неопределено Тогда
		Результат.Вставить("state", ЗначениеДляJSON(state));
	КонецЕсли;
	Если activationSource <> Неопределено Тогда
		Результат.Вставить("activationSource", ЗначениеДляJSON(activationSource));
	КонецЕсли;
	Если level <> Неопределено Тогда
		Результат.Вставить("level", ЗначениеДляJSON(level));
	КонецЕсли;
	Если since <> Неопределено Тогда
		Результат.Вставить("since", ЗначениеДляJSON(since));
	КонецЕсли;
	Если till <> Неопределено Тогда
		Результат.Вставить("till", ЗначениеДляJSON(till));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

