// GeneralGetUsersResponseUsersInnerInviteeInfo
//
// Информация о приглашении, если пользователь приглашён
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.

// phoneNumber - Строка - Номер телефона приглашённого пользователя
Перем phoneNumber Экспорт;

// position - Строка - Должность приглашённого пользователя
Перем position Экспорт;

// inviteUuid - Строка - ID приглашения
Перем inviteUuid Экспорт;

// expiredAt - Дата - Дата и время окончания срока действия приглашения
Перем expiredAt Экспорт;

// isActive - Булево - - `true` — приглашение активно - `false` — приглашение неактивно
Перем isActive Экспорт;

// Параметры:
//   Данные - Соответствие, Структура - исходные значения, разобранные из JSON.
//
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)

	Если Данные <> Неопределено Тогда
		Заполнить(Данные);
	КонецЕсли;

КонецПроцедуры

// Заполняет свойства из коллекции, полученной из JSON.
//
// Параметры:
//   Данные - Соответствие, Структура - исходные значения.
//
Процедура Заполнить(Знач Данные) Экспорт

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Каждого ЭлементДанных Из Данные Цикл
		Значения.Вставить(Строка(ЭлементДанных.Ключ), ЭлементДанных.Значение);
	КонецЦикла;
	Если Значения.Получить("phoneNumber") <> Неопределено Тогда
		phoneNumber = Значения.Получить("phoneNumber");
	КонецЕсли;
	Если Значения.Получить("position") <> Неопределено Тогда
		position = Значения.Получить("position");
	КонецЕсли;
	Если Значения.Получить("inviteUuid") <> Неопределено Тогда
		inviteUuid = Значения.Получить("inviteUuid");
	КонецЕсли;
	Если Значения.Получить("expiredAt") <> Неопределено Тогда
		expiredAt = Значения.Получить("expiredAt");
	КонецЕсли;
	Если Значения.Получить("isActive") <> Неопределено Тогда
		isActive = Значения.Получить("isActive");
	КонецЕсли;
КонецПроцедуры

// Возвращает значения свойств под именами из спецификации.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Соответствие
//
Функция Данные() Экспорт

	Результат = Новый Соответствие;
	Если phoneNumber <> Неопределено Тогда
		Результат.Вставить("phoneNumber", ЗначениеДляJSON(phoneNumber));
	КонецЕсли;
	Если position <> Неопределено Тогда
		Результат.Вставить("position", ЗначениеДляJSON(position));
	КонецЕсли;
	Если inviteUuid <> Неопределено Тогда
		Результат.Вставить("inviteUuid", ЗначениеДляJSON(inviteUuid));
	КонецЕсли;
	Если expiredAt <> Неопределено Тогда
		Результат.Вставить("expiredAt", ЗначениеДляJSON(expiredAt));
	КонецЕсли;
	Если isActive <> Неопределено Тогда
		Результат.Вставить("isActive", ЗначениеДляJSON(isActive));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Вложенные модели раскладываются тем же способом.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

